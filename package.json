{
  "name": "campus-marketplace",
  "version": "1.0.0",
  "description": "Campus Marketplace - Node.js + EJS",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "lint": "node scripts/lint-js.js",
    "test": "node scripts/test-smoke.js",
    "test:hardening": "node scripts/test-hardening-controls.js",
    "test:security:lite": "node scripts/test-security-integration-lite.js",
    "test:security:rate:endpoints": "node scripts/test-security-rate-limit-endpoints.js",
    "test:security:ownership": "node scripts/test-security-ownership-lite.js",
    "test:concurrency:controls": "node scripts/test-concurrency-controls.js",
    "test:concurrency:runtime": "node scripts/test-concurrency-runtime.js",
    "test:concurrency:verify": "node scripts/verify-concurrency-invariants.js",
    "bench:p95": "node scripts/benchmark-p95.js",
    "bench:p95:budget": "node scripts/evaluate-p95-budgets.js",
    "bench:p95:matrix": "node scripts/render-perf-matrix.js",
    "bench:p95:local": "node scripts/run-local-perf-benchmark.js",
    "evidence:runtime": "node scripts/collect-runtime-evidence.js",
    "test:gates": "npm run lint && npm run test && npm run test:hardening && npm run test:security:lite && npm run test:security:ownership && npm run test:concurrency:controls && npm run security-check",
    "security-check": "node scripts/security-check.js",
    "migrate:indexes": "node scripts/migrate-indexes.js",
    "build:css": "tailwindcss -i ./public/css/tailwind-input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./public/css/tailwind-input.css -o ./public/css/tailwind.css --watch"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.67.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "tailwindcss": "^3.4.19"
  }
}

