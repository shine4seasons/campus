PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/campus

# Auth
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRE=7d
AUTH_COOKIE_MAX_AGE_MS=604800000
AUTH_COOKIE_SAMESITE=lax
FORCE_SECURE_COOKIES=false
AUTH_REFRESH_ROTATE_WINDOW_SECONDS=86400
AUTH_SESSION_MAX_AGE_SECONDS=2592000

# OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# AI provider
AI_PROVIDER=groq
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SePay
SEPAY_API_KEY=replace_with_sepay_api_key
SEPAY_API_URL=https://my.sepay.vn/userapi/transactions/list
SEPAY_WEBHOOK_SECRET=replace_with_webhook_secret
SEPAY_BANK_CODE=BIDV
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=SMART CAMPUS MARKETPLACE
SEPAY_QR_BANK=BIDV
SEPAY_QR_ACC=

# Socket CORS allowlist (comma-separated)
SOCKET_ALLOWED_ORIGINS=http://localhost:5000

# Benchmark / PERF-201 (optional)
BENCH_BASE_URL=http://localhost:5000
BENCH_ENDPOINTS=/api/products,/api/chat,/api/orders,/api/admin/reports
BENCH_METHOD=GET
BENCH_REQUESTS=40
BENCH_CONCURRENCY=8
BENCH_TIMEOUT_MS=5000
BENCH_WARMUP_REQUESTS=3
BENCH_HEADERS_JSON=
BENCH_AUTH_BEARER=
BENCH_COOKIE=
BENCH_BUYER_COOKIE=
BENCH_ADMIN_COOKIE=
BENCH_ENDPOINT_MATRIX_FILE=
BENCH_ENDPOINT_MATRIX_OUTPUT=docs/perf-endpoint-matrix.local.json
BENCH_BASELINE_ARTIFACT=
