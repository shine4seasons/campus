<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: title, pageStyles: ['favorites-page'] }) %>
</head>
<body class="favorites-page">
  <%- include('partials/navbar') %>
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="content">
      <header class="page-heading">
        <div class="page-heading-copy">
          <h1 class="page-heading-title">
            My Favorites
            <span class="fav-count-badge fav-count-badge-hidden" id="fav-count">0</span>
          </h1>
          <p class="page-heading-sub">Products you've saved for later</p>
        </div>
      </header>

      <div class="fav-page">
        <label class="fav-search" for="fav-search-input">
          <i data-lucide="search"></i>
          <input id="fav-search-input" type="search" placeholder="Search favorites by product, category, seller..." autocomplete="off">
        </label>
        <div class="fav-grid" id="fav-grid">
          <div class="fav-loading">
            <svg class="spinner" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
          </div>
        </div>

        <div class="fav-load-more fav-load-more-hidden" id="fav-load-more">
          <button data-action="load-more-favorites">Load more</button>
        </div>
      </div>
    </div>
  </main>

    <script defer src="/js/pages/favorites.js"></script>
</body>
</html>

