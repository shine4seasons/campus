<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: title, pageStyles: ['dashboard-admin-page', 'admin-disputes-page'] }) %>
</head>
<body class="dashboard-page dashboard-admin admin-disputes-view">
  <%- include('partials/navbar') %>
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="dsp-page">
      <header class="dsp-header">
        <h1 class="dsp-title">&#9888; Disputes</h1>
        <div class="dsp-tabs" id="dsp-tabs">
          <button class="dsp-tab active" data-status="open">Open</button>
          <button class="dsp-tab" data-status="resolved">Resolved</button>
          <button class="dsp-tab" data-status="all">All</button>
        </div>
      </header>

      <div class="dsp-list" id="dsp-list">
        <div class="dsp-loading">
          <svg class="spinner" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
        </div>
      </div>
    </div>
  </main>

  <!-- Resolve modal -->
  <div class="resolve-backdrop" id="resolve-backdrop">
    <div class="resolve-modal">
      <h3>Resolve dispute</h3>
      <input type="hidden" id="resolve-order-id">

      <label for="resolve-decision">Decision</label>
      <select id="resolve-decision">
        <option value="buyer-favor">Rule in favor of buyer</option>
        <option value="seller-favor">Rule in favor of seller</option>
        <option value="mutual">Mutual / amicable resolution</option>
        <option value="rejected">Reject &mdash; invalid claim</option>
      </select>

      <div class="resolve-checkbox">
        <input type="checkbox" id="resolve-refund">
        <label for="resolve-refund" class="resolve-refund-label">Refund buyer & cancel order (only with buyer-favor)</label>
      </div>

      <label for="resolve-note">Note to both parties</label>
      <textarea id="resolve-note" maxlength="1000" placeholder="Explain your decision..."></textarea>

      <div class="resolve-actions">
        <button class="cancel" data-action="close-resolve-modal">Cancel</button>
        <button class="submit" id="resolve-submit-btn" data-action="submit-resolve">Submit decision</button>
      </div>
    </div>
  </div>

    <script defer src="/js/pages/admin-disputes.js"></script>
</body>
</html>

