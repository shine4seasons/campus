<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= editProduct ? 'Edit Product' : 'Post a Product' %> — Campus Marketplace
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=DM+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/shared.css">
  <link rel="stylesheet" href="/css/main.css">
  <link href="https://unpkg.com/maplibre-gl/dist/maplibre-gl.css" rel="stylesheet" />
  <script src="https://unpkg.com/maplibre-gl/dist/maplibre-gl.js"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    .sell-container {
      max-width: 1100px;
      margin: 0 auto;
      padding-bottom: 80px;
    }

    .sell-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 32px;
      margin-top: 24px;
      align-items: start;
    }

    @media (max-width: 1024px) {
      .sell-layout {
        grid-template-columns: 1fr;
      }
    }

    .sell-card {
      background: var(--bg1);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 24px;
      transition: all 0.3s ease;
      position: relative;
    }

    .sell-card.active {
      border-color: var(--primary-light);
      box-shadow: 0 8px 24px rgba(27, 94, 255, 0.04);
    }

    .sell-step-num {
      position: absolute;
      left: -14px;
      top: 28px;
      width: 28px;
      height: 28px;
      background: var(--primary);
      color: #fff;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 14px;
      box-shadow: 0 4px 10px rgba(27, 94, 255, 0.3);
    }

    .sell-card-title {
      font-size: 18px;
      font-weight: 800;
      color: var(--t1);
      margin-bottom: 4px;
      letter-spacing: -0.02em;
    }

    .sell-card-sub {
      font-size: 13px;
      color: var(--t3);
      margin-bottom: 20px;
      font-weight: 500;
    }

    .preview-sidebar {
      position: sticky;
      top: 100px;
    }

    .preview-card {
      background: var(--bg1);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }

    .preview-card-image {
      width: 100%;
      aspect-ratio: 1/1;
      background: var(--bg2);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .preview-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .preview-card-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(4px);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 800;
      color: var(--t1);
      text-transform: uppercase;
    }

    .preview-card-content {
      padding: 18px;
    }

    .preview-card-meta {
      font-size: 11px;
      font-weight: 700;
      color: var(--t3);
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .preview-card-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--t1);
      margin-bottom: 8px;
      line-height: 1.4;
    }

    .preview-card-price {
      font-size: 20px;
      font-weight: 900;
      color: var(--primary);
    }

    .sell-progress-wrap {
      margin-bottom: 32px;
      padding: 2px;
      background: var(--bg2);
      border-radius: 999px;
      height: 10px;
      overflow: hidden;
    }

    .sell-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--primary-light));
      width: 25%;
      transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sf {
      margin-bottom: 18px;
    }

    .sf-label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: var(--t2);
      margin-bottom: 8px;
    }

    .sf-input,
    .sf-select,
    .sf-textarea {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      font-size: 14px;
      font-family: inherit;
      transition: all 0.2s;
      background: var(--bg1);
    }

    .sf-input:focus,
    .sf-select:focus,
    .sf-textarea:focus {
      border-color: var(--primary);
      outline: none;
      box-shadow: 0 0 0 4px var(--primary-light);
    }

    .category-combobox {
      position: relative;
    }

    .category-trigger {
      width: 100%;
      min-height: 54px;
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--bg1);
      color: var(--t1);
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .category-trigger:hover {
      border-color: var(--primary);
      background: #F7F9FF;
    }

    .category-combobox.open .category-trigger {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--primary-light);
    }

    .category-icon {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: var(--bg2);
      color: var(--primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
    }

    .category-icon i,
    .category-icon svg {
      width: 17px;
      height: 17px;
    }

    .category-trigger-text {
      min-width: 0;
      flex: 1;
      text-align: left;
    }

    .category-trigger-label {
      display: block;
      font-size: 14px;
      font-weight: 800;
      color: var(--t1);
      line-height: 1.25;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .category-trigger-hint {
      display: block;
      margin-top: 1px;
      font-size: 11px;
      font-weight: 700;
      color: var(--t3);
    }

    @media (max-width: 520px) {
      .category-trigger {
        gap: 8px;
        padding: 8px 10px;
      }

      .category-icon {
        width: 30px;
        height: 30px;
      }

      .category-trigger-hint {
        display: none;
      }
    }

    .category-chevron {
      width: 18px;
      height: 18px;
      color: var(--t3);
      transition: transform 0.2s;
      flex: 0 0 auto;
    }

    .category-combobox.open .category-chevron {
      transform: rotate(180deg);
    }

    .category-panel {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      z-index: 120;
      display: none;
      padding: 8px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 18px 45px rgba(13, 15, 26, 0.14);
    }

    .category-combobox.open .category-panel {
      display: block;
    }

    .category-search {
      position: relative;
      margin-bottom: 8px;
    }

    .category-search i,
    .category-search svg {
      position: absolute;
      left: 12px;
      top: 50%;
      width: 16px;
      height: 16px;
      color: var(--t3);
      transform: translateY(-50%);
      pointer-events: none;
    }

    .category-search input {
      width: 100%;
      height: 40px;
      padding: 0 12px 0 38px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font: inherit;
      font-size: 13px;
      outline: none;
      background: var(--bg2);
    }

    .category-search input:focus {
      border-color: var(--primary);
      background: #fff;
    }

    .category-options {
      display: grid;
      gap: 6px;
      max-height: 260px;
      overflow-y: auto;
      padding-right: 2px;
    }

    .category-option {
      width: 100%;
      min-height: 48px;
      padding: 8px 10px;
      border: 1px solid transparent;
      border-radius: 10px;
      background: transparent;
      color: var(--t1);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: inherit;
      text-align: left;
      transition: background 0.15s, border-color 0.15s;
    }

    .category-option:hover,
    .category-option.active {
      background: #F7F9FF;
      border-color: #DCE5FF;
    }

    .category-option.selected {
      background: var(--primary-light);
      border-color: var(--primary);
    }

    .category-option .category-icon {
      width: 30px;
      height: 30px;
    }

    .category-option-name {
      display: block;
      font-size: 13px;
      font-weight: 800;
      color: var(--t1);
    }

    .category-option-slug {
      display: block;
      margin-top: 1px;
      font-size: 11px;
      font-weight: 700;
      color: var(--t3);
      text-transform: capitalize;
    }

    .category-empty {
      display: none;
      padding: 14px 10px;
      color: var(--t3);
      font-size: 13px;
      font-weight: 700;
      text-align: center;
    }

    .ai-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px;
      margin: 0 0 10px;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--bg2);
    }

    .ai-option {
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
    }

    .ai-option label,
    .ai-length-head {
      font-size: 11px;
      font-weight: 800;
      color: var(--t3);
      text-transform: uppercase;
    }

    .ai-option select {
      width: 100%;
      min-height: 38px;
      padding: 8px 10px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      color: var(--t1);
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      outline: none;
    }

    .ai-option select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .ai-length-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .ai-length-value {
      color: var(--primary);
      white-space: nowrap;
    }

    .ai-length-range {
      width: 100%;
      accent-color: var(--primary);
    }

    .btn-submit {
      width: 100%;
      padding: 16px;
      border-radius: 14px;
      background: var(--primary);
      color: #fff;
      font-size: 16px;
      font-weight: 800;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .btn-submit:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(27, 94, 255, 0.3);
    }

    .cond-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .cond-opt {
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      text-align: left;
      cursor: pointer;
      transition: all 0.2s;
      position: relative;
    }

    .cond-opt.selected {
      background: var(--primary-light);
      border-color: var(--primary);
    }

    .cond-icon {
      color: var(--t3);
      margin-bottom: 8px;
    }

    .cond-opt.selected .cond-icon {
      color: var(--primary);
    }

    .cond-label {
      font-size: 14px;
      font-weight: 800;
      color: var(--t1);
    }

    .cond-sub {
      font-size: 12px;
      color: var(--t3);
      margin-top: 2px;
    }

    .dropdown-item {
      padding: 12px 16px;
      cursor: pointer;
      border-bottom: 1px solid #F0F1F8;
      transition: background-color 0.2s;
    }

    .dropdown-item:hover {
      background-color: #F7F8FC;
    }

    .dropdown-item:last-child {
      border-bottom: none;
    }

    .dropdown-name {
      font-weight: 600;
      color: #0D0F1A;
      font-size: 14px;
    }

    .dropdown-address {
      color: #8890B0;
      font-size: 12px;
      margin-top: 2px;
    }
  </style>
  <script>
    function initLocationPicker() {
      const defaultLat = parseFloat(document.getElementById('f-lat').value) || 21.0285;
      const defaultLng = parseFloat(document.getElementById('f-lng').value) || 105.8542;
      const hasExisting = !!document.getElementById('f-lat').value;
      const map = new maplibregl.Map({
        container: 'location-map',
        style: { version: 8, sources: { 'osm': { type: 'raster', tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'], tileSize: 256, attribution: '© OpenStreetMap contributors' } }, layers: [{ id: 'osm', type: 'raster', source: 'osm' }] },
        center: [defaultLng, defaultLat],
        zoom: 13
      });
      window.mapInstance = map;
      let marker;
      if (hasExisting) { marker = new maplibregl.Marker().setLngLat([defaultLng, defaultLat]).addTo(map); window.currentMarker = marker; }
      map.on('click', function (e) {
        const { lng, lat } = e.lngLat;
        if (window.currentMarker) window.currentMarker.remove();
        marker = new maplibregl.Marker().setLngLat([lng, lat]).addTo(map);
        window.currentMarker = marker;
        updateLocation(lat, lng);
      });
      initAutocomplete(map, marker);
    }
    async function updateLocation(lat, lng) {
      document.getElementById('f-lat').value = lat;
      document.getElementById('f-lng').value = lng;
      try { const address = await reverseGeocode(lat, lng); document.getElementById('f-location').value = address; } catch (err) { console.error('Geocoding failed:', err); }
    }
    async function reverseGeocode(lat, lng) { const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`); const data = await res.json(); return data.display_name; }
    async function searchLocation(query) { const res = await fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&limit=5`); const data = await res.json(); return data.features || []; }
    function initAutocomplete(map, marker) {
      const input = document.getElementById('location-search');
      const dropdown = document.getElementById('location-dropdown');
      let timeout;
      input.addEventListener('input', function () {
        clearTimeout(timeout);
        const query = this.value.trim();
        if (query.length < 2) { dropdown.style.display = 'none'; return; }
        timeout = setTimeout(async () => { try { const results = await searchLocation(query); showDropdown(results, map, marker); } catch (err) { console.error('Search failed:', err); } }, 300);
      });
      document.addEventListener('click', function (e) { if (!input.contains(e.target) && !dropdown.contains(e.target)) dropdown.style.display = 'none'; });
    }
    function showDropdown(results, map, marker) {
      const dropdown = document.getElementById('location-dropdown');
      if (!results.length) { dropdown.style.display = 'none'; return; }
      dropdown.innerHTML = results.map(r => `
        <div class="dropdown-item" onclick="selectLocation(${r.geometry.coordinates[1]}, ${r.geometry.coordinates[0]}, '${r.properties.name || r.properties.city || r.properties.country}')">
          <div class="dropdown-name">${r.properties.name || 'Unknown'}</div>
          <div class="dropdown-address">${r.properties.city || ''} ${r.properties.country || ''}</div>
        </div>`).join('');
      dropdown.style.display = 'block';
    }
    window.selectLocation = function (lat, lng, name) {
      const map = window.mapInstance;
      if (window.currentMarker) window.currentMarker.remove();
      window.currentMarker = new maplibregl.Marker().setLngLat([lng, lat]).addTo(map);
      map.setCenter([lng, lat]);
      map.setZoom(16);
      updateLocation(lat, lng);
      document.getElementById('location-dropdown').style.display = 'none';
      document.getElementById('location-search').value = name;
    };
    window.geolocateMe = function () {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition(async (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        if (window.currentMarker) window.currentMarker.remove();
        window.currentMarker = new maplibregl.Marker().setLngLat([lng, lat]).addTo(window.mapInstance);
        window.mapInstance.setCenter([lng, lat]);
        window.mapInstance.setZoom(16);
        await updateLocation(lat, lng);
      });
    };
    document.addEventListener('DOMContentLoaded', initLocationPicker);
  </script>
</head>

<body>
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="content">
          <% const ep=editProduct; %>
          <% const selectedCategory = CATEGORIES.find(cat => ep && ep.category === cat.slug); %>

            <div class="sell-container">
          <div style="margin-bottom: 32px">
            <h1
              style="font-size: 32px; font-weight: 900; color: var(--t1); letter-spacing: -0.03em; margin-bottom: 8px">
              <%= ep ? 'Edit product' : 'Post a product' %>
            </h1>
            <p style="color: var(--t3); font-size: 15px; font-weight: 500;">Fill in the details to reach more buyers on
              campus</p>
          </div>

          <!-- Progress bar -->
          <div class="sell-progress-wrap">
            <div class="sell-progress-fill" id="sell-progress-fill"></div>
          </div>

          <div class="sell-layout">
            <!-- LEFT: Form -->
            <div class="sell-steps">
              <form id="sell-form">
                <!-- Step 0: Images -->
                <div class="sell-card active" id="step-0">
                  <div class="sell-step-num">01</div>
                  <div class="sell-card-title">Add photos</div>
                  <div class="sell-card-sub">Upload clear photos of your item (max 5 images)</div>

                  <div class="sf">
                    <div style="border: 2px dashed var(--border); border-radius: 12px; padding: 32px; text-align: center; cursor: pointer; transition: all 0.2s;" id="upload-drop-zone">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin: 0 auto 16px; opacity: 0.5;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      <div style="font-weight: 600; color: var(--t1); margin-bottom: 4px;">Click to upload or drag photos here</div>
                      <div style="font-size: 13px; color: var(--t3);">JPG, PNG • Max 5MB per image</div>
                      <input type="file" id="image-input" multiple accept="image/*" style="display: none;">
                    </div>
                    <div id="image-preview" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px; margin-top: 20px;">
                    </div>
                    <input type="hidden" id="f-images" value="">
                  </div>
                </div>

                <!-- Step 1 -->
                <div class="sell-card" id="step-1">
                  <div class="sell-step-num">02</div>
                  <div class="sell-card-title">Item condition</div>
                  <div class="sell-card-sub">Select the best description for your item</div>

                  <div class="cond-grid">
                    <% ['new', 'like-new' , 'good' , 'fair' ].forEach(cond=> {
                      const labels = { new: 'New', 'like-new': 'Like New', good: 'Good', fair: 'Fair' };
                      const subs = { new: 'Never used', 'like-new': 'Used once', good: 'Works well', fair: 'Has wear' };
                      %>
                      <div class="cond-opt <%= ep && ep.condition === cond ? 'selected' : '' %>" data-val="<%= cond %>"
                        onclick="selectCond(this)">
                        <div class="cond-label">
                          <%= labels[cond] %>
                        </div>
                        <div class="cond-sub">
                          <%= subs[cond] %>
                        </div>
                      </div>
                      <% }) %>
                  </div>
                  <input type="hidden" id="f-condition" value="<%= ep ? ep.condition : '' %>">
                </div>

                <!-- Step 2 -->
                <div class="sell-card" id="step-2">
                  <div class="sell-step-num">03</div>
                  <div class="sell-card-title">Item details</div>
                  <div class="sell-card-sub">Name, describe and price your item</div>

                  <div class="sf">
                    <label class="sf-label">Product Title *</label>
                    <input class="sf-input" id="f-title" type="text" value="<%= ep ? ep.title : '' %>"
                      placeholder="e.g. Calculus 1 Textbook" maxlength="120" oninput="updatePreview()">
                  </div>

                  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
                    <div class="sf">
                      <label class="sf-label">Category *</label>
                      <div class="category-combobox" id="category-combobox">
                        <button type="button" class="category-trigger" id="category-trigger" aria-haspopup="listbox" aria-expanded="false">
                          <span class="category-icon">
                            <i data-lucide="<%= selectedCategory ? selectedCategory.lucideIcon : 'layout-grid' %>"></i>
                          </span>
                          <span class="category-trigger-text">
                            <span class="category-trigger-label" id="category-label"><%= selectedCategory ? selectedCategory.name.replace(/&amp;/g, '&') : 'Select category' %></span>
                            <span class="category-trigger-hint">Choose the closest match</span>
                          </span>
                          <i class="category-chevron" data-lucide="chevron-down"></i>
                        </button>
                        <div class="category-panel" id="category-panel">
                          <div class="category-search">
                            <i data-lucide="search"></i>
                            <input id="category-search" type="text" placeholder="Search categories..." autocomplete="off">
                          </div>
                          <div class="category-options" id="category-options" role="listbox">
                            <% CATEGORIES.forEach(cat=> { const catDisplayName = cat.name.replace(/&amp;/g, '&'); %>
                              <button
                                type="button"
                                class="category-option <%= ep && ep.category === cat.slug ? 'selected' : '' %>"
                                data-slug="<%= cat.slug %>"
                                data-name="<%= catDisplayName %>"
                                data-icon="<%= cat.lucideIcon %>"
                                role="option"
                                aria-selected="<%= ep && ep.category === cat.slug ? 'true' : 'false' %>">
                                <span class="category-icon"><i data-lucide="<%= cat.lucideIcon %>"></i></span>
                                <span>
                                  <span class="category-option-name"><%= catDisplayName %></span>
                                  <span class="category-option-slug"><%= cat.slug.replace('-', ' ') %></span>
                                </span>
                              </button>
                            <% }) %>
                          </div>
                          <div class="category-empty" id="category-empty">No matching category</div>
                        </div>
                        <input type="hidden" id="f-cat" value="<%= selectedCategory ? selectedCategory.slug : '' %>">
                      </div>
                      <select class="sf-select" id="f-cat-native" aria-hidden="true" tabindex="-1" style="display:none">
                        <option value=""></option>
                        <% CATEGORIES.forEach(cat=> { const catDisplayName = cat.name.replace(/&amp;/g, '&'); %>
                          <option value="<%= cat.slug %>" <%=ep && ep.category===cat.slug ? 'selected' : '' %>><%=
                              catDisplayName %>
                          </option>
                          <% }) %>
                      </select>
                    </div>
                    <div class="sf">
                      <label class="sf-label">Price (VND) *</label>
                      <input class="sf-input" id="f-price" type="number" value="<%= ep ? ep.price : '' %>"
                        placeholder="0" oninput="updatePreview()">
                    </div>
                    <div class="sf">
                      <label class="sf-label">Quantity *</label>
                      <input class="sf-input" id="f-quantity" type="number" min="1" step="1"
                        value="<%= ep ? (ep.quantity || 1) : 1 %>" placeholder="1" oninput="updatePreview()">
                    </div>
                  </div>

                  <div class="sf">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                      <label class="sf-label" style="margin-bottom: 0;">Description *</label>
                      <button type="button" class="btn-ai-describe" id="btn-ai-describe" onclick="generateAIDescription()" style="padding: 6px 12px; font-size: 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 6px; transition: all 0.2s;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                        <span>AI Generate</span>
                      </button>
                    </div>
                    <div class="ai-options">
                      <div class="ai-option">
                        <label for="ai-tone">Tone</label>
                        <select id="ai-tone">
                          <option value="friendly" selected>Friendly</option>
                          <option value="concise">Concise</option>
                          <option value="detailed">Detailed</option>
                          <option value="urgent">Sell fast</option>
                        </select>
                      </div>
                      <div class="ai-option">
                        <label for="ai-language">Language</label>
                        <select id="ai-language">
                          <option value="english" selected>English</option>
                          <option value="vietnamese">Vietnamese</option>
                        </select>
                      </div>
                      <div class="ai-option">
                        <div class="ai-length-head">
                          <label for="ai-length">Length</label>
                          <span class="ai-length-value"><span id="ai-length-value">100</span> words</span>
                        </div>
                        <input class="ai-length-range" id="ai-length" type="range" min="60" max="140" step="10" value="100">
                      </div>
                    </div>
                    <textarea class="sf-textarea" id="f-desc" rows="5"
                      placeholder="Tell buyers more about your item..."><%= ep ? ep.description : '' %></textarea>
                    <div id="ai-status" style="display: none; margin-top: 8px; padding: 8px 12px; background: #e3f2fd; border-left: 3px solid #2196f3; border-radius: 4px; font-size: 12px; color: #1976d2;"></div>
                  </div>
                </div>

                <!-- Step 3 -->
                <div class="sell-card" id="step-3">
                  <div class="sell-step-num">04</div>
                  <div class="sell-card-title">Location</div>
                  <div class="sell-card-sub">Where can the buyer meet you?</div>

                  <div class="sf">
                    <div style="position:relative">
                      <input class="sf-input" id="location-search" type="text" placeholder="Search campus location...">
                      <div id="location-dropdown"
                        style="position:absolute; top:100%; left:0; width:100%; background:#fff; border:1px solid var(--border); border-radius:12px; z-index:100; display:none; max-height:200px; overflow-y:auto;">
                      </div>
                    </div>
                    <div id="location-map"
                      style="height:300px; border-radius:12px; border:1px solid var(--border); margin-top:16px;"></div>
                    <input type="hidden" id="f-lat" value="<%= ep ? (ep.location?.lat || '') : '' %>">
                    <input type="hidden" id="f-lng" value="<%= ep ? (ep.location?.lng || '') : '' %>">
                    <input type="hidden" id="f-location" value="<%= ep ? (ep.locationName || '') : '' %>">
                  </div>
                </div>

                <button type="button" class="btn-submit" onclick="handleSubmit()">
                  <i data-lucide="check-circle" style="width:20px;height:20px;"></i>
                  <%= ep ? 'Save Changes' : 'Post Product Now' %>
                </button>
              </form>
            </div>

            <!-- RIGHT: Preview -->
            <aside class="preview-sidebar">
              <div class="sell-card-title"
                style="margin-bottom:16px; font-size:14px; color:var(--t3); text-transform:uppercase;">Live Preview
              </div>
              <div class="preview-card">
                <div class="preview-card-image" id="p-image-wrap">
                  <div class="preview-card-badge" id="p-cond">Condition</div>
                  <i data-lucide="image" style="width:48px;height:48px;color:var(--t3);opacity:0.3;"></i>
                </div>
                <div class="preview-card-content">
                  <div class="preview-card-meta" id="p-cat">Category</div>
                  <div class="preview-card-title" id="p-title">Product Title</div>
                  <div class="preview-card-price" id="p-price">₫0</div>
                  <div style="font-size:12px;font-weight:700;color:var(--t3);margin-top:6px;" id="p-quantity">Stock: 1</div>
                </div>
              </div>

              <div
                style="margin-top:24px; padding:20px; background:var(--bg2); border-radius:16px; border:1px solid var(--border);">
                <div style="font-size:13px; font-weight:800; color:var(--t1); margin-bottom:8px;">Pro Tip</div>
                <p style="font-size:12px; color:var(--t3); line-height:1.6;">Items with clear photos and detailed
                  descriptions sell 3x faster. Be honest about the condition!</p>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </main>

        <script>
          let uploadedImages = [];

          // ──── Image Upload Handlers ────────────────────────────────────
          const dropZone = document.getElementById('upload-drop-zone');
          const imageInput = document.getElementById('image-input');
          const imagePreview = document.getElementById('image-preview');
          const notify = (message, type = 'err') => {
            if (typeof showToast === 'function') showToast(message, type);
          };

          function initCategoryDropdown() {
            const combo = document.getElementById('category-combobox');
            const trigger = document.getElementById('category-trigger');
            const search = document.getElementById('category-search');
            const hidden = document.getElementById('f-cat');
            const nativeSelect = document.getElementById('f-cat-native');
            const label = document.getElementById('category-label');
            const triggerIcon = trigger?.querySelector('.category-icon i');
            const empty = document.getElementById('category-empty');
            const options = Array.from(document.querySelectorAll('.category-option'));
            let activeIndex = Math.max(0, options.findIndex(opt => opt.classList.contains('selected')));

            if (!combo || !trigger || !search || !hidden || !label || !options.length) return;

            const open = () => {
              combo.classList.add('open');
              trigger.setAttribute('aria-expanded', 'true');
              search.value = '';
              filterOptions('');
              setActiveOption(activeIndex);
              setTimeout(() => search.focus(), 0);
            };

            const close = () => {
              combo.classList.remove('open');
              trigger.setAttribute('aria-expanded', 'false');
            };

            const toggle = () => combo.classList.contains('open') ? close() : open();

            function setActiveOption(index) {
              const visibleOptions = options.filter(opt => opt.style.display !== 'none');
              if (!visibleOptions.length) return;
              activeIndex = Math.max(0, Math.min(index, visibleOptions.length - 1));
              options.forEach(opt => opt.classList.remove('active'));
              visibleOptions[activeIndex].classList.add('active');
              visibleOptions[activeIndex].scrollIntoView({ block: 'nearest' });
            }

            function filterOptions(query) {
              const normalized = query.trim().toLowerCase();
              let visibleCount = 0;

              options.forEach((option) => {
                const text = `${option.dataset.name} ${option.dataset.slug}`.toLowerCase();
                const matches = !normalized || text.includes(normalized);
                option.style.display = matches ? 'flex' : 'none';
                if (matches) visibleCount += 1;
              });

              empty.style.display = visibleCount ? 'none' : 'block';
              activeIndex = 0;
              setActiveOption(0);
            }

            function selectOption(option) {
              if (!option) return;
              hidden.value = option.dataset.slug;
              if (nativeSelect) nativeSelect.value = option.dataset.slug;
              label.textContent = option.dataset.name;
              if (triggerIcon) triggerIcon.setAttribute('data-lucide', option.dataset.icon);

              options.forEach(opt => {
                const selected = opt === option;
                opt.classList.toggle('selected', selected);
                opt.setAttribute('aria-selected', selected ? 'true' : 'false');
              });

              close();
              updatePreview();
              if (typeof lucide !== 'undefined') lucide.createIcons();
            }

            trigger.addEventListener('click', toggle);
            options.forEach(option => option.addEventListener('click', () => selectOption(option)));
            search.addEventListener('input', () => filterOptions(search.value));

            combo.addEventListener('keydown', (event) => {
              const visibleOptions = options.filter(opt => opt.style.display !== 'none');
              if (event.key === 'Escape') {
                close();
                trigger.focus();
              } else if (event.key === 'ArrowDown') {
                event.preventDefault();
                if (!combo.classList.contains('open')) open();
                setActiveOption(activeIndex + 1);
              } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                setActiveOption(activeIndex - 1);
              } else if (event.key === 'Enter' && combo.classList.contains('open')) {
                event.preventDefault();
                selectOption(visibleOptions[activeIndex]);
              }
            });

            document.addEventListener('click', (event) => {
              if (!combo.contains(event.target)) close();
            });
          }

          function initAIControls() {
            const lengthInput = document.getElementById('ai-length');
            const lengthValue = document.getElementById('ai-length-value');
            if (!lengthInput || !lengthValue) return;

            const syncLength = () => {
              lengthValue.textContent = lengthInput.value;
            };

            lengthInput.addEventListener('input', syncLength);
            syncLength();
          }

          function setupImageUpload() {
            dropZone.addEventListener('click', () => imageInput.click());
            dropZone.addEventListener('dragover', (e) => {
              e.preventDefault();
              dropZone.style.borderColor = 'var(--primary)';
              dropZone.style.background = 'var(--primary-light)';
            });
            dropZone.addEventListener('dragleave', () => {
              dropZone.style.borderColor = 'var(--border)';
              dropZone.style.background = 'transparent';
            });
            dropZone.addEventListener('drop', (e) => {
              e.preventDefault();
              dropZone.style.borderColor = 'var(--border)';
              dropZone.style.background = 'transparent';
              handleImageFiles(e.dataTransfer.files);
            });
            imageInput.addEventListener('change', (e) => handleImageFiles(e.target.files));
          }

          function handleImageFiles(files) {
            if (uploadedImages.length >= 5) {
              notify('Maximum 5 images allowed');
              return;
            }
            
            const filesToAdd = Array.from(files).slice(0, 5 - uploadedImages.length);
            let uploadCount = 0;

            filesToAdd.forEach((file) => {
              if (!file.type.startsWith('image/')) {
                notify('Only image files are allowed');
                return;
              }
              if (file.size > 5 * 1024 * 1024) {
                notify('Image must be smaller than 5MB');
                return;
              }

              const formData = new FormData();
              formData.append('image', file);

              fetch('/api/upload/image', {
                method: 'POST',
                body: formData
              })
              .then(res => res.json())
              .then(data => {
                if (data.success) {
                  uploadedImages.push(data.url);
                  renderImagePreview();
                  updatePreview();
                  document.getElementById('f-images').value = JSON.stringify(uploadedImages);
                } else {
                  notify('Upload failed: ' + (data.message || 'Unknown error'));
                }
              })
              .catch(err => {
                console.error('Upload error:', err);
                notify('Network error during upload');
              });
            });
          }

          function renderImagePreview() {
            imagePreview.innerHTML = uploadedImages.map((url, idx) => `
              <div style="position:relative; border-radius:8px; overflow:hidden; background:var(--bg2);">
                <img src="${url}" style="width:100%; height:100px; object-fit:cover;" alt="image ${idx+1}">
                <button type="button" style="position:absolute; top:2px; right:2px; width:24px; height:24px; background:#ff4444; color:#fff; border:none; border-radius:50%; cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center;" onclick="removeImage(${idx})">×</button>
              </div>
            `).join('');
          }

          function removeImage(idx) {
            uploadedImages.splice(idx, 1);
            renderImagePreview();
            updatePreview();
            document.getElementById('f-images').value = JSON.stringify(uploadedImages);
          }

          function updatePreview() {
            const title = document.getElementById('f-title').value || 'Product Title';
            const selectedCategoryValue = document.getElementById('f-cat').value;
            const cat = selectedCategoryValue ? document.getElementById('category-label').textContent : 'Category';
            const price = document.getElementById('f-price').value || '0';
            const quantity = document.getElementById('f-quantity').value || '1';
            const cond = document.getElementById('f-condition').value || 'Condition';
            
            // Update preview image
            const imageWrap = document.getElementById('p-image-wrap');
            if (uploadedImages.length > 0) {
              imageWrap.innerHTML = `<div class="preview-card-badge" id="p-cond">${cond}</div><img src="${uploadedImages[0]}" style="width:100%; height:100%; object-fit:cover;" alt="preview">`;
            } else {
              imageWrap.innerHTML = `<div class="preview-card-badge" id="p-cond">${cond}</div><i data-lucide="image" style="width:48px;height:48px;color:var(--t3);opacity:0.3;"></i>`;
            }

            document.getElementById('p-title').textContent = title;
            document.getElementById('p-cat').textContent = cat;
            document.getElementById('p-price').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price);
            document.getElementById('p-quantity').textContent = 'Stock: ' + quantity;

            // Update progress
            let filled = 0;
            if (uploadedImages.length > 0) filled += 20;
            if (title !== 'Product Title') filled += 20;
            if (document.getElementById('f-desc').value) filled += 20;
            if (cond !== 'Condition') filled += 20;
            if (document.getElementById('f-lat').value) filled += 20;
            document.getElementById('sell-progress-fill').style.width = filled + '%';

            lucide.createIcons();
          }

          window.selectCond = function (el) {
            document.querySelectorAll('.cond-opt').forEach(opt => opt.classList.remove('selected'));
            el.classList.add('selected');
            document.getElementById('f-condition').value = el.dataset.val;
            updatePreview();
          };

          async function generateAIDescription() {
            const btn = document.getElementById('btn-ai-describe');
            const statusDiv = document.getElementById('ai-status');
            const textarea = document.getElementById('f-desc');
            const title = document.getElementById('f-title').value.trim();
            const category = document.getElementById('f-cat').value;
            const condition = document.getElementById('f-condition').value;
            const price = document.getElementById('f-price').value;
            const location = document.getElementById('f-location').value;
            const tone = document.getElementById('ai-tone').value;
            const language = document.getElementById('ai-language').value;
            const targetWords = Number(document.getElementById('ai-length').value);
            const imageUrl = uploadedImages.find(url => !url.startsWith('temp-')) || '';

            if (!title) {
              notify('Please enter a title first');
              return;
            }
            if (!category) {
              notify('Please select a category first');
              return;
            }
            if (!condition) {
              notify('Please select the item condition first');
              return;
            }
            if (textarea.value.trim()) {
              if (typeof showConfirm !== 'function') {
                notify('Clear the current description before generating a new one');
                return;
              }

              const replace = await showConfirm({
                title: 'Replace Description',
                message: 'AI will replace the current description. Continue?',
                confirmText: 'Replace',
                type: 'danger'
              });
              if (!replace) return;
            }

            btn.disabled = true;
            btn.style.opacity = '0.6';
            statusDiv.style.display = 'block';
            statusDiv.textContent = '⏳ Generating description with AI...';

            try {
              const res = await fetch('/api/ai/describe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, category, condition, price, location, imageUrl, tone, language, targetWords })
              });

              const data = await res.json();
              if (data.success && data.description) {
                textarea.value = data.description;
                statusDiv.style.background = '#e8f5e9';
                statusDiv.style.borderLeftColor = '#4caf50';
                statusDiv.style.color = '#2e7d32';
                statusDiv.textContent = '✓ Description generated successfully!';
                setTimeout(() => { statusDiv.style.display = 'none'; }, 3000);
                updatePreview();
              } else {
                statusDiv.style.background = '#ffebee';
                statusDiv.style.borderLeftColor = '#f44336';
                statusDiv.style.color = '#c62828';
                statusDiv.textContent = '✗ Failed: ' + (data.message || 'Try again');
              }
            } catch (e) {
              statusDiv.style.background = '#ffebee';
              statusDiv.style.borderLeftColor = '#f44336';
              statusDiv.style.color = '#c62828';
              statusDiv.textContent = '✗ Error: ' + e.message;
            } finally {
              btn.disabled = false;
              btn.style.opacity = '1';
            }
          }

          async function handleSubmit() {
            const btn = document.querySelector('.btn-submit');
            btn.disabled = true;
            btn.textContent = 'Publishing...';

            const payload = {
              title: document.getElementById('f-title').value,
              category: document.getElementById('f-cat').value,
              price: document.getElementById('f-price').value,
              quantity: document.getElementById('f-quantity').value,
              description: document.getElementById('f-desc').value,
              condition: document.getElementById('f-condition').value,
              images: uploadedImages,
              location: {
                lat: document.getElementById('f-lat').value,
                lng: document.getElementById('f-lng').value
              },
              locationName: document.getElementById('f-location').value
            };

            try {
              const url = '<%= ep ? "/api/products/" + ep._id : "/api/products" %>';
              const res = await fetch(url, {
                method: '<%= ep ? "PATCH" : "POST" %>',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              const data = await res.json();
              if (data.success) {
                location.href = '/my-products';
              } else {
                notify(data.message || 'Failed to save');
                btn.disabled = false;
                btn.textContent = '<%= ep ? "Save Changes" : "Post Product Now" %>';
              }
            } catch (e) {
              notify('Network error');
              btn.disabled = false;
              btn.textContent = '<%= ep ? "Save Changes" : "Post Product Now" %>';
            }
          }

          document.addEventListener('DOMContentLoaded', () => {
            // Load existing images if editing
            <% if (ep && ep.images && ep.images.length > 0) { %>
              uploadedImages = <%- JSON.stringify(ep.images) %>;
              renderImagePreview();
            <% } %>
            
            setupImageUpload();
            initCategoryDropdown();
            initAIControls();
            lucide.createIcons();
            updatePreview();
          });
        </script>
</body>

</html>
