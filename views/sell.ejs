<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: (editProduct ? 'Edit Product' : 'Post a Product') + ' - Campus Marketplace', pageStyles: ['sell-page', 'seller-center'] }) %>
  <link href="/vendor/maplibre-gl-4.7.1/maplibre-gl.css" rel="stylesheet" />
  <script defer src="/vendor/maplibre-gl-4.7.1/maplibre-gl.js"></script>
</head>

<body class="dashboard-page seller-workspace seller-post-view">
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="content">
          <% const ep=editProduct; %>
          <% const selectedCategory = CATEGORIES.find(cat => ep && ep.category === cat.slug); %>

            <div class="sell-container">
          <div class="sell-page-heading">
            <div>
              <h1 class="sell-page-title">
                <%= ep ? 'Edit product' : 'Post a product' %>
              </h1>
              <p class="sell-page-subtitle">Fill in the details to reach more buyers on
                campus</p>
            </div>
            <div class="draft-indicator" id="sell-draft-indicator">Draft saved</div>
          </div>

          <div class="sell-flow-nav" id="sell-flow-nav" aria-label="Listing progress">
            <button type="button" class="sell-flow-step active" data-step-target="step-0">
              <span class="sell-flow-index">1</span>
              <span class="sell-flow-copy">
                <span class="sell-flow-title">Add photos</span>
                <span class="sell-flow-sub">Show the item clearly</span>
              </span>
            </button>
            <button type="button" class="sell-flow-step" data-step-target="step-1">
              <span class="sell-flow-index">2</span>
              <span class="sell-flow-copy">
                <span class="sell-flow-title">Condition</span>
                <span class="sell-flow-sub">Set buyer expectations</span>
              </span>
            </button>
            <button type="button" class="sell-flow-step" data-step-target="step-2">
              <span class="sell-flow-index">3</span>
              <span class="sell-flow-copy">
                <span class="sell-flow-title">Details</span>
                <span class="sell-flow-sub">Title, price and description</span>
              </span>
            </button>
            <button type="button" class="sell-flow-step" data-step-target="step-3">
              <span class="sell-flow-index">4</span>
              <span class="sell-flow-copy">
                <span class="sell-flow-title">Location</span>
                <span class="sell-flow-sub">Confirm a meetup point</span>
              </span>
            </button>
          </div>

          <div class="sell-progress-wrap" aria-hidden="true">
            <div class="sell-progress-fill" id="sell-progress-fill"></div>
          </div>

          <div class="sell-layout">
            <!-- LEFT: Form -->
            <div class="sell-steps">
              <form id="sell-form">
                <!-- Step 0: Images -->
                <div class="sell-card active" id="step-0" data-step-card="0">
                  <div class="sell-step-num">01</div>
                  <div class="sell-card-title">Add photos</div>
                  <div class="sell-card-sub">Upload clear photos of your item (max 5 images)</div>

                  <div class="sf">
                    <div class="sell-upload-zone" id="upload-drop-zone">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="sell-upload-icon">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      <div class="sell-upload-title">Click to upload or drag photos here</div>
                      <div class="sell-upload-note">JPG, PNG &bull; Max 5MB per image</div>
                      <input type="file" id="image-input" multiple accept="image/*" class="sell-hidden-input">
                    </div>
                    <div class="sell-upload-meta">
                      <div class="sell-upload-chip" id="image-count-indicator">0 / 5 images added</div>
                      <div class="sell-upload-chip sell-upload-chip-muted" id="upload-status">Ready to upload</div>
                    </div>
                    <div id="image-preview" class="sell-image-preview-grid">
                    </div>
                    <p class="field-help">Use a cover photo with strong lighting, then add close-ups of important details.</p>
                    <input type="hidden" id="f-images" value="">
                  </div>
                </div>

                <!-- Step 1 -->
                <div class="sell-card" id="step-1" data-step-card="1">
                  <div class="sell-step-num">02</div>
                  <div class="sell-card-title">Item condition</div>
                  <div class="sell-card-sub">Select the best description for your item</div>

                  <div class="cond-grid">
                    <% ['new', 'like-new' , 'good' , 'fair' ].forEach(cond=> {
                      const labels = { new: 'New', 'like-new': 'Like New', good: 'Good', fair: 'Fair' };
                      const subs = { new: 'Never used', 'like-new': 'Used once', good: 'Works well', fair: 'Has wear' };
                      %>
                      <div class="cond-opt <%= ep && ep.condition === cond ? 'selected' : '' %>" data-val="<%= cond %>">
                        <div class="cond-label">
                          <%= labels[cond] %>
                        </div>
                        <div class="cond-sub">
                          <%= subs[cond] %>
                        </div>
                      </div>
                      <% }) %>
                  </div>
                  <input type="hidden" id="f-condition" value="<%= ep ? ep.condition : '' %>">
                </div>

                <!-- Step 2 -->
                <div class="sell-card" id="step-2" data-step-card="2">
                  <div class="sell-step-num">03</div>
                  <div class="sell-card-title">Item details</div>
                  <div class="sell-card-sub">Name, describe and price your item</div>

                  <div class="sf">
                    <label class="sf-label">Product Title *</label>
                    <input class="sf-input" id="f-title" type="text" value="<%= ep ? ep.title : '' %>"
                      placeholder="e.g. Calculus 1 Textbook" maxlength="120">
                    <p class="field-help">Keep it specific so buyers can recognize the item at a glance.</p>
                    <div class="ai-option ai-title-language">
                      <label class="sf-label">Title language</label>
                      <div class="ai-select" data-ai-select="title-language">
                        <button type="button" class="ai-select-trigger" id="ai-title-language-trigger" aria-haspopup="listbox" aria-expanded="false">
                          <span class="ai-select-label" id="ai-title-language-label">English</span>
                          <i data-lucide="chevron-down" class="ai-select-chevron"></i>
                        </button>
                        <div class="ai-select-panel" id="ai-title-language-panel" role="listbox" aria-label="Title language">
                          <button type="button" class="ai-select-option selected" data-value="english" data-label="English" role="option" aria-selected="true">English</button>
                          <button type="button" class="ai-select-option" data-value="vietnamese" data-label="Vietnamese" role="option" aria-selected="false">Vietnamese</button>
                        </div>
                        <input type="hidden" id="ai-title-language" value="english">
                      </div>
                    </div>
                    <div class="sell-ai-actions sell-ai-actions-title">
                      <button type="button" class="btn-ai-title sell-ai-btn" id="btn-ai-title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                        <span>AI Title</span>
                      </button>
                    </div>
                    <p class="field-help">Choose the title language here before generating.</p>
                  </div>

                  <div class="sell-detail-grid">
                    <div class="sf">
                      <label class="sf-label">Category *</label>
                      <div class="category-combobox" id="category-combobox">
                        <button type="button" class="category-trigger" id="category-trigger" aria-haspopup="listbox" aria-expanded="false">
                          <span class="category-icon">
                            <i data-lucide="<%= selectedCategory ? selectedCategory.lucideIcon : 'layout-grid' %>"></i>
                          </span>
                          <span class="category-trigger-text">
                            <span class="category-trigger-label" id="category-label"><%= selectedCategory ? selectedCategory.name.replace(/&amp;/g, '&') : 'Select category' %></span>
                            <span class="category-trigger-hint">Choose the closest match</span>
                          </span>
                          <i class="category-chevron" data-lucide="chevron-down"></i>
                        </button>
                        <div class="category-panel" id="category-panel">
                          <div class="category-search">
                            <i data-lucide="search"></i>
                            <input id="category-search" type="text" placeholder="Search categories..." autocomplete="off">
                          </div>
                          <div class="category-options" id="category-options" role="listbox">
                            <% CATEGORIES.forEach(cat=> { const catDisplayName = cat.name.replace(/&amp;/g, '&'); %>
                              <button
                                type="button"
                                class="category-option <%= ep && ep.category === cat.slug ? 'selected' : '' %>"
                                data-slug="<%= cat.slug %>"
                                data-name="<%= catDisplayName %>"
                                data-icon="<%= cat.lucideIcon %>"
                                role="option"
                                aria-selected="<%= ep && ep.category === cat.slug ? 'true' : 'false' %>">
                                <span class="category-icon"><i data-lucide="<%= cat.lucideIcon %>"></i></span>
                                <span>
                                  <span class="category-option-name"><%= catDisplayName %></span>
                                  <span class="category-option-slug"><%= cat.slug.replace('-', ' ') %></span>
                                </span>
                              </button>
                            <% }) %>
                          </div>
                          <div class="category-empty" id="category-empty">No matching category</div>
                        </div>
                        <input type="hidden" id="f-cat" value="<%= selectedCategory ? selectedCategory.slug : '' %>">
                      </div>
                      <select class="sf-select sell-cat-native-hidden" id="f-cat-native" aria-hidden="true" tabindex="-1">
                        <option value=""></option>
                        <% CATEGORIES.forEach(cat=> { const catDisplayName = cat.name.replace(/&amp;/g, '&'); %>
                          <option value="<%= cat.slug %>" <%=ep && ep.category===cat.slug ? 'selected' : '' %>><%=
                              catDisplayName %>
                          </option>
                          <% }) %>
                      </select>
                    </div>
                    <div class="sf">
                      <label class="sf-label">Price (VND) *</label>
                      <div class="sell-price-input">
                        <span class="sell-price-currency">VND</span>
                        <input class="sf-input" id="f-price" type="number" value="<%= ep ? ep.price : '' %>"
                        placeholder="0">
                      </div>
                      <p class="field-help">Set a fair campus price buyers can act on quickly.</p>
                    </div>
                    <div class="sf">
                      <label class="sf-label">Quantity *</label>
                      <input class="sf-input" id="f-quantity" type="number" min="1" step="1"
                        value="<%= ep ? (ep.quantity || 1) : 1 %>" placeholder="1">
                    </div>
                  </div>

                  <div class="sf">
                    <div class="sell-desc-head">
                      <label class="sf-label sell-desc-label">Description *</label>
                    </div>
                    <div class="ai-options">
                      <div class="ai-option">
                        <label for="ai-brand">Brand / Model</label>
                        <input id="ai-brand" class="sf-input" type="text" placeholder="e.g. Logitech MX Master 3">
                      </div>
                      <div class="ai-option">
                        <label class="sf-label">AI image source</label>
                        <div class="ai-select" data-ai-select="image">
                          <button type="button" class="ai-select-trigger" id="ai-image-trigger" aria-haspopup="listbox" aria-expanded="false">
                            <span class="ai-select-label" id="ai-image-label">Auto select best image</span>
                            <i data-lucide="chevron-down" class="ai-select-chevron"></i>
                          </button>
                          <div class="ai-select-panel" id="ai-image-panel" role="listbox" aria-label="AI image source"></div>
                          <input type="hidden" id="ai-image" value="">
                        </div>
                      </div>
                      <div class="ai-option">
                        <label for="ai-color">Color</label>
                        <input id="ai-color" class="sf-input" type="text" placeholder="e.g. black, silver, navy">
                      </div>
                      <div class="ai-option">
                        <label for="ai-accessories">Accessories included</label>
                        <input id="ai-accessories" class="sf-input" type="text" placeholder="e.g. charger, case, box">
                      </div>
                      <div class="ai-option">
                        <label for="ai-defects">Known defects</label>
                        <input id="ai-defects" class="sf-input" type="text" placeholder="e.g. small scratch on corner">
                      </div>
                      <div class="ai-option">
                        <label for="ai-reason">Reason for selling</label>
                        <input id="ai-reason" class="sf-input" type="text" placeholder="e.g. upgraded, no longer needed">
                      </div>
                      <div class="ai-option">
                        <label for="ai-extras">Extra details</label>
                        <input id="ai-extras" class="sf-input" type="text" placeholder="Anything else AI should know">
                      </div>
                      <div class="ai-option">
                        <label class="sf-label">Tone</label>
                        <div class="ai-select" data-ai-select="tone">
                          <button type="button" class="ai-select-trigger" id="ai-tone-trigger" aria-haspopup="listbox" aria-expanded="false">
                            <span class="ai-select-label" id="ai-tone-label">Friendly</span>
                            <i data-lucide="chevron-down" class="ai-select-chevron"></i>
                          </button>
                          <div class="ai-select-panel" id="ai-tone-panel" role="listbox" aria-label="Tone">
                            <button type="button" class="ai-select-option selected" data-value="friendly" data-label="Friendly" role="option" aria-selected="true">Friendly</button>
                            <button type="button" class="ai-select-option" data-value="concise" data-label="Concise" role="option" aria-selected="false">Concise</button>
                            <button type="button" class="ai-select-option" data-value="detailed" data-label="Detailed" role="option" aria-selected="false">Detailed</button>
                            <button type="button" class="ai-select-option" data-value="urgent" data-label="Sell fast" role="option" aria-selected="false">Sell fast</button>
                          </div>
                          <input type="hidden" id="ai-tone" value="friendly">
                        </div>
                      </div>
                      <div class="ai-option">
                        <label class="sf-label">Language</label>
                        <div class="ai-select" data-ai-select="language">
                          <button type="button" class="ai-select-trigger" id="ai-language-trigger" aria-haspopup="listbox" aria-expanded="false">
                            <span class="ai-select-label" id="ai-language-label">English</span>
                            <i data-lucide="chevron-down" class="ai-select-chevron"></i>
                          </button>
                          <div class="ai-select-panel" id="ai-language-panel" role="listbox" aria-label="Language">
                            <button type="button" class="ai-select-option selected" data-value="english" data-label="English" role="option" aria-selected="true">English</button>
                            <button type="button" class="ai-select-option" data-value="vietnamese" data-label="Vietnamese" role="option" aria-selected="false">Vietnamese</button>
                          </div>
                          <input type="hidden" id="ai-language" value="english">
                        </div>
                      </div>
                      <div class="ai-option">
                        <div class="ai-length-head">
                          <label for="ai-length">Length</label>
                          <span class="ai-length-value"><span id="ai-length-value">100</span> words</span>
                        </div>
                        <input class="ai-length-range" id="ai-length" type="range" min="60" max="140" step="10" value="100">
                      </div>
                    </div>
                    <textarea class="sf-textarea" id="f-desc" rows="5"
                      placeholder="Tell buyers more about your item..."><%= ep ? ep.description : '' %></textarea>
                    <p class="field-help">Include usage history, defects, included accessories, and why the buyer should trust this listing.</p>
                    <div class="sell-ai-actions">
                      <button type="button" class="btn-ai-describe sell-ai-btn" id="btn-ai-describe">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                        <span>AI Generate</span>
                      </button>
                    </div>
                    <div id="ai-status" class="sell-ai-status"></div>
                  </div>
                </div>

                <!-- Step 3 -->
                <div class="sell-card" id="step-3" data-step-card="3">
                  <div class="sell-step-num">04</div>
                  <div class="sell-card-title">Location</div>
                  <div class="sell-card-sub">Where can the buyer meet you?</div>

                  <div class="sf">
                    <div class="sell-location-wrap">
                      <input class="sf-input" id="location-search" type="text" placeholder="Search a campus building, landmark, or meeting point...">
                      <div id="location-dropdown" class="sell-location-dropdown">
                      </div>
                    </div>
                    <div class="sell-location-summary" id="sell-location-summary">No meetup point selected yet.</div>
                    <div id="location-map" class="sell-location-map"></div>
                    <p class="field-help">Pick a clear, familiar campus location to reduce coordination friction with buyers.</p>
                    <input type="hidden" id="f-lat" value="<%= ep ? (ep.location?.lat || '') : '' %>">
                    <input type="hidden" id="f-lng" value="<%= ep ? (ep.location?.lng || '') : '' %>">
                    <input type="hidden" id="f-location" value="<%= ep ? (ep.locationName || '') : '' %>">
                  </div>
                </div>

                <div class="sell-submit-bar">
                  <div class="sell-submit-copy">
                    <div class="sell-submit-title">Review and publish</div>
                    <div class="sell-submit-sub">Your listing can be updated later, but accurate details improve trust now.</div>
                  </div>
                  <button type="button" class="btn-submit" id="btn-submit-sell">
                    <i data-lucide="check-circle" class="sell-submit-icon"></i>
                    <%= ep ? 'Save Changes' : 'Post Product Now' %>
                  </button>
                </div>
              </form>
            </div>

            <!-- RIGHT: Preview -->
            <aside class="preview-sidebar">
              <div class="sell-preview-header">
                <div class="sell-card-title sell-preview-heading">Live Preview</div>
                <div class="sell-preview-caption">This is how buyers will scan your card in the marketplace feed.</div>
              </div>
              <div class="preview-card">
                <div class="preview-card-image" id="p-image-wrap">
                  <div class="preview-card-badge" id="p-cond">Condition</div>
                  <i data-lucide="image" class="sell-preview-empty-icon"></i>
                </div>
                <div class="preview-card-content">
                  <div class="preview-card-meta" id="p-cat">Category</div>
                  <div class="preview-card-title" id="p-title">Product Title</div>
                  <div class="preview-card-price" id="p-price">&#8363;0</div>
                  <div class="sell-preview-meta-row">
                    <div class="sell-preview-quantity" id="p-quantity">Stock: 1</div>
                    <div class="sell-preview-location" id="p-location">Campus meetup</div>
                  </div>
                </div>
              </div>

              <div class="sell-tip-box">
                <div class="sell-tip-title">Pro Tip</div>
                <p class="sell-tip-copy">Items with clear photos and detailed
                  descriptions sell 3x faster. Be honest about the condition!</p>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </main>

        <%
          function safeJson(value) {
            return JSON.stringify(value)
              .replace(/</g, '\\u003c')
              .replace(/>/g, '\\u003e')
              .replace(/&/g, '\\u0026')
              .replace(/\u2028/g, '\\u2028')
              .replace(/\u2029/g, '\\u2029');
          }
        %>
        <script id="sell-page-config" type="application/json"><%- safeJson({
            submitUrl: ep ? "/api/products/" + ep._id : "/api/products",
            submitMethod: ep ? "PATCH" : "POST",
            submitLabel: ep ? "Save Changes" : "Post Product Now",
            existingImages: ep && ep.images ? ep.images : []
          }) %></script>
        <script defer src="/js/pages/sell.js"></script>
</body>

</html>

