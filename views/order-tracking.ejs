<!DOCTYPE html>
<html lang="en" class="dashboard-shell">
<head>
  <%- include('partials/head', { pageTitle: 'Order Tracking - Campus Marketplace', pageStyles: ['dashboard', 'rating', 'order-tracking-page'] }) %>
  <link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />
</head>

<body class="dashboard-page">
  <%- include('partials/navbar') %>
  <%- include('partials/sidebar') %>

  <%
    const meId = String(user._id);
    const isBuyer = order.buyer && String(order.buyer._id) === meId;
    const isSeller = order.seller && String(order.seller._id) === meId;
    const canManageStatus = isSeller || (user && user.role === 'admin');
    const canDispute = (isBuyer || isSeller) &&
      (order.status === 'confirmed' || order.status === 'completed') &&
      (!order.dispute || order.dispute.status === 'resolved' || order.dispute.status === 'rejected');
    const hasActiveDispute = order.dispute && (order.dispute.status === 'open' || order.dispute.status === 'in_review');
    const canResumePayment = isBuyer && order.paymentMode === 'qr' && order.status === 'pending_payment' && payment && payment.status === 'PENDING';
    const contactUser = isSeller ? order.buyer : order.seller;
    const contactLabel = isSeller ? 'buyer' : 'seller';
    const backUrl = isSeller ? '/orders-seller' : '/orders';
    const statusKey = order.status === 'pending_payment' ? 'pending' : order.status;
    const statusBadgeClass = 'badge-' + (['pending', 'confirmed', 'completed', 'cancelled'].includes(statusKey) ? statusKey : 'pending');
    const productImage = order.product && Array.isArray(order.product.images) && order.product.images.length ? order.product.images[0] : '';
    const totalAmount = (order.priceSnapshot || 0) * (order.quantity || 1);
    const eventLabels = {
      pending: 'Order Placed',
      pending_payment: 'Payment Pending',
      confirmed: 'Order Confirmed',
      completed: 'Order Completed',
      cancelled: 'Order Cancelled'
    };
    const fmtDate = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    let entries = (order.timeline && order.timeline.length) ? order.timeline.slice() : [];
    if (entries.length === 0) {
      entries.push({ event: order.status === 'pending_payment' ? 'pending_payment' : 'pending', at: order.createdAt, note: 'We have received your order.' });
      if (order.confirmedAt) entries.push({ event: 'confirmed', at: order.confirmedAt, note: 'Seller confirmed the order.' });
      if (order.completedAt) entries.push({ event: 'completed', at: order.completedAt, note: 'Order marked as finished.' });
      if (order.cancelledAt) entries.push({ event: 'cancelled', at: order.cancelledAt, note: 'Order was cancelled.' });
    }
    entries.sort((a, b) => new Date(a.at) - new Date(b.at));
    const shippingLines = order.deliveryMode === 'ship'
      ? [
          order.shippingAddress?.name,
          order.shippingAddress?.street,
          order.shippingAddress?.district,
          order.shippingAddress?.city
        ].filter(Boolean)
      : ['Self-pickup', order.pickupLocation?.address || 'Meet at the pickup point selected during checkout.'];
  %>

  <main class="main">
    <div class="content">
      <div class="tracking-container">
        <header class="tracking-page-header">
          <div class="tracking-page-copy">
            <div class="tracking-title-row">
              <a href="<%= backUrl %>" class="back-button" aria-label="Back to orders">
                <i data-lucide="arrow-left"></i>
              </a>
              <h1>Order #<%= String(order._id).substring(0, 8).toUpperCase() %></h1>
              <span class="badge <%= statusBadgeClass %>"><%= order.status.replace(/_/g, ' ') %></span>
            </div>
            <p>Placed on <%= new Date(order.createdAt).toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
          </div>
          <div class="tracking-page-actions">
            <a href="/messages?id=<%= order.conversation || '' %>" class="btn-message">
              <i data-lucide="message-circle"></i>
              Message <%= contactLabel %>
            </a>
            <% if (canResumePayment) { %>
              <a href="/checkout/payment/<%= payment._id %>" class="payment-resume-btn">
                Continue payment
              </a>
            <% } %>
            <% if (canDispute && !hasActiveDispute) { %>
              <button class="btn-report-problem" type="button" data-action="open-dispute-modal">
                <i data-lucide="alert-triangle"></i>
                Report a problem
              </button>
            <% } %>
          </div>
        </header>

        <% if (order.dispute) { %>
          <div class="dispute-banner dispute-<%= order.dispute.status %>">
            <div class="dispute-banner-icon">
              <% if (order.dispute.status === 'resolved') { %>&#10003;<% } else if (order.dispute.status === 'rejected') { %>&#10005;<% } else { %>&#9888;<% } %>
            </div>
            <div class="dispute-banner-body">
              <div class="dispute-banner-title">
                <% if (order.dispute.status === 'open') { %>Dispute open<% } else if (order.dispute.status === 'in_review') { %>Dispute under review<% } else if (order.dispute.status === 'resolved') { %>Dispute resolved<% } else { %>Dispute rejected<% } %>
                <span class="dispute-banner-cat"><%= order.dispute.category %></span>
              </div>
              <div class="dispute-banner-reason"><strong>Reason:</strong> <%= order.dispute.reason %></div>
              <div class="dispute-banner-meta">
                Opened by <strong><%= order.dispute.openedBy?.nickname || order.dispute.openedBy?.name || 'Unknown' %></strong>
                &middot; <%= new Date(order.dispute.openedAt).toLocaleString() %>
              </div>
            </div>
          </div>
        <% } %>

        <div class="tracking-layout">
          <section class="tracking-main-column">
            <div class="tracking-map-card">
              <div id="map"></div>
              <div class="tracking-map-meta" aria-live="polite">
                <span id="distanceValue">Calculating...</span>
                <span id="estimatedTime"></span>
              </div>
            </div>

            <div class="tracking-card tracking-stepper-card">
              <h2 class="tracking-card-title">Tracking Status</h2>
              <div class="status-timeline">
                <% entries.forEach((e, idx) => {
                  const isCancel = e.event === 'cancelled';
                  const isLast = idx === entries.length - 1;
                  const dotClass = isCancel ? 'cancelled' : (isLast ? 'active' : 'completed');
                %>
                  <div class="timeline-item">
                    <div class="timeline-dot <%= dotClass %>">
                      <% if (isCancel) { %>
                        <i data-lucide="x"></i>
                      <% } else if (dotClass === 'completed') { %>
                        <i data-lucide="check"></i>
                      <% } else { %>
                        <span></span>
                      <% } %>
                    </div>
                    <div class="timeline-content">
                      <div class="timeline-title <%= dotClass === 'active' ? 'active' : '' %>"><%= eventLabels[e.event] || e.event %></div>
                      <div class="timeline-meta"><%= e.note || '' %></div>
                      <% if (e.at) { %><div class="timeline-date"><%= fmtDate(e.at) %></div><% } %>
                    </div>
                  </div>
                <% }); %>

                <% if (order.status === 'pending') { %>
                  <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content muted">
                      <div class="timeline-title">Awaiting Confirmation</div>
                      <div class="timeline-meta">Seller will review your request soon.</div>
                    </div>
                  </div>
                <% } else if (order.status === 'confirmed') { %>
                  <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content muted">
                      <div class="timeline-title">Processing</div>
                      <div class="timeline-meta">Seller is preparing your item.</div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </section>

          <aside class="tracking-side-column">
            <div class="tracking-card">
              <h2 class="tracking-card-title">Customer Information</h2>
              <div class="tracking-info-stack">
                <div class="tracking-info-block">
                  <p class="tracking-eyebrow">Contact</p>
                  <div class="tracking-icon-row">
                    <i data-lucide="mail"></i>
                    <div>
                      <strong><%= contactUser?.nickname || contactUser?.name || 'Unknown user' %></strong>
                      <span><%= contactUser?.email || 'No email available' %></span>
                    </div>
                  </div>
                </div>
                <div class="tracking-info-block">
                  <p class="tracking-eyebrow"><%= order.deliveryMode === 'ship' ? 'Shipping Address' : 'Pickup Location' %></p>
                  <div class="tracking-icon-row align-start">
                    <i data-lucide="<%= order.deliveryMode === 'ship' ? 'map-pin' : 'store' %>"></i>
                    <div>
                      <% shippingLines.forEach((line) => { %>
                        <span><%= line %></span>
                      <% }); %>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <% if (canManageStatus) { %>
            <div class="tracking-card tracking-status-card">
              <h2 class="tracking-card-title">Order Status</h2>
              <p class="tracking-status-caption">Update this order directly from tracking.</p>
              <div class="tracking-status-menu tracking-status-<%= statusKey %>" data-order-status-menu data-order-id="<%= order._id %>" data-prev-status="<%= order.status %>" data-status="<%= order.status %>" data-raw-status="<%= order.status %>">
                <button type="button" class="tracking-status-trigger" data-action="toggle-order-status" aria-haspopup="true" aria-expanded="false">
                  <span class="tracking-status-trigger-label"><%= order.status === 'pending_payment' ? 'Pending payment' : order.status.replace(/_/g, ' ') %></span>
                  <span class="tracking-status-trigger-icon">▾</span>
                </button>
                <div class="tracking-status-panel" role="menu">
                  <button type="button" class="tracking-status-option" data-action="select-order-status" data-status-value="pending" role="menuitem">
                    <span class="tracking-status-option-dot"></span>
                    <span>Pending</span>
                  </button>
                  <button type="button" class="tracking-status-option" data-action="select-order-status" data-status-value="confirmed" role="menuitem">
                    <span class="tracking-status-option-dot"></span>
                    <span>Confirmed</span>
                  </button>
                  <button type="button" class="tracking-status-option" data-action="select-order-status" data-status-value="completed" role="menuitem">
                    <span class="tracking-status-option-dot"></span>
                    <span>Completed</span>
                  </button>
                  <button type="button" class="tracking-status-option" data-action="select-order-status" data-status-value="cancelled" role="menuitem">
                    <span class="tracking-status-option-dot"></span>
                    <span>Cancelled</span>
                  </button>
                </div>
              </div>
            </div>
            <% } %>

            <div class="tracking-card">
              <h2 class="tracking-card-title">Order Summary</h2>
              <div class="tracking-product-row">
                <div class="tracking-product-thumb">
                  <% if (productImage) { %>
                    <img src="<%= productImage %>" alt="<%= order.product?.title || 'Product image' %>">
                  <% } else { %>
                    <i data-lucide="package"></i>
                  <% } %>
                </div>
                <div class="tracking-product-copy">
                  <% if (order.product) { %>
                    <a href="/products/<%= order.product._id %>"><%= order.product.title %></a>
                  <% } else { %>
                    <span>Product unavailable</span>
                  <% } %>
                  <small>Qty: <%= order.quantity || 1 %></small>
                </div>
                <strong><%= formatVND(order.priceSnapshot || 0) %></strong>
              </div>
              <div class="tracking-summary-list">
                <div>
                  <span>Subtotal</span>
                  <strong><%= formatVND(totalAmount) %></strong>
                </div>
                <div>
                  <span>Delivery</span>
                  <strong><%= order.deliveryMode === 'ship' ? 'Shipping' : 'Pickup' %></strong>
                </div>
                <div>
                  <span>Payment</span>
                  <strong><%= order.paymentMode === 'qr' ? 'QR Transfer' : (order.paymentMode === 'card' ? 'Card' : 'Cash') %></strong>
                </div>
                <div class="tracking-summary-total">
                  <span>Total</span>
                  <strong><%= formatVND(totalAmount) %></strong>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </main>

  <script defer src="/vendor/leaflet-1.9.4/leaflet.js"></script>
  <script defer src="/vendor/leaflet-routing-machine-3.2.12/leaflet-routing-machine.min.js"></script>
  <link rel="stylesheet" href="/vendor/leaflet-routing-machine-3.2.12/leaflet-routing-machine.css" />

  <div class="dispute-modal-backdrop" id="dispute-modal-backdrop">
    <div class="dispute-modal" role="dialog" aria-modal="true">
      <h3>Report a problem</h3>
      <p class="sub">Tell us what went wrong. An admin will review your report.</p>

      <label for="dispute-category">Category</label>
      <select id="dispute-category">
        <option value="item-not-received">Item not received</option>
        <option value="item-damaged">Item damaged</option>
        <option value="wrong-item">Wrong item</option>
        <option value="item-not-as-described">Not as described</option>
        <option value="payment-issue">Payment issue</option>
        <option value="fraud">Fraud / scam</option>
        <option value="other">Other</option>
      </select>

      <label for="dispute-reason">Short reason <span style="color:#DC2626">*</span></label>
      <input type="text" id="dispute-reason" maxlength="200" placeholder="e.g. Item never arrived after 5 days">

      <label for="dispute-description">Details (optional)</label>
      <textarea id="dispute-description" maxlength="2000" placeholder="Describe what happened, dates, conversations, etc."></textarea>

      <label>Evidence (max 6 images)</label>
      <div class="dispute-evidence-list" id="dispute-evidence-list">
        <button type="button" class="dispute-evidence-add" id="dispute-evidence-add" title="Add image">+</button>
      </div>
      <input type="file" id="dispute-evidence-input" accept="image/*" style="display:none">

      <div class="dispute-modal-actions">
        <button type="button" class="cancel" data-action="close-dispute-modal">Cancel</button>
        <button type="button" class="submit" id="dispute-submit-btn" data-action="submit-dispute">Submit report</button>
      </div>
    </div>
  </div>

  <%
    function safeJson(value) {
      return JSON.stringify(value)
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/&/g, '\\u0026')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029');
    }
  %>
  <script id="order-tracking-config" type="application/json"><%- safeJson({
    order,
    isBuyer,
    isSeller,
    canManageStatus,
    orderId: String(order._id)
  }) %></script>
  <script defer src="/js/pages/order-tracking.js"></script>
</body>
</html>
