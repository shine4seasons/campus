<!DOCTYPE html>
<html lang="en" class="dashboard-shell">
<head>
  <%- include('partials/head', { pageTitle: 'Order Tracking - Campus Marketplace', pageStyles: ['dashboard', 'rating', 'order-tracking-page'] }) %>
  <link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />
</head>

<body class="dashboard-page">
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="content">
          <div class="tracking-container">
            <a href="/orders" class="back-button"><i data-lucide="arrow-left" style="width:14px;height:14px;"></i> Back
              to Orders</a>

            <div
              style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 20px; flex-wrap: wrap;">
              <div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 4px;">
                  <h1 style="font-size: 32px; font-weight: 900; color: var(--t1); letter-spacing: -0.03em;">
                    Track Order
                  </h1>
                  <span
                    class="badge <%= 'badge-' + (order.status === 'pending' ? 'pending' : (order.status === 'confirmed' ? 'confirmed' : (order.status === 'completed' ? 'completed' : (order.status === 'cancelled' ? 'cancelled' : 'pending')))) %>">
                    <%= order.status %>
                  </span>
                </div>
                <div class="order-id-chip">
                  #<%= String(order._id).substring(0, 8).toUpperCase() %>
                </div>
              </div>
            </div>

            <% const meId=String(user._id); const isBuyer=order.buyer && String(order.buyer._id)===meId; const
              isSeller=order.seller && String(order.seller._id)===meId; const canDispute=(isBuyer || isSeller) &&
              (order.status==='confirmed' || order.status==='completed' ) && (!order.dispute ||
              order.dispute.status==='resolved' || order.dispute.status==='rejected' ); const
              hasActiveDispute=order.dispute && (order.dispute.status==='open' || order.dispute.status==='in_review' );
              const canResumePayment = isBuyer && order.paymentMode === 'qr' && order.status === 'pending_payment' && payment && payment.status === 'PENDING';
              %>

              <% if (canResumePayment) { %>
                <div class="payment-resume-card">
                  <div class="payment-resume-main">
                    <div class="payment-resume-icon">
                      <i data-lucide="qr-code" style="width:20px;height:20px;"></i>
                    </div>
                    <div>
                      <div class="payment-resume-label">Payment Required</div>
                      <div class="payment-resume-title">Complete your QR payment to continue this order</div>
                      <div class="payment-resume-sub">
                        Transfer exactly
                        <strong><%= formatVND(payment.amount) %></strong>
                        using the existing payment session.
                      </div>
                    </div>
                  </div>
                  <a href="/checkout/payment/<%= payment._id %>" class="payment-resume-btn">
                    <i data-lucide="arrow-up-right" style="width:16px;height:16px;"></i>
                    Continue payment
                  </a>
                </div>
              <% } %>

              <% if (order.dispute) { %>
                <div class="dispute-banner dispute-<%= order.dispute.status %>">
                  <div class="dispute-banner-icon">
                    <% if (order.dispute.status==='resolved' ) { %>&#10003;
                      <% } else if (order.dispute.status==='rejected' ) { %>&#10005;
                        <% } else { %>&#9888;<% } %>
                  </div>
                  <div class="dispute-banner-body">
                    <div class="dispute-banner-title">
                      <% if (order.dispute.status==='open' ) { %>Dispute open
                        <% } else if (order.dispute.status==='in_review' ) { %>Dispute under review
                          <% } else if (order.dispute.status==='resolved' ) { %>Dispute resolved
                            <% } else { %>Dispute rejected<% } %>
                                <span class="dispute-banner-cat">
                                  <%= order.dispute.category %>
                                </span>
                    </div>
                    <div class="dispute-banner-reason"><strong>Reason:</strong>
                      <%= order.dispute.reason %>
                    </div>
                    <div class="dispute-banner-meta">
                      Opened by <strong>
                        <%= order.dispute.openedBy?.nickname || order.dispute.openedBy?.name || 'Unknown' %>
                      </strong>
                      &middot; <%= new Date(order.dispute.openedAt).toLocaleString() %>
                    </div>
                  </div>
                </div>
                <% } %>

                  <!-- Next Action Card (Compact) -->
                  <div class="next-action-card">
                    <div class="next-action-icon">
                      <% if (order.status==='pending' ) { %><i data-lucide="clock"></i>
                        <% } else if (order.status==='confirmed' ) { %><i data-lucide="package"></i>
                          <% } else if (order.status==='completed' ) { %><i data-lucide="check-circle"></i>
                            <% } else { %><i data-lucide="x-circle"></i>
                              <% } %>
                    </div>
                    <div class="next-action-body">
                      <div class="next-action-label">Next Step</div>
                      <div class="next-action-title">
                        <% if (order.status==='pending' ) { %>Waiting for seller confirmation
                          <% } else if (order.status==='confirmed' ) { %>Prepare for exchange / delivery
                            <% } else if (order.status==='completed' ) { %>Leave a review for the seller
                              <% } else { %>&#9888;<% } %>
                      </div>
                    </div>
                    <div class="next-action-eta"
                      style="margin-left: 12px; padding-left: 12px; border-left: 1px solid var(--border);">
                      <% if (order.status==='pending' ) { %>Est. 24h
                        <% } else if (order.status==='confirmed' ) { %>Est. 1-2d
                          <% } else if (order.status==='completed' ) { %>Done<% } %>
                    </div>
                  </div>

                  <% if (canDispute && !hasActiveDispute) { %>
                    <button class="btn-report-problem" data-action="open-dispute-modal">
                      <i data-lucide="alert-triangle" style="width:14px;height:14px;"></i> Report a problem
                    </button>
                    <% } %>

                      <div class="tracking-grid">
                        <!-- Left column: Map (35%) -->
                        <aside>
                          <div class="tracking-card">
                            <div class="tracking-header">
                              <div class="tracking-title">Live Route</div>
                            </div>

                            <div id="map"></div>

                            <div class="map-legend">
                              <div class="legend-item"><span class="legend-dot buyer-dot"></span><span>Buyer destination</span></div>
                              <div class="legend-item"><span class="legend-dot seller-dot"></span><span>Seller origin</span>
                              </div>
                            </div>

                            <div class="distance-info"
                              style="background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin: 20px 0;">
                              <div
                                style="font-size: 11px; font-weight: 800; color: var(--t3); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">
                                Estimated Distance</div>
                              <div id="distanceValue"
                                style="font-size: 24px; font-weight: 900; color: var(--primary); margin-bottom: 4px;">
                                Calculating...</div>
                              <div id="estimatedTime" style="font-size: 13px; font-weight: 600; color: var(--success);">
                              </div>
                            </div>

                            <div class="order-details-card"
                              style="background: transparent; border-color: var(--border); padding: 16px;">
                              <div
                                style="font-size: 11px; font-weight: 800; color: var(--t3); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
                                Delivery Details</div>
                              <div style="font-size: 14px; line-height: 1.6; color: var(--t2);">
                                <% if (order.deliveryMode==='ship' ) { %>
                                  <div style="display:flex; gap:10px;">
                                    <i data-lucide="truck"
                                      style="width:18px;height:18px;color:var(--primary);flex-shrink:0;"></i>
                                    <div>
                                      <strong style="color:var(--t1)">Shipping to:</strong><br />
                                      <%= order.shippingAddress?.name %><br />
                                        <%= order.shippingAddress?.street %><br />
                                          <%= order.shippingAddress?.district %>
                                    </div>
                                  </div>
                                  <% } else { %>
                                    <div style="display:flex; gap:10px;">
                                      <i data-lucide="map-pin"
                                        style="width:18px;height:18px;color:var(--success);flex-shrink:0;"></i>
                                      <div>
                                        <strong style="color:var(--t1)">Self-Pickup:</strong><br />
                                        Meet at the pickup point selected during checkout.
                                      </div>
                                    </div>
                                    <% } %>
                              </div>
                            </div>
                          </div>
                        </aside>

                        <!-- Right column: Status & Actions (65%) -->
                        <section>
                          <div class="tracking-card">
                            <div class="tracking-header">
                              <div class="tracking-title">Order Information</div>
                            </div>

                            <div class="order-details-card">
                              <div style="margin-bottom: 24px;">
                                <% if (order.product) { %>
                                  <a href="/products/<%= order.product._id %>" class="order-product-name">
                                    <%= order.product.title %>
                                  </a>
                                  <% } %>
                                    <span class="order-product-price">
                                      <%= formatVND(order.priceSnapshot) %>
                                    </span>
                                    <div style="font-size:13px;color:var(--t3);font-weight:700;margin-top:-10px;">
                                      Quantity: <%= order.quantity || 1 %>
                                    </div>
                              </div>

                              <div
                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; border-top: 1px solid var(--border); padding-top: 20px;">
                                <div class="order-info-row"
                                  style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                  <span class="order-info-label">Payment Mode</span>
                                  <span class="order-info-value">
                                    <%= order.paymentMode==='qr' ? 'QR Transfer' : (order.paymentMode==='card' ? 'Card' : 'Cash') %>
                                  </span>
                                </div>
                                <div class="order-info-row"
                                  style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                  <span class="order-info-label">Order Created</span>
                                  <span class="order-info-value">
                                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                      day: 'numeric' , year: 'numeric' }) %>
                                  </span>
                                </div>
                              </div>
                            </div>

                            <!-- Enhanced Status Timeline -->
                            <div class="status-timeline">
                              <% let entries=(order.timeline && order.timeline.length) ? order.timeline.slice() : []; if
                                (entries.length===0) { entries.push({ event: 'pending' , at: order.createdAt,
                                note: 'Order placed by buyer' }); if (order.confirmedAt) entries.push({
                                event: 'confirmed' , at: order.confirmedAt, note: 'Seller confirmed the order' }); if
                                (order.completedAt) entries.push({ event: 'completed' , at: order.completedAt,
                                note: 'Order marked as finished' }); if (order.cancelledAt) entries.push({
                                event: 'cancelled' , at: order.cancelledAt, note: 'Order was cancelled' }); }
                                entries.sort((a, b)=> new Date(a.at) - new Date(b.at));
                                const eventLabels = { pending: 'Order Placed', confirmed: 'Order Confirmed', completed:
                                'Order Completed', cancelled: 'Order Cancelled' };
                                const fmtDate = (d) => new Date(d).toLocaleDateString('en-US', { month: 'short', day:
                                'numeric', hour: '2-digit', minute: '2-digit' });
                                %>

                                <% entries.forEach((e, idx)=> {
                                  const isCancel = e.event === 'cancelled';
                                  const isLast = idx === entries.length - 1;
                                  const dotClass = isCancel ? '' : (isLast ? 'active' : 'completed');
                                  %>
                                  <div class="timeline-item">
                                    <div class="timeline-dot <%= dotClass %>"
                                      style="<%= isCancel ? 'background:#dc2626;border-color:#dc2626;color:white;' : '' %>">
                                      <% if (isCancel) { %><i data-lucide="x" style="width:14px;height:14px;"></i>
                                        <% } else if (dotClass==='completed' ) { %><i data-lucide="check"
                                            style="width:14px;height:14px;"></i>
                                          <% } else if (dotClass==='active' ) { %><i data-lucide="circle"
                                              style="width:12px;height:12px;fill:white;"></i>
                                            <% } %>
                                    </div>
                                    <div class="timeline-content">
                                      <div class="timeline-title <%= dotClass === 'active' ? 'active' : '' %>"
                                        style="<%= isCancel ? 'color:#dc2626' : '' %>">
                                        <%= eventLabels[e.event] || e.event %>
                                      </div>
                                      <div class="timeline-date">
                                        <%= fmtDate(e.at) %>
                                      </div>
                                      <div class="timeline-meta">
                                        <%= e.note || '' %>
                                      </div>
                                    </div>
                                  </div>
                                  <% }); %>

                                    <% if (order.status==='pending' ) { %>
                                      <div class="timeline-item">
                                        <div class="timeline-dot"></div>
                                        <div class="timeline-content">
                                          <div class="timeline-title" style="color:var(--t3)">Awaiting Confirmation
                                          </div>
                                          <div class="timeline-meta">Seller will review your request soon</div>
                                        </div>
                                      </div>
                                      <% } else if (order.status==='confirmed' ) { %>
                                        <div class="timeline-item">
                                          <div class="timeline-dot"></div>
                                          <div class="timeline-content">
                                            <div class="timeline-title" style="color:var(--t3)">Awaiting Pickup/Delivery
                                            </div>
                                            <div class="timeline-meta">Preparing for exchange</div>
                                          </div>
                                        </div>
                                        <% } %>
                            </div>

                            <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border);">
                              <div
                                style="font-size: 11px; font-weight: 800; color: var(--t3); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px;">
                                Contact Information</div>
                              <div class="person-card">
                                <div class="person-avatar">
                                  <% if (order.seller.avatar) { %>
                                    <img src="<%= order.seller.avatar %>" alt="<%= order.seller.name %>" />
                                    <% } else { %>
                                      <%= (order.seller.name || 'S' ).charAt(0).toUpperCase() %>
                                        <% } %>
                                </div>
                                <div class="person-info">
                                  <div class="person-name">
                                    <%= order.seller.nickname || order.seller.name %>
                                  </div>
                                  <div class="person-role">Verified Seller &middot; <i data-lucide="star"
                                      style="width:12px;height:12px;fill:#fbbf24;color:#fbbf24;display:inline-block;"></i>
                                    <%= (order.seller.rating || 5).toFixed(1) %>
                                  </div>
                                </div>
                                <div style="flex-shrink:0;">
                                  <a href="/messages?id=<%= order.conversation || '' %>" class="btn-message">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                    Message
                                  </a>
                                </div>
                              </div>
                            </div>
                          </div>
                        </section>
                      </div>
          </div>
        </div>
      </main>

      <!-- Leaflet JS for maps -->
      <script defer src="/vendor/leaflet-1.9.4/leaflet.js"></script>
      <!-- Leaflet Routing Machine for routes -->
      <script defer src="/vendor/leaflet-routing-machine-3.2.12/leaflet-routing-machine.min.js"></script>
      <link rel="stylesheet"
        href="/vendor/leaflet-routing-machine-3.2.12/leaflet-routing-machine.css" />


      <!-- Dispute modal -->
      <div class="dispute-modal-backdrop" id="dispute-modal-backdrop">
        <div class="dispute-modal" role="dialog" aria-modal="true">
          <h3>Report a problem</h3>
          <p class="sub">Tell us what went wrong. An admin will review your report.</p>

          <label for="dispute-category">Category</label>
          <select id="dispute-category">
            <option value="item-not-received">Item not received</option>
            <option value="item-damaged">Item damaged</option>
            <option value="wrong-item">Wrong item</option>
            <option value="item-not-as-described">Not as described</option>
            <option value="payment-issue">Payment issue</option>
            <option value="fraud">Fraud / scam</option>
            <option value="other">Other</option>
          </select>

          <label for="dispute-reason">Short reason <span style="color:#DC2626">*</span></label>
          <input type="text" id="dispute-reason" maxlength="200" placeholder="e.g. Item never arrived after 5 days">

          <label for="dispute-description">Details (optional)</label>
          <textarea id="dispute-description" maxlength="2000"
            placeholder="Describe what happened, dates, conversations, etc."></textarea>

          <label>Evidence (max 6 images)</label>
          <div class="dispute-evidence-list" id="dispute-evidence-list">
            <button type="button" class="dispute-evidence-add" id="dispute-evidence-add" title="Add image">+</button>
          </div>
          <input type="file" id="dispute-evidence-input" accept="image/*" style="display:none">

          <div class="dispute-modal-actions">
            <button type="button" class="cancel" data-action="close-dispute-modal">Cancel</button>
            <button type="button" class="submit" id="dispute-submit-btn" data-action="submit-dispute">Submit
              report</button>
          </div>
        </div>
      </div>

      <%
        function safeJson(value) {
          return JSON.stringify(value)
            .replace(/</g, '\\u003c')
            .replace(/>/g, '\\u003e')
            .replace(/&/g, '\\u0026')
            .replace(/\u2028/g, '\\u2028')
            .replace(/\u2029/g, '\\u2029');
        }
      %>
      <script id="order-tracking-config" type="application/json"><%- safeJson({
          order,
          isBuyer,
          isSeller,
          orderId: String(order._id)
        }) %></script>
      <script defer src="/js/pages/order-tracking.js"></script>

</body>

</html>

