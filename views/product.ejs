<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: product.title + ' - Campus Marketplace', pageStyles: ['product', 'image-modal', 'rating'] }) %>
  <link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />
  <script defer src="/vendor/leaflet-1.9.4/leaflet.js"></script>
</head>

<body class="product-page">
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

  <%
    const p         = product;
    const seller    = p.seller || {};
    const isOwner   = user && (String(p.seller && p.seller._id ? p.seller._id : p.seller) === String(user && user._id));
    const isAdmin   = (typeof isAdminProductPreview !== 'undefined' && isAdminProductPreview) || (user && user.role === 'admin');
    const canBuyerAct = !isAdmin && !isOwner;
    const availableQty = typeof p.quantity === 'number' ? p.quantity : 1;
    const isSold    = p.status === 'sold' || availableQty <= 0;
    const CAT_LABEL = { books:'Books', electronics:'Electronics', clothing:'Clothing', furniture:'Furniture', 'daily-needs':'Daily needs', sports:'Sports', gaming:'Gaming', other:'Other' };
    const COND_INFO = { new:['','New','badge-new'], 'like-new':['','Like new','badge-like-new'], good:['','Good','badge-good'], fair:['','Fair','badge-fair'] };
    const cond      = COND_INFO[p.condition] || ['', p.condition, 'badge-new'];
    const sellerName = seller.nickname || seller.name || 'Anonymous';
    const joinDate  = seller.createdAt ? new Date(seller.createdAt).toLocaleDateString('en-US', { month:'long', year:'numeric' }) : '';

    function timeAgo(dateStr) {
      if (!dateStr) return '';
      const diff = Date.now() - new Date(dateStr).getTime();
      const m = Math.floor(diff / 60000);
      if (m < 1)  return 'Just now';
      if (m < 60) return m + ' minute' + (m > 1 ? 's' : '') + ' ago';
      const h = Math.floor(m / 60);
      if (h < 24) return h + ' hour' + (h > 1 ? 's' : '') + ' ago';
      const d = Math.floor(h / 24);
      if (d < 30) return d + ' day' + (d > 1 ? 's' : '') + ' ago';
      const mo = Math.floor(d / 30);
      return mo + ' month' + (mo > 1 ? 's' : '') + ' ago';
    }

    function fmtPrice(val) {
      if (typeof val !== 'number') return '0 VND';
      return formatVND(val);
    }

    function safeJson(value) {
      return JSON.stringify(value)
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/&/g, '\\u0026')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029');
    }
  %>

  <main class="pdp">

    <!-- Breadcrumb -->
    <nav class="pdp-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="pdp-crumb-sep">/</span>
      <a href="/?cat=<%= p.category %>"><%= CAT_LABEL[p.category] || p.category %></a>
      <span class="pdp-crumb-sep">/</span>
      <span class="pdp-crumb-current"><%= p.title %></span>
    </nav>

    <!-- HERO: Gallery + Purchase Panel (40/60) -->
    <section class="pdp-hero">

      <!-- 40% Gallery -->
      <div class="pdp-gallery">
        <div class="pdp-main-img premium-card">
          <% if (p.images && p.images[0]) { %>
            <img id="main-img" src="<%= p.images[0] %>" alt="<%= p.title %>" data-action="open-image">
          <% } else { %>
            <div class="pdp-img-fallback">
              <i data-lucide="package" style="width:48px;height:48px;opacity:0.1;"></i>
            </div>
          <% } %>
          <% if (isSold) { %><span class="pdp-sold-ribbon">SOLD</span><% } %>
        </div>
        <% if (p.images && p.images.length > 1) { %>
          <div class="pdp-thumbs">
            <% p.images.forEach(function(url, i) { %>
              <button type="button" class="pdp-thumb <%= i === 0 ? 'active' : '' %>" data-action="set-image" data-index="<%= i %>">
                <img src="<%= url %>" alt="thumbnail <%= i+1 %>">
              </button>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- 60% Sticky Purchase Panel -->
      <aside class="pdp-buy premium-card glass">
        <div class="pdp-price">
          <%= fmtPrice(p.price) %>
        </div>

        <h1 class="pdp-title"><%= p.title %></h1>

        <div class="pdp-badges">
          <span class="pdp-badge <%= cond[2] %>"><%= cond[1] %></span>
          <span class="pdp-badge pdp-badge-cat"><%= CAT_LABEL[p.category] || p.category %></span>
          <span class="pdp-badge pdp-badge-cat"><%= availableQty %> available</span>
        </div>

        <div class="pdp-meta">
          <span><i data-lucide="eye"></i> <%= p.views || 0 %> views</span>
          <span style="color:var(--border-2);">•</span>
          <span><i data-lucide="heart"></i> <span id="int-count">(<%= p.interested || 0 %>)</span> interested</span>
          <span style="color:var(--border-2);">•</span>
          <span><i data-lucide="clock"></i> <%= timeAgo(p.createdAt) %></span>
        </div>

        <div class="pdp-actions">
          <% if (isSold) { %>
            <div class="sold-overlay">This item has been sold</div>
          <% } else if (isOwner) { %>
            <div class="owner-actions" style="display:flex; flex-direction:column; gap:12px;">
              <div style="display:flex; gap:10px;">
                <a href="/edit-product/<%= p._id %>" class="btn-interested" style="flex:1;">
                  <i data-lucide="edit-3"></i> Edit Product
                </a>
                <button class="btn-contact" style="flex:2;" data-action="mark-sold">
                  <i data-lucide="check-circle"></i> Mark as Sold
                </button>
              </div>
              <button class="btn-delete" data-action="delete-product">
                <i data-lucide="trash-2" style="width:16px;"></i> Delete Product
              </button>
            </div>
          <% } else if (isAdmin) { %>
            <div class="sold-overlay">Admin preview mode</div>
          <% } else { %>
            <button class="btn-contact" id="btn-msg-seller" data-action="init-chat">
              <i data-lucide="message-circle"></i> Chat with Seller
            </button>
            <button type="button" class="btn-interested" id="btn-interested" data-action="toggle-interested" aria-pressed="false">
              <i data-lucide="heart" id="heart-icon"></i> <span data-interest-label>Add to Interests</span>
            </button>
          <% } %>
        </div>

        <!-- Seller Trust Card -->
        <div class="pdp-seller-mini">
          <a href="/user/<%= seller._id %>" class="pdp-seller-row">
            <div class="pdp-seller-avatar">
              <% if (seller.avatar) { %>
                <img src="<%= seller.avatar %>" alt="<%= sellerName %>">
              <% } else { %>
                <span><%= (sellerName[0] || '?').toUpperCase() %></span>
              <% } %>
            </div>
            <div class="pdp-seller-info">
              <div class="pdp-seller-name"><%= sellerName %></div>
              <div class="pdp-seller-stats">
                <span style="color:#f59e0b; font-weight:700;">★ <%= (seller.rating || 5).toFixed(1) %></span>
                <span style="opacity:0.3;">•</span>
                <span><%= seller.totalSales || 0 %> sold</span>
                <span style="opacity:0.3;">•</span>
                <span>Joined <%= joinDate %></span>
              </div>
            </div>
            <i data-lucide="chevron-right" class="pdp-seller-arrow"></i>
          </a>
        </div>

        <div class="pdp-safety">
          <i data-lucide="shield-check"></i>
          <div>
            <strong>Campus Safety Tip</strong>
            Meet in person at public campus areas like the library or canteen. Inspect items before paying.
          </div>
        </div>
      </aside>
    </section>

    <!-- DESCRIPTION + MAP (65/35) -->
    <section class="pdp-cols">
      <div class="pdp-card pdp-desc-card">
        <h2 class="pdp-card-title">
          <i data-lucide="align-left"></i> Description
        </h2>
        <div class="pdp-desc"><%= p.description %></div>
      </div>

      <% if (p.location && p.location.address) { %>
        <div class="pdp-card pdp-location-card">
          <h2 class="pdp-card-title">
            <i data-lucide="map-pin"></i> Pickup location
          </h2>
          <div class="pdp-location-addr">
            <%= p.location.address %>
          </div>
          <div id="product-map" class="pdp-map"></div>
        </div>
      <% } %>
    </section>

    <!-- BUY NOW -->
    <% if (!isSold && canBuyerAct) { %>
      <section class="pdp-card pdp-buy-inline">
        <div class="pdp-buy-inline-copy">
          <div class="pdp-buy-inline-label">Ready to buy?</div>
          <div class="pdp-buy-inline-price"><%= fmtPrice(p.price) %></div>
          <div class="pdp-buy-inline-sub">This button stays in the page flow and scrolls with you.</div>
        </div>
        <div class="pdp-buy-inline-actions">
          <button class="buy-bar-buy" data-action="go-checkout">
            Buy Now
          </button>
        </div>
      </section>
    <% } %>

    <!-- REVIEWS -->
    <section class="pdp-card pdp-reviews">
      <h2 class="pdp-card-title">
        <i data-lucide="star"></i> Reviews
      </h2>
      
      <div id="product-rating-stats">
        <div id="product-rating-stats-content" class="pdp-no-reviews">No reviews yet</div>
      </div>

      <% if (user && canBuyerAct) { %>
        <div class="pdp-leave-review">
          <div class="pdp-leave-title">Write a review</div>
          <div class="pdp-stars-input rating-input" id="rating-stars">
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="star star-empty" data-score="<%= i %>">★</span>
            <% } %>
          </div>
          <textarea id="rating-comment" class="pdp-review-textarea"
            placeholder="What did you think of this product?"></textarea>
          <div class="pdp-review-actions">
            <button class="btn-cancel-rating" data-action="reset-rating">Cancel</button>
            <button class="btn-submit-rating" data-action="submit-rating">Submit review</button>
          </div>
        </div>
      <% } %>

      <div id="product-ratings-list" class="pdp-reviews-list">
        <div id="product-ratings-list-content"></div>
      </div>
    </section>

    <!-- SELLER FULL CARD -->
    <section class="pdp-card pdp-seller-full">
      <div class="pdp-seller-full-row">
        <div class="pdp-seller-avatar pdp-seller-avatar-lg">
          <% if (seller.avatar) { %>
            <img src="<%= seller.avatar %>" alt="<%= sellerName %>">
          <% } else { %>
            <span><%= (sellerName[0] || '?').toUpperCase() %></span>
          <% } %>
        </div>
        <div class="pdp-seller-full-info">
          <a href="/user/<%= seller._id %>" class="pdp-seller-full-name"><%= sellerName %></a>
          <div class="pdp-seller-uni">
            <i data-lucide="graduation-cap" style="width:14px; margin-right:4px;"></i>
            <%= seller.university || 'Campus Marketplace' %>
            <% if (joinDate) { %> · Joined <%= joinDate %><% } %>
          </div>
          <div class="pdp-seller-grid">
            <div><strong><%= (seller.rating || 5).toFixed(1) %></strong> <span>Rating</span></div>
            <div><strong><%= seller.totalSales || 0 %></strong> <span>Sold</span></div>
            <div><strong><%= seller.ratingCount || 0 %></strong> <span>Reviews</span></div>
          </div>
        </div>
        <div class="pdp-seller-full-actions">
          <a href="/user/<%= seller._id %>" class="pdp-btn-secondary" style="padding:10px 20px; border-radius:10px; border:1px solid var(--border); font-weight:700; text-decoration:none; color:var(--text); display:inline-block;">View Profile</a>
          <% if (user && canBuyerAct) { %>
            <button class="pdp-btn-ghost" data-action="report-product" data-product-id="<%= p._id %>" style="margin-left:12px; border:none; background:none; color:var(--text-3); font-size:13px; font-weight:600; cursor:pointer;">Report Product</button>
            <button class="pdp-btn-ghost" data-action="report-seller" data-seller-id="<%= seller._id %>" style="margin-left:12px; border:none; background:none; color:var(--text-3); font-size:13px; font-weight:600; cursor:pointer;">Report Seller</button>
          <% } %>
        </div>
      </div>
    </section>

    <!-- SIMILAR LISTINGS -->
    <% if (typeof relatedProducts !=='undefined' && relatedProducts.length> 0) { %>
      <section class="pdp-similar">
        <h2 class="pdp-similar-title">Similar Products</h2>
        <div class="products-grid">
          <% relatedProducts.forEach(function(rp) { %>
            <div class="product-card" data-action="open-related" data-product-id="<%= rp._id %>">
              <div class="product-img-placeholder">
                <% if (rp.images && rp.images[0]) { %>
                  <img src="<%= rp.images[0] %>" alt="<%= rp.title %>">
                <% } else { %>
                  <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:var(--surface-2); color:var(--primary); opacity:0.3;">
                    <i data-lucide="package" style="width:32px; height:32px;"></i>
                  </div>
                <% } %>
                <div class="product-cta">View details →</div>
              </div>
              <div class="product-body">
                  <div class="product-price"><%= fmtPrice(rp.price) %></div>
                <div class="product-name"><%= rp.title %></div>
                <div class="product-category"><%= CAT_LABEL[rp.category] || rp.category %> · <%= typeof rp.quantity === 'number' ? rp.quantity : 1 %> available</div>
                <div class="product-footer">
                  <div class="product-seller">
                    <div class="seller-avatar" style="display:flex; align-items:center; justify-content:center; background:var(--primary-light); color:var(--primary); font-size:10px; font-weight:700;">
                      <%= (rp.seller && rp.seller.nickname ? rp.seller.nickname[0] : (rp.seller && rp.seller.name ? rp.seller.name[0] : '?')).toUpperCase() %>
                    </div>
                    <span class="seller-name"><%= rp.seller ? (rp.seller.nickname || rp.seller.name) : 'Seller' %></span>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

  </main>

  <!-- Image Modal -->
  <div id="image-modal" class="image-modal" data-action="close-image-modal">
    <div class="image-modal-content">
      <button type="button" class="image-modal-close" data-action="close-image-modal">×</button>
      <div class="image-modal-toolbar">
        <button type="button" class="zoom-btn" id="zoom-out-btn" data-action="zoom-out" title="Zoom out">−</button>
        <span class="zoom-level" id="zoom-level">100%</span>
        <button type="button" class="zoom-btn" id="zoom-in-btn" data-action="zoom-in" title="Zoom in">+</button>
        <button type="button" class="zoom-btn" id="zoom-reset-btn" data-action="zoom-reset" title="Reset">⟲</button>
      </div>
      <div class="image-modal-container" id="image-container">
        <img id="image-modal-img" src="" alt="Expanded product image">
      </div>
    </div>
  </div>

  <!-- Report Modal -->
  <div id="report-modal"
    style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:999;align-items:center;justify-content:center;flex-direction:column;">
    <div
      style="background:#fff;border-radius:16px;padding:24px;max-width:450px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
      <div id="report-modal-title" style="font-size:18px;font-weight:700;margin-bottom:16px;">Report this item</div>
      <div style="color:#666;font-size:14px;margin-bottom:20px;">Help us keep Campus safe by reporting inappropriate content.</div>

      <div style="margin-bottom:16px;">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Reason *</label>
        <select id="report-reason"
          style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;font-size:14px;font-family:inherit;">
          <option value="">Select a reason...</option>
          <option value="inappropriate-content">Inappropriate content</option>
          <option value="offensive-language">Offensive language</option>
          <option value="fraud-scam">Fraud/Scam</option>
          <option value="counterfeit-item">Counterfeit item</option>
          <option value="damaged-item">Damaged/Missing item</option>
          <option value="misleading-description">Misleading description</option>
          <option value="fake-account">Fake account</option>
          <option value="suspicious-behavior">Suspicious behavior</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Description</label>
        <textarea id="report-content" maxlength="500"
          style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px;font-size:14px;font-family:inherit;resize:vertical;min-height:100px;"
          placeholder="Provide details (optional)..."></textarea>
        <div style="font-size:12px;color:#999;margin-top:4px;text-align:right;"><span id="report-char-count">0</span>/500</div>
      </div>

      <div style="display:flex;gap:10px;">
        <button data-action="close-report-modal"
          style="flex:1;padding:11px;border:1px solid #ddd;background:#fff;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.18s;">Cancel</button>
        <button data-action="submit-report"
          style="flex:1;padding:11px;border:none;background:#dc2626;color:#fff;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.18s;">Submit Report</button>
      </div>
    </div>
  </div>

  <script defer src="/js/rating.js"></script>
  <script id="product-page-config" type="application/json"><%- safeJson({
      productId: String(product._id),
      isAuth: !!user,
      isAdmin: !!isAdmin,
      images: product.images || [],
      productMeta: {
        id: String(product._id),
        title: product.title,
        price: fmtPrice(product.price),
        image: (product.images && product.images[0]) || '',
        url: '/products/' + String(product._id)
      },
      mapLat: product.location && product.location.lat ? product.location.lat : null,
      mapLng: product.location && product.location.lng ? product.location.lng : null,
      mapAddress: product.location && product.location.address ? product.location.address : ''
    }) %></script>
  <script defer src="/js/pages/product.js"></script>
</body>

</html>
