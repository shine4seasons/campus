<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: 'products - Campus Marketplace', pageStyles: ['dashboard', 'rating'] }) %>
</head>

<body>
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="content">
          <header class="page-heading">
            <div class="page-heading-copy">
              <h1 class="page-heading-title" id="pageTitle">My Products</h1>
              <p class="page-heading-sub" id="pageSub">Manage your active and sold products</p>
            </div>
          </header>

          <!-- ── SECTION: products ── -->
          <div class="tbl-wrap">
            <div class="tbl-toolbar">
              <div>
                <div class="tbl-title">Inventory</div>
                <div class="tbl-count">20 products total</div>
              </div>
              <div style="display:flex;align-items:center;gap:10px">
                <div class="filter-pills">
                  <button class="f-pill on">All</button>
                  <button class="f-pill">Active</button>
                  <button class="f-pill">Sold</button>
                  <button class="f-pill">Hidden</button>
                </div>
                <button class="btn btn-primary" onclick="window.location.href='/sell'">
                  <svg viewBox="0 0 24 24" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  New product
                </button>
              </div>
            </div>
            <table>
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Stock</th>
                  <th>Views</th>
                  <th>Interest</th>
                  <th>Rating</th>
                  <th>Posted</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="my-products-tbody">
                <tr>
                  <td colspan="10" class="empty">Loading your products...</td>
                </tr>
              </tbody>
            </table>
            <div class="pagination"></div>
          </div>
          </section>

        </div><!-- /.content -->
      </main>

      <div id="toast-wrap"></div>

      <script>window.INITIAL_SECTION = 'sProducts';</script>
      <%- include('partials/dashboard-scripts') %>
        <script>
          let currentFilter = '';
          function createElementSafe(tagName, options = {}) {
            const create = window.AppUtils?.createElement || function (tagName, options = {}) {
              const element = document.createElement(tagName);
              if (options.className) element.className = options.className;
              if (Array.isArray(options.classes) && options.classes.length) {
                element.classList.add(...options.classes.filter(Boolean));
              }
              if (options.text != null) element.textContent = String(options.text);
              if (options.attrs) {
                Object.entries(options.attrs).forEach(([name, value]) => {
                  if (value == null) return;
                  element.setAttribute(name, String(value));
                });
              }
              if (options.dataset) {
                Object.entries(options.dataset).forEach(([name, value]) => {
                  if (value == null) return;
                  element.dataset[name] = String(value);
                });
              }
              if (options.style) {
                Object.assign(element.style, options.style);
              }
              if (options.children) {
                const children = Array.isArray(options.children) ? options.children : [options.children];
                children.flat(Infinity).forEach((child) => {
                  if (child == null || child === false) return;
                  if (child instanceof Node) {
                    element.appendChild(child);
                  } else {
                    element.appendChild(document.createTextNode(String(child)));
                  }
                });
              }
              return element;
            };
            return create(tagName, options);
          }

          function setTableMessage(tbody, message) {
            const row = createElementSafe('tr');
            row.appendChild(createElementSafe('td', {
              className: 'empty',
              attrs: { colspan: '10' },
              text: message
            }));
            tbody.replaceChildren(row);
          }

          function createRatingDisplay(product) {
            const cell = createElementSafe('span', {
              style: { fontSize: '12px', color: 'var(--t2)' }
            });
            if (product.ratingCount > 0) {
              const icon = createElementSafe('i', {
                attrs: { 'data-lucide': 'star' },
                style: {
                  width: '12px',
                  height: '12px',
                  display: 'inline-block',
                  verticalAlign: 'middle',
                  marginRight: '2px',
                  fill: 'currentColor'
                }
              });
              cell.append(icon, document.createTextNode(` ${parseFloat(product.ratingAverage || 0).toFixed(1)} (${product.ratingCount})`));
            } else {
              cell.textContent = 'No ratings';
            }
            return cell;
          }

          function createProductRow(product) {
            const price = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'VND' }).format(product.price || 0);
            const posted = new Date(product.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit' });
            const status = product.status || 'active';
            const badgeClass = status === 'active' ? 'badge-active' : (status === 'sold' ? 'badge-sold' : (status === 'hidden' ? 'badge-hidden' : 'badge-active'));
            const row = createElementSafe('tr');
            const actionWrap = createElementSafe('div', { className: 'tbl-actions' });
            const editBtn = createElementSafe('button', { className: 'act-btn primary', text: 'Edit' });
            editBtn.addEventListener('click', () => {
              window.location = `/sell?id=${product._id}`;
            });
            const toggleBtn = createElementSafe('button', {
              className: 'act-btn danger',
              text: status === 'hidden' ? 'Unhide' : 'Hide'
            });
            toggleBtn.addEventListener('click', () => {
              toggleHide(product._id, status === 'hidden' ? 'active' : 'hidden');
            });
            actionWrap.append(editBtn, toggleBtn);

            [
              createElementSafe('td', { children: [createElementSafe('strong', { text: product.title || '' })] }),
              createElementSafe('td', { style: { color: 'var(--t2)' }, text: product.category || '' }),
              createElementSafe('td', { text: price }),
              createElementSafe('td', { text: typeof product.quantity === 'number' ? product.quantity : 1 }),
              createElementSafe('td', { text: product.views || 0 }),
              createElementSafe('td', { text: product.interested || 0 }),
              createElementSafe('td', { children: [createRatingDisplay(product)] }),
              createElementSafe('td', { style: { color: 'var(--t2)', fontSize: '12px' }, text: posted }),
              createElementSafe('td', { children: [createElementSafe('span', { className: `badge ${badgeClass}`, text: status })] }),
              createElementSafe('td', { children: [actionWrap] })
            ].forEach((cell) => row.appendChild(cell));

            return row;
          }

          async function loadProducts(page = 1) {
            const tbody = document.getElementById('my-products-tbody');
            if (!tbody) return;
            setTableMessage(tbody, 'Loading your products...');

            try {
              const params = new URLSearchParams({ page, limit: 10 });
              if (currentFilter) params.append('status', currentFilter);

              const res = await fetch(`/api/products/my?${params}`, { credentials: 'include' });
              const json = await res.json();

              if (!json.success) {
                setTableMessage(tbody, 'Failed to load products.');
                return;
              }
              const products = json.data || [];
              if (!products.length) {
                setTableMessage(tbody, 'No products found.');
                return;
              }

              tbody.replaceChildren(...products.map(createProductRow));
              if (window.lucide && typeof window.lucide.createIcons === 'function') {
                window.lucide.createIcons();
              }

              if (typeof renderPagination === 'function') {
                renderPagination('.tbl-wrap .pagination', json.pagination, 'loadProducts');
              }

              const countEl = document.querySelector('.tbl-count');
              if (countEl) countEl.textContent = `${json.pagination?.total || products.length} products total`;
            } catch (err) {
              setTableMessage(tbody, 'Failed to load products.');
              console.error('Failed to fetch my products:', err);
            }
          }

          window.toggleHide = async function (productId, newStatus) {
            try {
              const res = await fetch('/api/products/' + encodeURIComponent(productId), {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ status: newStatus })
              });
              const j = await res.json();
              if (j.success) loadProducts();
              else showToast(j.message || 'Failed', 'err');
            } catch (e) { showToast('Failed', 'err'); }
          };

          // Wire up filter pills
          document.querySelectorAll('.filter-pills .f-pill').forEach(pill => {
            pill.addEventListener('click', () => {
              document.querySelectorAll('.filter-pills .f-pill').forEach(p => p.classList.remove('on'));
              pill.classList.add('on');
              const txt = pill.textContent.trim().toLowerCase();
              currentFilter = txt === 'all' ? '' : txt;
              loadProducts(1);
            });
          });

          // Initial load
          document.addEventListener('DOMContentLoaded', () => loadProducts(1));
        </script>
</body>

</html>
