<!DOCTYPE html>
<html lang="en" class="dashboard-shell">
<head>
  <%- include('partials/head', { pageTitle: 'products - Campus Marketplace', pageStyles: ['dashboard', 'rating', 'my-products', 'seller-center'] }) %>
</head>

<body class="dashboard-page seller-workspace">
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="content">
          <header class="page-heading">
            <div class="page-heading-copy">
              <h1 class="page-heading-title" id="pageTitle">My Products</h1>
              <p class="page-heading-sub" id="pageSub">Manage your active and sold products</p>
            </div>
          </header>

          <!-- ── SECTION: products ── -->
          <div class="tbl-wrap my-products-panel">
            <div class="tbl-toolbar">
              <div>
                <div class="tbl-title">Inventory</div>
                <div class="tbl-count">20 products total</div>
              </div>
              <div class="tbl-toolbar-right">
                <div class="filter-pills">
                  <button class="f-pill on">All</button>
                  <button class="f-pill">Active</button>
                  <button class="f-pill">Sold</button>
                  <button class="f-pill">Hidden</button>
                </div>
                <button class="btn btn-primary" data-href="/sell">
                  <svg viewBox="0 0 24 24" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  New product
                </button>
              </div>
            </div>
            <div class="tbl-search">
              <div class="seller-toolbar-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input id="products-search" type="text" placeholder="Search inventory by title or category...">
              </div>
              <div class="seller-toolbar-meta">
                <select id="products-sort" class="seller-sort" aria-label="Sort products">
                  <option value="newest">Newest first</option>
                  <option value="price-desc">Highest price</option>
                  <option value="price-asc">Lowest price</option>
                  <option value="views-desc">Most viewed</option>
                  <option value="interest-desc">Most interested</option>
                </select>
              </div>
            </div>
            <div class="seller-products-grid" id="my-products-grid">
              <div class="seller-products-message">Loading your products...</div>
            </div>
            <div class="pagination"></div>
          </div>

        </div><!-- /.content -->
      </main>

      <div id="toast-wrap"></div>

      <script id="dashboard-page-config" type="application/json">{"initialSection":"sProducts"}</script>
      <%- include('partials/dashboard-scripts') %>
      <script defer src="/js/pages/my-products.js"></script>
</body>

</html>
