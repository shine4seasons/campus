<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: isOwnProfile ? 'My Profile - Campus Marketplace' : (viewingUser.nickname || viewingUser.name) + ' - Campus Marketplace', pageStyles: ['profile', 'rating'] }) %>
</head>

<body class="profile-page">
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <%
        const profileUser=isOwnProfile ? user : viewingUser;
        const isViewingOwn=isOwnProfile;
        function avatarDataUri(name) {
          const label = String(name || '?').trim().charAt(0).toUpperCase() || '?';
          const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" rx="48" fill="#E8F0FE"/><text x="50%" y="56%" text-anchor="middle" font-family="Arial,sans-serif" font-size="40" font-weight="700" fill="#22C55E">${label.replace(/[<&>]/g, '?')}</text></svg>`;
          return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
        }
      %>

        <div class="profile-wrap">
          <div class="profile-page-intro">
            <div class="profile-page-copy">
              <span class="profile-kicker"><%= isViewingOwn ? 'My workspace' : 'Seller profile' %></span>
              <h1><%= isViewingOwn ? (user.nickname || user.name) : (profileUser.nickname || profileUser.name) %></h1>
              <p><%= isViewingOwn ? 'Manage your public identity, trust signals, and store-facing information from one place.' : 'Browse this seller profile, review signals, and active listings.' %></p>
            </div>
            <div class="profile-page-badges">
              <span class="profile-badge"><i data-lucide="star"></i><%= ((profileUser.rating || 5)).toFixed(1) %> rating</span>
              <span class="profile-badge"><i data-lucide="package"></i><%= products.length %> product<%= products.length !== 1 ? 's' : '' %></span>
              <span class="profile-badge"><i data-lucide="message-square-more"></i><%= profileUser.ratingCount || 0 %> reviews</span>
            </div>
          </div>

          <% if (!isViewingOwn) { %>
            <!-- -- PUBLIC PROFILE VIEW -- -->
            <div class="profile-public">
              <!-- User Info Card -->
              <div class="card user-info-card profile-hero-card premium-card glass">
                <div class="user-info-header">
                  <div class="user-avatar-section">
                    <img
                      src="<%= profileUser.avatar || avatarDataUri(profileUser.name) %>"
                      alt="<%= profileUser.name %>" class="user-avatar-lg">
                    <div class="user-info-text">
                      <div class="user-name">
                        <%= profileUser.nickname || profileUser.name %>
                      </div>
                      <div class="user-uni">
                        <i data-lucide="building-2"></i>
                        <%= profileUser.university || 'No university listed' %>
                      </div>
                    </div>
                  </div>
                  <div class="user-stats">
                    <div class="stat-box">
                      <div class="stat-value" style="display:flex;align-items:center;gap:6px;justify-content:center;">
                        <%- renderStars(profileUser.rating || 5, 18) %>
                        <span style="font-size:18px;font-weight:800"><%= (profileUser.rating || 5).toFixed(1) %></span>
                      </div>
                      <div class="stat-label">Rating</div>
                    </div>
                    <div class="stat-box">
                      <div class="stat-value"><%= profileUser.totalSales || 0 %></div>
                      <div class="stat-label">Sales</div>
                    </div>
                    <div class="stat-box">
                      <div class="stat-value"><%= profileUser.ratingCount || 0 %></div>
                      <div class="stat-label">Reviews</div>
                    </div>
                  </div>
                </div>
                <div class="profile-hero-footer">
                  <% if (profileUser.bio) { %>
                    <div class="user-bio">
                      <%= profileUser.bio %>
                    </div>
                  <% } %>
                  <% if (user && !isViewingOwn) { %>
                    <button class="btn-report-profile" data-action="show-report-modal" data-target-type="user" data-target-id="<%= profileUser._id %>">
                      <i data-lucide="flag"></i> Report this profile
                    </button>
                  <% } %>
                </div>
              </div>

              <!-- User Rating Section -->
              <div class="card section-card">
                <div class="section-card-head">
                  <div>
                    <div class="section-card-title">User Reviews</div>
                    <div class="section-card-sub">Feedback from completed transactions and community interactions.</div>
                  </div>
                </div>
                <div id="user-rating-stats-content">No reviews</div>
                <div id="user-rating-dist-content" style="margin-top: 16px;"></div>
                <label class="rating-search" for="user-reviews-search">
                  <i data-lucide="search"></i>
                  <input id="user-reviews-search" type="search" data-rating-search="user-reviews-list" placeholder="Search reviews..." autocomplete="off">
                </label>
                <div id="user-reviews-list" style="margin-top: 20px;"></div>
              </div>

              <!-- Products Grid -->
              <div class="products-section">
                <div class="section-header">
                  <h2><i data-lucide="shopping-bag"
                      style="width:18px;height:18px;display:inline-block;vertical-align:middle;margin-right:6px;"></i>Products
                  </h2>
                  <span class="product-count">
                    <%= products.length %> item<%= products.length !==1 ? 's' : '' %>
                  </span>
                </div>
                <label class="profile-products-search" for="profile-products-search">
                  <i data-lucide="search"></i>
                  <input id="profile-products-search" type="search" placeholder="Search products on this profile..." autocomplete="off">
                </label>

                <% if (products && products.length> 0) { %>
                  <div class="products-grid" id="profile-products-grid">
                    <% const CAT_ICON={ books: 'book-open' , electronics: 'monitor' , clothing: 'shirt' ,
                      furniture: 'sofa' , 'daily-needs' :'shopping-bag', sports: 'dumbbell' , gaming: 'gamepad-2' ,
                      other: 'package' , }; %>
                      <% products.forEach(function(p) { %>
                        <a href="/products/<%= p._id %>" class="product-card" data-profile-product data-search-text="<%= [
                          p.title || '',
                          p.category || '',
                          p.status || '',
                          String(p.price || '')
                        ].join(' ').toLowerCase() %>">
                          <div class="product-image">
                            <% if (p.images && p.images[0]) { %>
                              <img src="<%= p.images[0] %>" alt="<%= p.title %>">
                              <% } else { %>
                                <div class="product-image-placeholder">
                                  <i data-lucide="<%= CAT_ICON[p.category] || 'package' %>"></i>
                                </div>
                                <% } %>
                          </div>
                          <div class="product-info">
                            <div class="product-title">
                              <%= p.title %>
                            </div>
                            <div class="product-price">
                              <%= formatVND(p.price) %>
                            </div>
                            <% if (p.status==='sold' ) { %>
                              <span class="product-status sold">Sold</span>
                              <% } %>
                          </div>
                        </a>
                        <% }) %>
                  </div>
                  <% } else { %>
                    <div class="empty-state">
                      <i data-lucide="inbox" style="width:48px;height:48px;color:#B0B6CC;"></i>
                      <p>This user has no active Products</p>
                    </div>
                    <% } %>
              </div>
            </div>

            <% } else { %>
              <!-- -- OWN PROFILE VIEW -- -->
              <div class="profile-grid profile-grid-own">

              <!-- -- LEFT: Avatar + Stats + Recent products -- -->
              <div class="profile-side-stack">
                <!-- Avatar card -->
                <div class="card avatar-card profile-hero-card premium-card glass">
                  <div class="avatar-wrap" id="avatar-wrap">
                    <img
                      src="<%= user.avatar || avatarDataUri(user.name) %>"
                      alt="<%= user.name %>" class="avatar-img" id="avatar-img">
                    <label class="avatar-change-btn" for="avatar-upload-input" title="Change avatar">
                      <i data-lucide="camera"></i>
                    </label>
                    <input type="file" id="avatar-upload-input" style="display:none" accept="image/*">
                  </div>
                  <div class="avatar-name">
                    <%= user.nickname || user.name %>
                  </div>
                  <div class="avatar-email">
                    <%= user.email %>
                  </div>
                  <div class="avatar-meta-row">
                    <span class="avatar-meta-pill"><i data-lucide="building-2"></i><%= user.university || 'University not set' %></span>
                    <% if (user.studentId) { %>
                      <span class="avatar-meta-pill"><i data-lucide="id-card"></i><%= user.studentId %></span>
                    <% } %>
                  </div>

                  <div class="stats-mini">
                    <div class="stat-mini">
                      <div class="stat-mini-num" style="display:flex;align-items:center;gap:4px;justify-content:center;">
                        <%- renderStars(user.rating || 5, 14) %>
                        <span style="font-size:14px;font-weight:700"><%= (user.rating || 5).toFixed(1) %></span>
                      </div>
                      <div class="stat-mini-lbl">Rating</div>
                    </div>
                    <div class="stat-mini">
                      <div class="stat-mini-num"><%= user.totalSales || 0 %></div>
                      <div class="stat-mini-lbl">Sold</div>
                    </div>
                    <div class="stat-mini">
                      <div class="stat-mini-num"><%= user.ratingCount || 0 %></div>
                      <div class="stat-mini-lbl">Reviews</div>
                    </div>
                  </div>
                </div>


                <!-- Recent products -->
                <div class="card section-card premium-card glass">
                  <div class="section-card-head">
                    <div>
                      <div class="section-card-title">My Products</div>
                      <div class="section-card-sub">A quick snapshot of your most recent listings.</div>
                    </div>
                  </div>
                  <% if (products && products.length> 0) { %>
                    <div class="recent-products">
                      <% const CAT_ICON={ books: 'book-open' , electronics: 'monitor' , clothing: 'shirt' ,
                        furniture: 'sofa' , 'daily-needs' :'shopping-bag', sports: 'dumbbell' , gaming: 'gamepad-2' ,
                        other: 'package' , }; %>
                        <% products.slice(0, 4).forEach(function(p) { %>
                          <a href="/products/<%= p._id %>" class="mini-row">
                            <div class="mini-thumb">
                              <% if (p.images && p.images[0]) { %>
                                <img src="<%= p.images[0] %>" alt="<%= p.title %>">
                              <% } else { %>
                                <i data-lucide="<%= CAT_ICON[p.category] || 'package' %>"></i>
                              <% } %>
                            </div>
                            <div class="mini-body">
                              <div class="mini-title"><%= p.title %></div>
                              <div class="mini-meta">
                                <span class="status-dot dot-<%= p.status %>"></span>
                                <%= p.status==='active' ? 'Active' : p.status==='sold' ? 'Sold' : 'Draft' %>
                                <span class="meta-sep">Â·</span>
                                <i data-lucide="eye"></i> <%= p.views || 0 %>
                              </div>
                            </div>
                            <div class="mini-price">
                              <%= formatVND(p.price) %>
                            </div>
                          </a>
                          <% }) %>
                    </div>
                    <% if (products.length> 4) { %>
                      <a href="/my-products" class="see-all">
                        See all <%= products.length %> Products
                          <i data-lucide="arrow-right"
                            style="width:14px;height:14px;display:inline-block;vertical-align:middle;margin-left:3px;"></i>
                      </a>
                      <% } %>
                        <% } else { %>
                          <div class="empty-mini">
                            No Products yet.<br>
                            <a href="/sell" style="color:#16A34A;font-weight:700;">
                              Post your first item
                              <i data-lucide="arrow-right"
                                style="width:15px;height:15px;display:inline-block;vertical-align:middle;"></i>
                            </a>
                          </div>
                          <% } %>
                </div>

              </div>

                <div class="card form-section section-card premium-card glass">
                  <div class="section-card-head section-card-head-spacious">
                    <div>
                      <div class="section-card-title">Edit Profile</div>
                      <div class="section-card-sub">Manage your public seller identity and personal details.</div>
                    </div>
                  </div>

                <!-- Read-only: from Google -->
                <div class="form-row">
                  <div class="form-group">
                    <label>Full name <span style="color:#B0B6CC;font-weight:400;">(from Google)</span></label>
                    <input type="text" value="<%= user.name %>" class="readonly" readonly>
                  </div>
                  <div class="form-group">
                    <label>Email <span style="color:#B0B6CC;font-weight:400;">(from Google)</span></label>
                    <input type="text" value="<%= user.email %>" class="readonly" readonly>
                  </div>
                </div>

                <!-- Editable -->
                <div class="form-row">
                  <div class="form-group">
                    <label>Display name *</label>
                    <input type="text" id="f-nickname" value="<%= user.nickname || '' %>"
                      placeholder="E.g.: Alex Johnson" maxlength="40">
                    <div class="form-hint">Name shown to other users</div>
                  </div>
                  <div class="form-group">
                    <label>Phone number</label>
                    <input type="tel" id="f-phone" value="<%= user.phone || '' %>" placeholder="(555) 123-4567"
                      maxlength="15">
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label>University / College *</label>
                    <input type="text" id="f-university" value="<%= user.university || '' %>" placeholder="E.g.: MIT"
                      maxlength="80">
                  </div>
                  <div class="form-group">
                    <label>Student ID</label>
                    <input type="text" id="f-student-id" value="<%= user.studentId || '' %>" placeholder="20210001"
                      maxlength="20">
                    <div class="form-hint">Optional — helps verify you're a student</div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Short bio</label>
                  <textarea id="f-bio" rows="3" maxlength="200"
                    placeholder="E.g.: 3rd-year CS student, buying/selling books and electronics..."><%= user.bio || '' %></textarea>
                  <div class="form-hint" id="bio-count">
                    <%= (user.bio || '' ).length %> / 200
                  </div>
                </div>

                <div style="display:flex;align-items:center;gap:12px;padding-top:4px;">
                  <button class="btn-save" id="btn-save" data-action="save-profile">

                    Save changes
                  </button>
                  <span id="save-status" style="font-size:15px;color:#8890B0;"></span>
                </div>
              </div>

              </div><!-- /.profile-grid-own -->

        </div>
        <% } %>
          </div>

          <div id="toast-wrap"></div>

          <!-- Report Modal -->
          <div id="report-modal" class="profile-report-modal"
            style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:999;align-items:center;justify-content:center;flex-direction:column;">
            <div class="profile-report-dialog"
              style="background:#fff;border-radius:16px;padding:24px;max-width:480px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
              <div class="profile-report-title" style="font-size:20px;font-weight:800;margin-bottom:16px;">Report this profile</div>
              <div class="profile-report-subtitle" style="color:#666;font-size:16px;margin-bottom:20px;">Help us keep Campus safe by reporting
                inappropriate content.</div>

              <div class="profile-report-field" style="margin-bottom:16px;">
                <label class="profile-report-label" style="display:block;font-size:15px;font-weight:600;margin-bottom:6px;">Reason *</label>
                <select id="report-reason" class="report-reason-select">
                  <option value="">Select a reason...</option>
                  <option value="inappropriate-content">Inappropriate content</option>
                  <option value="offensive-language">Offensive language</option>
                  <option value="fraud-scam">Fraud/Scam</option>
                  <option value="counterfeit-item">Counterfeit item</option>
                  <option value="damaged-item">Damaged/Missing item</option>
                  <option value="misleading-description">Misleading description</option>
                  <option value="fake-account">Fake account</option>
                  <option value="suspicious-behavior">Suspicious behavior</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="profile-report-field" style="margin-bottom:20px;">
                <label class="profile-report-label" style="display:block;font-size:15px;font-weight:600;margin-bottom:6px;">Description</label>
                <textarea id="report-content" class="profile-report-textarea" maxlength="500"
                  style="width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;font-size:16px;font-family:inherit;resize:vertical;min-height:120px;"
                  placeholder="Provide details (optional)..."></textarea>
                <div class="profile-report-count" style="font-size:14px;color:#999;margin-top:4px;text-align:right;"><span
                    id="report-char-count">0</span>/500</div>
              </div>

              <div class="profile-report-actions" style="display:flex;gap:12px;">
                <button class="profile-report-btn profile-report-btn-cancel" data-action="close-report-modal"
                  style="flex:1;padding:12px;border:1px solid #ddd;background:#fff;border-radius:10px;font-size:16px;font-weight:600;cursor:pointer;transition:all 0.18s;">Cancel</button>
                <button class="profile-report-btn profile-report-btn-submit" data-action="submit-report"
                  style="flex:1;padding:12px;border:none;background:#dc2626;color:#fff;border-radius:10px;font-size:16px;font-weight:600;cursor:pointer;transition:all 0.18s;">Submit
                  Report</button>
              </div>
            </div>
          </div>

          <%
            function safeJson(value) {
              return JSON.stringify(value)
                .replace(/</g, '\\u003c')
                .replace(/>/g, '\\u003e')
                .replace(/&/g, '\\u0026')
                .replace(/\u2028/g, '\\u2028')
                .replace(/\u2029/g, '\\u2029');
            }
          %>
          <script id="profile-page-config" type="application/json"><%- safeJson({
              isOwnProfile: !!isOwnProfile,
              isViewingOwn: !!isViewingOwn,
              viewingUserId: String(profileUser._id)
            }) %></script>
          <script defer src="/js/rating.js"></script>
          <script defer src="/js/pages/profile.js"></script>
</body>

</html>
