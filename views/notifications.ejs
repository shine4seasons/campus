<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: title, pageStyles: ['notifications-page'] }) %>
</head>
<body>
  <%- include('partials/navbar') %>
  <%- include('partials/sidebar') %>

  <main class="notif-page">
    <header class="notif-header">
      <div>
        <h1 class="notif-title">
          Notifications
          <span class="notif-count-badge" id="notif-count-badge"></span>
        </h1>
        <p class="notif-sub">Stay updated with orders, messages, and reviews</p>
      </div>
      <button class="notif-mark-all" id="mark-all-btn" disabled>
        Mark all as read
      </button>
    </header>

    <div class="notif-tabs" id="notif-tabs">
      <button class="notif-tab active" data-filter="all">All</button>
      <button class="notif-tab" data-filter="unread">
        Unread <span class="notif-tab-badge" id="tab-unread-count">0</span>
      </button>
      <button class="notif-tab" data-filter="order">Orders</button>
      <button class="notif-tab" data-filter="message">Messages</button>
      <button class="notif-tab" data-filter="rating">Reviews</button>
      <button class="notif-tab" data-filter="system">System</button>
    </div>

    <div class="notif-list-wrap">
      <div class="notif-list" id="notif-page-list">
        <div style="padding:40px;text-align:center;color:#8890B0;">Loading…</div>
      </div>
      <div class="notif-load-more-wrap" id="load-more-wrap" style="display:none;">
        <button class="notif-load-more-btn" id="load-more-btn">Load more ▾</button>
      </div>
    </div>
  </main>

  <div id="notif-toast" class="notif-toast"></div>

    <script defer src="/js/pages/notifications.js"></script>
</body>
</html>
