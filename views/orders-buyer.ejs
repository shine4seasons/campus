<!DOCTYPE html>
<html lang="en" class="dashboard-shell">
<head>
  <%- include('partials/head', { pageTitle: 'My Orders - Campus Marketplace', pageStyles: ['dashboard', 'orders', 'orders-buyer-page'] }) %>
</head>
<body class="dashboard-page">
<%- include('partials/navbar') %>
<%- include('partials/sidebar') %>

<main class="main">
  <div class="content">
    <div class="orders-page-heading">
      <h1 class="orders-page-title">My Orders</h1>
      <p class="orders-page-subtitle">Track and manage your purchases</p>
    </div>

    <!-- Status counters -->
    <div class="status-counters">
      <div class="status-count-card">
        <div class="sc-label">Pending</div>
        <div class="sc-val sc-val-amber"><%= typeof statusCounts !== 'undefined' ? statusCounts.pending : 0 %></div>
      </div>
      <div class="status-count-card">
        <div class="sc-label">Confirmed</div>
        <div class="sc-val sc-val-primary"><%= typeof statusCounts !== 'undefined' ? statusCounts.confirmed : 0 %></div>
      </div>
      <div class="status-count-card">
        <div class="sc-label">Completed</div>
        <div class="sc-val sc-val-green"><%= typeof statusCounts !== 'undefined' ? statusCounts.completed : 0 %></div>
      </div>
      <div class="status-count-card">
        <div class="sc-label">Cancelled</div>
        <div class="sc-val sc-val-red"><%= typeof statusCounts !== 'undefined' ? statusCounts.cancelled : 0 %></div>
      </div>
    </div>

    <!-- Filter pills -->
    <div class="filter-pills" id="filterPills">
      <button class="f-pill on" data-status="all">All Orders</button>
      <button class="f-pill" data-status="pending">Pending</button>
      <button class="f-pill" data-status="confirmed">Confirmed</button>
      <button class="f-pill" data-status="completed">Completed</button>
      <button class="f-pill" data-status="cancelled">Cancelled</button>
    </div>

    <div class="orders-list-wrap">
      <% if (!orders || !orders.length) { %>
        <div class="card empty-state">
          <i data-lucide="package" class="empty-state-icon"></i>
          <h3 class="empty-state-title">No orders yet</h3>
          <p class="empty-state-sub">Discover great deals and place your first order.</p>
          <a href="/" class="btn-track empty-state-browse">Browse products</a>
        </div>
      <% } else { %>
        <div id="ordersList">
          <% orders.forEach(function(order){ %>
            <div class="order-card" data-order-id="<%= order._id %>" data-status="<%= order.status %>">
              <div class="order-card-image-wrap">
                <% if (order.product && order.product.images && order.product.images.length) { %>
                  <img src="<%= order.product.images[0] %>" alt="Product" class="order-card-image" />
                <% } else { %>
                  <div class="order-placeholder">P</div>
                <% } %>
              </div>
              
              <div class="order-grid">
                <!-- Group 1: Product -->
                <div>
                  <div class="order-col-header">Product Info</div>
                  <a href="/products/<%= order.product?._id %>" class="order-title"><%= order.product?.title || 'Untitled Product' %></a>
                  <div class="order-id">#<%= String(order._id).substring(0, 8).toUpperCase() %></div>
                  <div class="order-meta-text order-meta-date">
                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </div>
                </div>

                <!-- Group 2: Seller -->
                <div>
                  <div class="order-col-header">Seller</div>
                  <div class="order-seller-info">
                    <div class="order-seller-avatar">
                      <% if (order.seller?.avatar) { %>
                        <img src="<%= order.seller.avatar %>" alt="Avatar" class="order-seller-avatar-img">
                      <% } else { %>
                        <div class="order-seller-avatar-fallback">
                          <%= (order.seller?.name || 'S')[0].toUpperCase() %>
                        </div>
                      <% } %>
                    </div>
                    <div class="order-seller-name"><%= order.seller?.nickname || order.seller?.name || 'Unknown' %></div>
                  </div>
                  <div class="order-seller-rating">
                    <i data-lucide="star" class="order-seller-rating-icon"></i>
                    <span class="order-seller-rating-value"><%= (order.seller?.rating || 5).toFixed(1) %></span>
                  </div>
                </div>

                <!-- Group 3: Transaction -->
                <div>
                  <div class="order-col-header">Transaction</div>
                  <div class="order-price">
                    <%= formatVND(order.priceSnapshot || order.product?.price || 0) %>
                  </div>
                  <div class="order-meta-text">
                    <span class="order-meta-dim">qty</span> <%= order.quantity || 1 %>
                  </div>
                  <div class="order-meta-text">
                    <span class="order-meta-dim">via</span> <%= order.paymentMode === 'qr' ? 'QR Transfer' : (order.paymentMode === 'card' ? 'Card' : 'Cash') %>
                  </div>
                  <div class="order-meta-text order-delivery-mode">
                    <%= order.deliveryMode === 'ship' ? 'ðŸšš Shipping' : 'ðŸ“ Pickup' %>
                  </div>
                </div>

                <!-- Group 4: Actions -->
                <div class="order-actions">
                  <div class="order-col-header">Status</div>
                  <div class="order-status-wrap">
                    <span class="badge <%= 'badge-' + (order.status || 'pending') %>"><%= order.status %></span>
                  </div>
                  <a href="/orders/tracking/<%= order._id %>" class="btn-track">Track Order</a>
                  <% if (order.status === 'pending') { %>
                    <button class="btn-cancel" data-action="cancel-order" data-order-id="<%= order._id %>">Cancel Order</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script defer src="/js/pages/orders-buyer.js"></script>
</body>
</html>

