<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: 'My Orders - Campus Marketplace', pageStyles: ['dashboard', 'orders'] }) %>
  <style>
    .order-card {
      display: flex;
      gap: 24px;
      padding: 24px;
      border: 1px solid var(--border);
      border-top: 4px solid var(--border);
      border-radius: var(--radius-lg);
      margin-bottom: 20px;
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .order-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    .order-card[data-status="pending"] { border-top-color: var(--amber); }
    .order-card[data-status="confirmed"] { border-top-color: var(--primary); }
    .order-card[data-status="completed"] { border-top-color: var(--green); }
    .order-card[data-status="cancelled"] { border-top-color: var(--red); }
    .order-card-image-wrap {
      width: 120px;
      height: 120px;
      border-radius: var(--radius-md);
      overflow: hidden;
      flex-shrink: 0;
      border: 1px solid var(--border);
      background: var(--surface-2);
    }
    .order-card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .order-grid {
      display: grid;
      grid-template-columns: 1fr 180px 180px 140px;
      gap: 24px;
      flex: 1;
      min-width: 0;
    }
    @media (max-width: 1200px) {
      .order-grid {
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }
    }
    @media (max-width: 768px) {
      .order-grid {
        grid-template-columns: 1fr;
      }
    }

    .order-col-header {
      font-size: var(--fs-xs);
      font-weight: 800;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }
    .order-title {
      font-weight: 800;
      font-size: var(--fs-base);
      color: var(--text);
      margin-bottom: 6px;
      line-height: 1.4;
      display: block;
      text-decoration: none;
    }
    .order-title:hover {
      color: var(--primary);
    }
    .order-id {
      font-family: 'DM Mono', monospace;
      font-size: var(--fs-xs);
      color: var(--text-3);
      font-weight: 500;
    }
    .order-meta-text {
      font-size: var(--fs-sm);
      font-weight: 600;
      color: var(--text-2);
      margin-top: 4px;
    }

    .order-seller-info {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 4px;
    }
    .order-seller-avatar {
      width: 24px;
      height: 24px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: var(--surface-2);
      border: 1px solid var(--border);
    }
    .order-seller-name {
      font-size: var(--fs-sm);
      font-weight: 700;
      color: var(--text-2);
    }

    .order-price {
      font-size: var(--fs-lg);
      font-weight: 800;
      color: var(--primary);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      line-height: 1;
      background: var(--surface-2);
      color: var(--text-2);
      border: 1px solid var(--border);
    }
    .badge-pending {
      background: #FFF7ED; color: #D97706; border: 1px solid rgba(217, 119, 6, 0.12);
    }
    .badge-confirmed {
      background: #EFF6FF; color: #2563EB; border: 1px solid rgba(37, 99, 235, 0.12);
    }
    .badge-completed {
      background: #ECFDF5; color: #059669; border: 1px solid rgba(5, 150, 105, 0.12);
    }
    .badge-cancelled {
      background: #FEF2F2; color: #DC2626; border: 1px solid rgba(220, 38, 38, 0.12);
    }

    .order-actions {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .btn-track {
      background: var(--primary);
      color: #fff;
      padding: 10px;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: var(--fs-xs);
      text-align: center;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-track:hover {
      background: var(--primary-dark);
      box-shadow: 0 4px 12px rgba(29, 106, 229, 0.2);
    }
    .btn-cancel {
      background: var(--surface-2);
      color: var(--text-2);
      padding: 8px;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: var(--fs-xs);
      border: 1px solid var(--border);
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-cancel:hover {
      background: var(--red-light);
      color: var(--red);
      border-color: var(--red);
    }

    .status-counters {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }
    .status-count-card {
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      transition: all 0.25s ease;
      text-align: left;
    }
    .status-count-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    .sc-label {
      font-size: var(--fs-xs);
      font-weight: 800;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 6px;
    }
    .sc-val {
      font-size: var(--fs-3xl);
      font-weight: 800;
      line-height: 1.1;
    }

    .filter-pills {
      display: flex;
      gap: 8px;
      margin-top: 16px;
      flex-wrap: wrap;
    }
    .f-pill {
      padding: 8px 18px;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 999px;
      font-size: var(--fs-xs);
      font-weight: 700;
      cursor: pointer;
      color: var(--text-2);
      transition: all 0.2s;
    }
    .f-pill:hover {
      border-color: var(--primary);
      color: var(--primary);
    }
    .f-pill.on {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
      box-shadow: 0 4px 12px rgba(29, 106, 229, 0.25);
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
    }
  </style>
</head>
<body>
<%- include('partials/navbar') %>
<%- include('partials/sidebar') %>

<main class="main">
  <div class="content">
    <div style="margin-bottom: 32px">
      <h1 style="font-size: 32px; font-weight: 900; color: var(--t1); letter-spacing: -0.03em; margin-bottom: 8px">My Orders</h1>
      <p style="color: var(--t3); font-size: 15px; font-weight: 500;">Track and manage your purchases</p>
    </div>

    <!-- Status counters -->
    <div class="status-counters">
      <div class="status-count-card">
        <div class="sc-label">Pending</div>
        <div class="sc-val" style="color: var(--amber);"><%= typeof statusCounts !== 'undefined' ? statusCounts.pending : 0 %></div>
      </div>
      <div class="status-count-card">
        <div class="sc-label">Confirmed</div>
        <div class="sc-val" style="color: var(--primary);"><%= typeof statusCounts !== 'undefined' ? statusCounts.confirmed : 0 %></div>
      </div>
      <div class="status-count-card">
        <div class="sc-label">Completed</div>
        <div class="sc-val" style="color: var(--green);"><%= typeof statusCounts !== 'undefined' ? statusCounts.completed : 0 %></div>
      </div>
      <div class="status-count-card">
        <div class="sc-label">Cancelled</div>
        <div class="sc-val" style="color: var(--red);"><%= typeof statusCounts !== 'undefined' ? statusCounts.cancelled : 0 %></div>
      </div>
    </div>

    <!-- Filter pills -->
    <div class="filter-pills" id="filterPills">
      <button class="f-pill on" data-status="all">All Orders</button>
      <button class="f-pill" data-status="pending">Pending</button>
      <button class="f-pill" data-status="confirmed">Confirmed</button>
      <button class="f-pill" data-status="completed">Completed</button>
      <button class="f-pill" data-status="cancelled">Cancelled</button>
    </div>

    <div style="margin-top: 32px">
      <% if (!orders || !orders.length) { %>
        <div class="card empty-state">
          <i data-lucide="package" style="width:64px;height:64px;margin:0 auto 20px;stroke:var(--t3);opacity:0.5;"></i>
          <h3 style="font-size:20px;font-weight:800;margin-bottom:8px;">No orders yet</h3>
          <p style="color:var(--t3);margin-bottom:24px;">Discover great deals and place your first order.</p>
          <a href="/" class="btn-track" style="display:inline-flex; padding: 12px 24px;">Browse products</a>
        </div>
      <% } else { %>
        <div id="ordersList">
          <% orders.forEach(function(order){ %>
            <div class="order-card" data-order-id="<%= order._id %>" data-status="<%= order.status %>">
              <div class="order-card-image-wrap">
                <% if (order.product && order.product.images && order.product.images.length) { %>
                  <img src="<%= order.product.images[0] %>" alt="Product" class="order-card-image" />
                <% } else { %>
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--bg2);color:var(--t3);font-weight:800;font-size:24px;">P</div>
                <% } %>
              </div>
              
              <div class="order-grid">
                <!-- Group 1: Product -->
                <div>
                  <div class="order-col-header">Product Info</div>
                  <a href="/products/<%= order.product?._id %>" class="order-title"><%= order.product?.title || 'Untitled Product' %></a>
                  <div class="order-id">#<%= String(order._id).substring(0, 8).toUpperCase() %></div>
                  <div class="order-meta-text" style="color:var(--t3); margin-top:8px;">
                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </div>
                </div>

                <!-- Group 2: Seller -->
                <div>
                  <div class="order-col-header">Seller</div>
                  <div class="order-seller-info">
                    <div class="order-seller-avatar">
                      <% if (order.seller?.avatar) { %>
                        <img src="<%= order.seller.avatar %>" alt="Avatar" style="width:100%; height:100%; object-fit:cover;">
                      <% } else { %>
                        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:800; background:var(--primary-light); color:var(--primary);">
                          <%= (order.seller?.name || 'S')[0].toUpperCase() %>
                        </div>
                      <% } %>
                    </div>
                    <div class="order-seller-name"><%= order.seller?.nickname || order.seller?.name || 'Unknown' %></div>
                  </div>
                  <div style="display:flex; align-items:center; gap:6px; margin-top:8px; color:#fbbf24;">
                    <i data-lucide="star" style="width:14px; height:14px; fill:currentColor;"></i>
                    <span style="font-size:13px; font-weight:800; color:var(--t2);"><%= (order.seller?.rating || 5).toFixed(1) %></span>
                  </div>
                </div>

                <!-- Group 3: Transaction -->
                <div>
                  <div class="order-col-header">Transaction</div>
                  <div class="order-price">
                    <%= formatVND(order.priceSnapshot || order.product?.price || 0) %>
                  </div>
                  <div class="order-meta-text">
                    <span style="opacity:0.6;font-weight:500;">qty</span> <%= order.quantity || 1 %>
                  </div>
                  <div class="order-meta-text">
                    <span style="opacity:0.6;font-weight:500;">via</span> <%= order.paymentMode === 'qr' ? 'QR Transfer' : (order.paymentMode === 'card' ? 'Card' : 'Cash') %>
                  </div>
                  <div class="order-meta-text" style="color:var(--success); margin-top:4px;">
                    <%= order.deliveryMode === 'ship' ? '🚚 Shipping' : '📍 Pickup' %>
                  </div>
                </div>

                <!-- Group 4: Actions -->
                <div class="order-actions">
                  <div class="order-col-header">Status</div>
                  <div style="margin-bottom:12px;">
                    <span class="badge <%= 'badge-' + (order.status || 'pending') %>"><%= order.status %></span>
                  </div>
                  <a href="/orders/tracking/<%= order._id %>" class="btn-track">Track Order</a>
                  <% if (order.status === 'pending') { %>
                    <button class="btn-cancel" data-action="cancel-order" data-order-id="<%= order._id %>">Cancel Order</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script defer src="/js/pages/orders-buyer.js"></script>
</body>
</html>
