<!DOCTYPE html>
<html lang="en" class="dashboard-shell">
<head>
  <%- include('partials/head', { pageTitle: 'Orders - Campus Marketplace', pageStyles: ['dashboard', 'orders'] }) %>
</head>
<body class="dashboard-page">
<%- include('partials/navbar') %>
<%- include('partials/sidebar') %>

<main class="main">
  <div class="content">
    <header class="page-heading">
      <div class="page-heading-copy">
        <h1 class="page-heading-title" id="pageTitle">Seller Orders</h1>
        <p class="page-heading-sub" id="pageSub">Manage buyer orders & fulfillment</p>
      </div>
    </header>

    <!-- ── SECTION: Orders ── -->
      <%
        const statusCounts = { pending: 0, confirmed: 0, completed: 0, cancelled: 0 };
        if (typeof orders !== 'undefined' && orders) {
          orders.forEach(function(o) {
            statusCounts[o.status] = (statusCounts[o.status] || 0) + 1;
          });
        }
      %>
      <div class="status-counters">
        <div class="status-count-card">
          <div class="sc-label">Pending</div>
          <div class="sc-val" style="color: var(--amber);"><%= statusCounts.pending %></div>
        </div>
        <div class="status-count-card">
          <div class="sc-label">Confirmed</div>
          <div class="sc-val" style="color: var(--primary);"><%= statusCounts.confirmed %></div>
        </div>
        <div class="status-count-card">
          <div class="sc-label">Completed</div>
          <div class="sc-val" style="color: var(--green);"><%= statusCounts.completed %></div>
        </div>
        <div class="status-count-card">
          <div class="sc-label">Cancelled</div>
          <div class="sc-val" style="color: var(--red);"><%= statusCounts.cancelled %></div>
        </div>
      </div>
      <!-- Products that have orders (owned by the current seller) -->
      <% if (typeof productsWithCounts !== 'undefined' && productsWithCounts && productsWithCounts.length) { %>
        <div class="card" style="margin:12px 0 18px;padding:12px 16px">
          <div class="card-head" style="margin-bottom:8px">
            <div>
              <div class="card-title">Products with orders</div>
              <div class="card-sub">Your products that have been ordered</div>
            </div>
          </div>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <% productsWithCounts.forEach(function(item){ %>
              <a href="/products/<%=item.product._id%>" class="quick-card" style="width:240px;text-decoration:none;color:inherit">
                <div style="display:flex;gap:12px;align-items:center">
                  <div class="li-avatar" style="width:48px;height:48px;border-radius:8px;background:#f3f4f6;color:#475569;flex-shrink:0;display:flex;align-items:center;justify-content:center">
                    <% if (item.product.images && item.product.images.length) { %>
                      <img src="<%=item.product.images[0]%>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:6px"/>
                    <% } else { %>
                      <div style="font-weight:700;font-size:13px">P</div>
                    <% } %>
                  </div>
                  <div style="flex:1;min-width:0">
                    <div style="font-weight:700;color:var(--t1);font-size:13px"><%=item.product.title%></div>
                    <div style="font-size:12px;color:var(--t2);margin-top:6px"><%=item.count%> orders</div>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>
      <div class="tbl-wrap">
        <div class="tbl-toolbar">
          <div><div class="tbl-title">Orders received</div><div class="tbl-count">30 total orders</div></div>
          <div class="filter-pills">
            <button class="f-pill on">All</button>
            <button class="f-pill">Needs action</button>
            <button class="f-pill">In progress</button>
            <button class="f-pill">Completed</button>
          </div>
        </div>
        <table>
          <thead>
            <tr><th>Order ID</th><th>Product</th><th>Buyer</th><th>Qty</th><th>Price</th><th>Delivery</th><th>Payment</th><th>Note</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody id="ordersTableBody">
            <tr><td colspan="10" class="empty">Loading orders...</td></tr>
          </tbody>
        </table>
        <div class="pagination"></div>
      </div>


  </div><!-- /.content -->
</main>

<div id="toast-wrap"></div>

<script>window.INITIAL_SECTION = 'sOrders';</script>
<script defer src="/js/pages/orders-seller.js"></script>

<%- include('partials/dashboard-scripts') %>
</body>
</html>
