<!DOCTYPE html>
<html lang="en" class="dashboard-shell messages-shell">
<head>
  <%- include('partials/head', { pageTitle: title, pageStyles: ['dashboard', 'messages', 'seller-center'] }) %>
</head>
<body class="dashboard-page messages-page <%= user && user.role === 'seller' ? 'seller-workspace seller-messages-view' : 'buyer-workspace' %>">
  <%- include('partials/navbar') %>
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="content">
      <div class="chat-container">
    <section class="chat-sidebar" id="inbox-panel">
      <div class="messages-inbox-head">
        <div class="messages-inbox-title-row">
          <div>
            <h1>Messages</h1>
            <span id="mode-label"></span>
          </div>
          <button type="button" class="chat-icon-btn" id="new-message-btn" title="New message" aria-label="New message">
            <i data-lucide="square-pen"></i>
          </button>
        </div>
        <label class="messages-search" for="conversation-search">
          <i data-lucide="search"></i>
          <input id="conversation-search" type="search" placeholder="Search conversations..." autocomplete="off">
        </label>
      </div>

      <div class="messages-filters" id="conversation-filters" aria-label="Conversation filters">
        <button type="button" class="messages-filter active" data-filter="all">All</button>
        <button type="button" class="messages-filter" data-filter="unread">Unread</button>
        <button type="button" class="messages-filter" data-filter="orders">Orders</button>
        <button type="button" class="messages-filter" data-filter="support">Support</button>
      </div>

      <div class="conv-list" id="conv-list">
        <!-- Rendered by JS -->
      </div>
    </section>

    <section class="chat-main" id="conversation-panel">
      <div class="chat-empty" id="chat-empty">
        <i data-lucide="message-circle"></i>
        <p>Select a conversation to start messaging</p>
      </div>

      <div class="chat-header" id="chat-header">
        <div class="chat-header-person">
          <button type="button" class="chat-icon-btn chat-back-btn" id="chat-back-btn" title="Back to inbox" aria-label="Back to inbox">
            <i data-lucide="arrow-left"></i>
          </button>
          <a class="conv-avatar" id="header-avatar" href="#" aria-label="Open profile"></a>
          <div>
            <a class="chat-partner-name" id="header-name" href="#"></a>
            <div class="chat-partner-status"><span></span> Online</div>
          </div>
        </div>
        <div class="chat-header-actions">
          <a class="chat-icon-btn" id="chat-profile-link" href="#" title="View profile" aria-label="View profile">
            <i data-lucide="user-round"></i>
          </a>
          <button type="button" class="chat-icon-btn" id="chat-search-toggle" title="Search in conversation" aria-label="Search in conversation">
            <i data-lucide="search"></i>
          </button>
          <div class="chat-more-wrap">
            <button type="button" class="chat-icon-btn" id="chat-more-btn" title="More options" aria-label="More options" aria-expanded="false">
              <i data-lucide="more-vertical"></i>
            </button>
            <div class="chat-more-menu" id="chat-more-menu" hidden>
              <button type="button" data-chat-action="refresh"><i data-lucide="refresh-cw"></i>Refresh conversation</button>
              <button type="button" data-chat-action="scroll-bottom"><i data-lucide="arrow-down"></i>Jump to latest</button>
            </div>
          </div>
        </div>
      </div>

      <div class="chat-search-panel" id="chat-search-panel" hidden>
        <label class="messages-search" for="message-search">
          <i data-lucide="search"></i>
          <input id="message-search" type="search" placeholder="Search in this conversation..." autocomplete="off">
        </label>
      </div>

      <div class="chat-messages" id="chat-messages" style="display:none;">
        <!-- Rendered by JS -->
      </div>

      <!-- Loading skeleton (shown on initial conversation load) -->
      <div class="chat-skeleton" id="chat-skeleton" style="display:none;">
        <div class="skeleton-bubble other"></div>
        <div class="skeleton-bubble me"></div>
        <div class="skeleton-bubble other short"></div>
        <div class="skeleton-bubble me"></div>
      </div>

      <!-- Product context banner (shown when coming from a product page or stored) -->
      <div class="product-banner" id="product-banner" style="display:none;"></div>

      <div class="image-preview" id="image-preview" style="display:none;">
        <img id="image-preview-img" src="" alt="Preview">
        <button type="button" class="image-preview-remove" id="image-preview-remove" title="Remove">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="image-preview-overlay" id="image-preview-overlay" style="display:none;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" style="animation:spin 0.7s linear infinite;"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
        </div>
      </div>

      <div class="chat-input-area" id="chat-input-area">
        <input type="file" id="chat-image-input" accept="image/*" style="display:none;">
        <button type="button" class="chat-attach-btn" id="chat-attach-btn" title="Attach image">
          <i data-lucide="paperclip"></i>
        </button>
        <textarea id="chat-input" class="chat-input" placeholder="Type a message..." rows="1" autocomplete="off"></textarea>
        <button type="button" class="chat-emoji-btn" id="chat-emoji-btn" title="Insert emoji" aria-label="Insert emoji">
          <i data-lucide="smile"></i>
        </button>
        <button type="button" class="chat-send-btn" id="chat-send-btn" data-action="send-message">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 2 11 13"></path>
            <path d="m22 2-7 20-4-9-9-4 20-7z"></path>
          </svg>
        </button>
      </div>
    </section>
  </div>
  </div>
</main>

  <%
    function safeJson(value) {
      return JSON.stringify(value)
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/&/g, '\\u0026')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029');
    }
  %>
  <script defer src="/socket.io/socket.io.js"></script>
  <script id="messages-page-config" type="application/json"><%- safeJson({
      myUserId: String(user._id),
      currentConvId: conversationId || '',
      userRole: user && user.role ? user.role : 'buyer'
    }) %></script>
  <script defer src="/js/pages/messages.js"></script>
</body>
</html>
