<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/messages.css">
  <style>
    /* ── Product context banner ── */
    .product-banner {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      background: #F0F4FF;
      border-top: 1px solid #D6E0FF;
      border-bottom: 1px solid #D6E0FF;
      flex-shrink: 0;
      animation: bannerSlideIn 0.25s ease;
    }
    @keyframes bannerSlideIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .product-banner-img {
      width: 44px;
      height: 44px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid #C5D2FF;
      flex-shrink: 0;
      background: #E4E7F2;
    }
    .product-banner-img-placeholder {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      border: 1px solid #C5D2FF;
      flex-shrink: 0;
      background: #E4E7F2;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .product-banner-info { flex: 1; min-width: 0; }
    .product-banner-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: #1B5EFF;
      margin-bottom: 2px;
    }
    .product-banner-title {
      font-weight: 700;
      font-size: 13px;
      color: #0D0F1A;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .product-banner-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 2px;
    }
    .product-banner-price {
      font-weight: 800;
      color: #1B5EFF;
      font-size: 13px;
    }
    .product-banner-cond {
      font-size: 11px;
      color: #6B7399;
      background: #E8EDFF;
      border-radius: 4px;
      padding: 1px 6px;
    }
    /* ── Date divider ── */
    .date-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 18px 0 10px;
      padding: 0 4px;
    }
    .date-divider::before,
    .date-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #E4E7F2;
    }
    .date-divider-label {
      font-size: 11px;
      font-weight: 600;
      color: #8890B0;
      white-space: nowrap;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    /* Skeleton loader */
    .chat-skeleton {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 20px;
      overflow: hidden;
    }
    .skeleton-bubble {
      height: 38px;
      border-radius: 18px;
      background: linear-gradient(90deg, #EEF1F8 0%, #F5F7FB 50%, #EEF1F8 100%);
      background-size: 200% 100%;
      animation: skeletonShimmer 1.4s ease-in-out infinite;
      max-width: 60%;
    }
    .skeleton-bubble.short { max-width: 35%; }
    .skeleton-bubble.me { align-self: flex-end; max-width: 50%; }
    .skeleton-bubble.other { align-self: flex-start; }
    @keyframes skeletonShimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    /* Toast */
    .chat-toast {
      position: fixed; bottom: 24px; left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: #0D0F1A; color: #fff;
      padding: 12px 20px; border-radius: 12px;
      font-size: 14px; font-weight: 600;
      box-shadow: 0 8px 24px rgba(0,0,0,0.18);
      opacity: 0; pointer-events: none;
      transition: all .25s ease; z-index: 9999;
    }
    .chat-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .chat-toast[data-type="error"] { background: #E5484D; }
    .chat-toast[data-type="success"] { background: #34C759; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="chat-container">
    <!-- SIDEBAR (Inbox) -->
    <div class="chat-sidebar">
      <div class="sidebar-header">Inbox <span id="mode-label" style="font-weight:700;margin-left:8px;color:#1B5EFF;font-size:12px;"></span></div>
      <div class="conv-list" id="conv-list">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- MAIN CHAT -->
    <div class="chat-main">
      <div class="chat-empty" id="chat-empty">
        <svg width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        <p>Select a conversation to start messaging</p>
      </div>

      <div class="chat-header" id="chat-header">
        <div class="conv-avatar" id="header-avatar" style="width:40px;height:40px;font-size:16px;"></div>
        <div>
          <div class="chat-partner-name" id="header-name"></div>
          <div class="chat-partner-status">Active now</div>
        </div>
      </div>

      <div class="chat-messages" id="chat-messages" style="display:none;">
        <!-- Rendered by JS -->
      </div>

      <!-- Loading skeleton (shown on initial conversation load) -->
      <div class="chat-skeleton" id="chat-skeleton" style="display:none;">
        <div class="skeleton-bubble other"></div>
        <div class="skeleton-bubble me"></div>
        <div class="skeleton-bubble other short"></div>
        <div class="skeleton-bubble me"></div>
      </div>

      <!-- Product context banner (shown when coming from a product page or stored) -->
      <div class="product-banner" id="product-banner" style="display:none;"></div>

      <div class="image-preview" id="image-preview" style="display:none;">
        <img id="image-preview-img" src="" alt="Preview">
        <button type="button" class="image-preview-remove" id="image-preview-remove" title="Remove">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="image-preview-overlay" id="image-preview-overlay" style="display:none;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" style="animation:spin 0.7s linear infinite;"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
        </div>
      </div>

      <div class="chat-input-area" id="chat-input-area">
        <input type="file" id="chat-image-input" accept="image/*" style="display:none;">
        <button type="button" class="chat-attach-btn" id="chat-attach-btn" title="Attach image" onclick="document.getElementById('chat-image-input').click()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <input type="text" id="chat-input" class="chat-input" placeholder="Type a message..." autocomplete="off">
        <button class="chat-send-btn" id="chat-send-btn" onclick="sendMessage()">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left:-2px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
      // socket.io client will be loaded dynamically below
      const MY_USER_ID = '<%= String(user._id) %>';
      let currentConvId = '<%= conversationId || "" %>';
      let pollInterval = null;
      let autoScroll = true;
      const socket = io ? io() : null;
      let joinedConv = null;

      if (socket) {
        socket.on('connect', () => {
          // connection ready
        });

        socket.on('message', (msg) => {
          try {
            // msg.conversationId may be ObjectId or string
            const convId = msg.conversationId ? String(msg.conversationId) : null;
            if (convId && convId === currentConvId) {
              // refresh current messages
              fetchMessages();
            }
            // update inbox for new message
            fetchInbox();
          } catch (e) { console.error('socket message handler error', e); }
        });
      }

    // ── Product Banner ──────────────────────────────────────────────────────
    const COND_LABEL = { new:'New', 'like-new':'Like new', good:'Good', fair:'Fair' };

    function renderProductBanner(convId, productData) {
      const banner = document.getElementById('product-banner');
      if (!banner || !productData) return;
      // Persist to localStorage so banner shows on reload / direct link
      try { localStorage.setItem('conv_product_' + convId, JSON.stringify(productData)); } catch(e) {}

      const priceStr = new Intl.NumberFormat('en-US', { style:'currency', currency:'VND' }).format(productData.price);
      const condLabel = COND_LABEL[productData.condition] || productData.condition || '';
      const imgHtml = productData.image
        ? `<img class="product-banner-img" src="${productData.image}" alt="">`
        : `<div class="product-banner-img-placeholder"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73L13 3l-7 3.27A2 2 0 0 0 5 8v8a2 2 0 0 0 1 1.73L11 21l7-3.27A2 2 0 0 0 21 16z"/><path d="M12 3v10"/></svg></div>`;

      banner.innerHTML = `
        ${imgHtml}
        <div class="product-banner-info">
          <div class="product-banner-label">Discussing product</div>
          <div class="product-banner-title">${productData.title || ''}</div>
          <div class="product-banner-meta">
            <span class="product-banner-price">${priceStr}</span>
            ${condLabel ? `<span class="product-banner-cond">${condLabel}</span>` : ''}
          </div>
        </div>
      `;
      banner.style.display = 'flex';
    }

    function tryLoadBannerFromStorage(convId) {
      try {
        const raw = localStorage.getItem('conv_product_' + convId);
        if (raw) renderProductBanner(convId, JSON.parse(raw));
        else document.getElementById('product-banner').style.display = 'none';
      } catch(e) {}
    }

    // On page load: parse ?pd= param if present
    (function parsePdParam() {
      const params = new URLSearchParams(window.location.search);
      const pdRaw  = params.get('pd');
      if (pdRaw && currentConvId) {
        try {
          const productData = JSON.parse(decodeURIComponent(pdRaw));
          renderProductBanner(currentConvId, productData);
        } catch(e) {}
        // Strip ?pd= from URL
        const clean = new URL(window.location.href);
        clean.searchParams.delete('pd');
        window.history.replaceState(null, '', clean.toString());
      }
    })();

    // ── Date divider helpers ────────────────────────────────────────────────
    /**
     * Returns a smart date label for a chat date divider.
     * - Same day as today   → "Today"
     * - Yesterday           → "Yesterday"
     * - Same year & month   → "Monday 15"  (weekday + day)
     * - Same year           → "March 15"   (month + day)
     * - Older               → "March 15, 2023"
     */
    function formatDateLabel(dateStr) {
      const now = new Date();
      const d   = new Date(dateStr);

      const nowY = now.getFullYear(), nowM = now.getMonth(), nowD = now.getDate();
      const dY   = d.getFullYear(),   dM   = d.getMonth(),   dD   = d.getDate();

      if (dY === nowY && dM === nowM && dD === nowD) return 'Today';

      const yest = new Date(now);
      yest.setDate(yest.getDate() - 1);
      if (dY === yest.getFullYear() && dM === yest.getMonth() && dD === yest.getDate()) return 'Yesterday';

      if (dY === nowY && dM === nowM) {
        // Same year, same month → show weekday + numeric day
        return d.toLocaleDateString('en-US', { weekday: 'long' }) + ' ' + dD;
      }

      if (dY === nowY) {
        // Same year, different month → show "March 15"
        return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
      }

      // Different year → full date
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    }

    /** Returns "YYYY-MM-DD" string for grouping messages by calendar day */
    function dayKey(dateStr) {
      const d = new Date(dateStr);
      return d.getFullYear() + '-' + d.getMonth() + '-' + d.getDate();
    }

    // ── Inbox ───────────────────────────────────────────────────────────────
    async function fetchInbox() {
      try {
        const res = await fetch('/api/chat', { credentials: 'include' });
        const json = await res.json();
        if (json.success) renderInbox(json.data);
      } catch (err) { console.error('Error fetching inbox:', err); }
    }

    // Escape HTML for safe interpolation
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderInbox(convs) {
      const list = document.getElementById('conv-list');
      // Filter conversations according to current UI mode (buyer/seller)
      const uiMode = (localStorage.getItem('campus_mode') || 'buyer');
      document.getElementById('mode-label').textContent = uiMode === 'seller' ? 'Seller view' : 'Buyer view';

      if (convs.length === 0) {
        list.innerHTML = '<div style="padding:20px;text-align:center;color:#8890B0;font-size:14px;">No messages yet.</div>';
        return;
      }

      // Apply mode filter: sellers see conversations where they are the product seller;
      // buyers see conversations where they are the buyer (i.e., not the product seller).
      const filtered = convs.filter(c => {
        if (uiMode === 'seller') return c.isSellerConversation;
        return !c.isSellerConversation;
      });

      if (filtered.length === 0) {
        list.innerHTML = '<div style="padding:20px;text-align:center;color:#8890B0;font-size:14px;">No messages for current mode.</div>';
        return;
      }

      list.innerHTML = filtered.map(c => {
        const partner = c.partner || (c.participants ? c.participants.find(p => String(p._id) !== MY_USER_ID) : null) || { name: 'Unknown', nickname: '' };
        const name = partner.nickname || partner.name || 'Unknown';
        const initial = (name && name.charAt) ? name.charAt(0).toUpperCase() : '?';
        const activeClass = c._id === currentConvId ? 'active' : '';
        const unreadHtml = c.unreadCount > 0 ? `<div class="unread-badge">${esc(c.unreadCount)}</div>` : '';
        const prodName = c.product ? c.product.title : 'Deleted Product';

        // Use data attributes — safe with apostrophes/quotes — handled by delegation
        return `
          <div class="conv-item ${activeClass}" data-conv-id="${esc(c._id)}" data-conv-name="${esc(name)}">
            <div class="conv-avatar" style="background:linear-gradient(135deg,#667eea,#764ba2);">${esc(initial)}</div>
            <div class="conv-info">
              <div style="display:flex;align-items:center;">
                <div class="conv-name">${esc(name)}</div>
                ${unreadHtml}
              </div>
              <div class="conv-product"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-right:6px;vertical-align:middle;display:inline-block"><path d="M21 16V8a2 2 0 0 0-1-1.73L13 3l-7 3.27A2 2 0 0 0 5 8v8a2 2 0 0 0 1 1.73L11 21l7-3.27A2 2 0 0 0 21 16z"/><path d="M12 3v10"/></svg> ${esc(prodName)}</div>
              <div class="conv-lastmsg">${esc(c.lastMessage || '...')}</div>
            </div>
          </div>
        `;
      }).join('');

      // NOTE: auto-select on initial load is handled ONCE in init block below.
      // This function intentionally does NOT auto-click on subsequent polls.
    }

    // Click delegation — handles dynamic .conv-item without inline onclick
    document.getElementById('conv-list').addEventListener('click', function (e) {
      const item = e.target.closest('.conv-item');
      if (!item) return;
      const convId = item.dataset.convId;
      const convName = item.dataset.convName || 'User';
      if (convId) selectConversation(convId, convName);
    });

    window.selectConversation = async function(convId, partnerName) {
      currentConvId = convId;
        // join socket room
        if (socket) {
          if (joinedConv && joinedConv !== convId) socket.emit('leaveConv', joinedConv);
          socket.emit('joinConv', convId);
          joinedConv = convId;
        }
      tryLoadBannerFromStorage(convId);
      document.getElementById('chat-empty').style.display = 'none';
      document.getElementById('chat-header').classList.add('active');
      document.getElementById('chat-messages').style.display = 'flex';
      document.getElementById('chat-input-area').classList.add('active');
      document.getElementById('header-name').textContent = partnerName;
      document.getElementById('header-avatar').textContent = partnerName.charAt(0).toUpperCase();
      document.getElementById('chat-input').focus();

      autoScroll = true;
      isInitialFetch = true;
      await fetchMessages();
      fetchInbox();

      window.history.replaceState(null, '', '/messages?id=' + convId);
    };

    // ── Messages ────────────────────────────────────────────────────────────
    let isInitialFetch = true;
    let pollFailures = 0;
    async function fetchMessages() {
      if (!currentConvId) return;
      const skel = document.getElementById('chat-skeleton');
      const cont = document.getElementById('chat-messages');
      if (isInitialFetch && skel && cont) {
        skel.style.display = 'flex';
        cont.style.display = 'none';
      }
      try {
        const res = await fetch('/api/chat/' + currentConvId + '/messages', { credentials: 'include' });
        const json = await res.json();
        if (json.success) renderMessages(json.data);
        // On success: reset failure counter and restore fast polling if it was slowed
        if (pollFailures > 0) {
          pollFailures = 0;
          if (pollSlowed) restartFastPolling();
        }
      } catch (err) {
        console.error('Error fetching messages:', err);
        pollFailures++;
        if (pollFailures >= 3 && pollInterval && !pollSlowed) {
          clearInterval(pollInterval);
          pollInterval = setInterval(pollTick, 10000);
          pollSlowed = true;
          showChatToast('Connection unstable — slowing refresh', 'error');
        }
      } finally {
        if (isInitialFetch && skel && cont) {
          skel.style.display = 'none';
          cont.style.display = 'flex';
          isInitialFetch = false;
        }
      }
    }

    function showChatToast(message, type = 'error') {
      let toast = document.getElementById('chat-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'chat-toast';
        toast.className = 'chat-toast';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.dataset.type = type;
      toast.classList.add('show');
      clearTimeout(toast._t);
      toast._t = setTimeout(() => toast.classList.remove('show'), 3000);
    }

    function renderMessages(messages) {
      const container   = document.getElementById('chat-messages');
      const shouldScroll = autoScroll || (container.scrollTop + container.clientHeight >= container.scrollHeight - 50);

      let lastDayKey = null;
      let html = '';

      messages.forEach(m => {
        const isMe  = String(m.sender._id) === MY_USER_ID;
        const time  = new Date(m.createdAt).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
        const msgDay = dayKey(m.createdAt);

        // Insert date divider when the calendar day changes
        if (msgDay !== lastDayKey) {
          lastDayKey = msgDay;
          const label = formatDateLabel(m.createdAt);
          html += `
            <div class="date-divider">
              <span class="date-divider-label">${label}</span>
            </div>
          `;
        }

        const safeText = (m.text || '').replace(/</g, "&lt;").replace(/>/g, "&gt;");
        const imageHtml = m.imageUrl
          ? `<img class="message-image" src="${m.imageUrl}" alt="Image" onclick="window.open('${m.imageUrl}','_blank')">`
          : '';
        const textHtml = safeText
          ? `<div class="message-bubble">${safeText}</div>`
          : '';

        html += `
          <div class="message-row ${isMe ? 'me' : 'other'}">
            ${imageHtml}
            ${textHtml}
            <div class="message-time">${time}</div>
          </div>
        `;
      });

      container.innerHTML = html;

      if (shouldScroll) {
        container.scrollTop = container.scrollHeight;
        autoScroll = false;
      }
    }

    // ── Image attachment ────────────────────────────────────────────────────
    let pendingImageFile = null;

    const imageInput = document.getElementById('chat-image-input');
    const previewBox = document.getElementById('image-preview');
    const previewImg = document.getElementById('image-preview-img');
    const previewRemove = document.getElementById('image-preview-remove');

    imageInput.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        showChatToast('Please select an image file');
        imageInput.value = '';
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        showChatToast('Image must be under 5MB');
        imageInput.value = '';
        return;
      }
      pendingImageFile = file;
      previewImg.src = URL.createObjectURL(file);
      previewBox.style.display = 'flex';
    });

    previewRemove.addEventListener('click', () => {
      pendingImageFile = null;
      previewBox.style.display = 'none';
      imageInput.value = '';
      previewImg.src = '';
    });

    async function uploadChatImage(file) {
      const fd = new FormData();
      fd.append('image', file);
      const res = await fetch('/api/upload/chat', { method: 'POST', body: fd, credentials: 'include' });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success || !json.url) {
        throw new Error(json.message || 'Upload failed');
      }
      return json.url;
    }

    // ── Send ────────────────────────────────────────────────────────────────
    window.sendMessage = async function() {
      const input = document.getElementById('chat-input');
      const text  = input.value.trim();
      const btn   = document.getElementById('chat-send-btn');
      const overlay = document.getElementById('image-preview-overlay');

      if (!currentConvId) return;
      if (!text && !pendingImageFile) return;

      input.disabled = true;
      btn.disabled   = true;
      const originalIcon = btn.innerHTML;
      btn.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="animation:spin 0.7s linear infinite;"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>';

      try {
        let imageUrl = null;
        if (pendingImageFile) {
          if (overlay) overlay.style.display = 'flex';
          imageUrl = await uploadChatImage(pendingImageFile);
        }

        const res = await fetch('/api/chat/' + currentConvId + '/messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text, imageUrl }),
          credentials: 'include'
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          input.value = '';
          pendingImageFile = null;
          previewBox.style.display = 'none';
          imageInput.value = '';
          previewImg.src = '';
          autoScroll  = true;
          await fetchMessages();
          fetchInbox();
        } else {
          showChatToast(json.message || 'Failed to send message');
        }
      } catch (err) {
        console.error('Error sending message:', err);
        showChatToast(err.message || 'Network error — message not sent');
      } finally {
        if (overlay) overlay.style.display = 'none';
        btn.innerHTML  = originalIcon;
        input.disabled = false;
        btn.disabled   = false;
        input.focus();
      }
    };

    document.getElementById('chat-input').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendMessage();
    });

    // ── Init ────────────────────────────────────────────────────────────────
    let pollSlowed = false;
    let initialAutoSelectDone = false;

    function pollTick() {
      fetchInbox();
      if (currentConvId) {
        const container = document.getElementById('chat-messages');
        if (container && container.scrollTop + container.clientHeight >= container.scrollHeight - 50) {
          autoScroll = true;
        }
        fetchMessages();
      }
    }

    function startPolling(intervalMs) {
      stopPolling();
      pollInterval = setInterval(pollTick, intervalMs || 5000);
    }
    function stopPolling() {
      if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
    }
    function restartFastPolling() {
      pollSlowed = false;
      // Only restart polling if socket is currently disconnected
      if (!socket || !socket.connected) startPolling(5000);
    }

    // Initial inbox load + one-time auto-select if URL has ?id=...
    (async function initialLoad() {
      await fetchInbox();
      if (currentConvId && !initialAutoSelectDone) {
        initialAutoSelectDone = true;
        const convItem = document.querySelector(`.conv-item[data-conv-id="${currentConvId}"]`);
        if (convItem) convItem.click();
      }
    })();

    // Polling is FALLBACK only — start it if socket isn't ready, stop on connect
    if (socket) {
      socket.on('connect',    () => { stopPolling(); pollSlowed = false; pollFailures = 0; });
      socket.on('disconnect', () => { startPolling(5000); });
      // If socket hasn't connected within 2s, start polling as backup
      setTimeout(() => { if (!socket.connected) startPolling(5000); }, 2000);
    } else {
      // No socket support at all → polling is the only source of updates
      startPolling(3000);
    }

    // Pause polling when tab is hidden — saves bandwidth
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopPolling();
      } else if (!socket || !socket.connected) {
        startPolling(5000);
      }
    });

  </script>
</body>
</html>
