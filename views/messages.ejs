<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: title, pageStyles: ['dashboard', 'messages'] }) %>
</head>
<body>
  <%- include('partials/navbar') %>
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="content" style="padding: 0; overflow: hidden;">
      <div class="chat-container" style="margin: 0; min-height: 500px; width: 100%; height: calc(100vh - 62px);">
    <!-- SIDEBAR (Inbox) -->
    <div class="chat-sidebar">
      <div class="sidebar-header">Inbox <span id="mode-label" style="font-weight:700;margin-left:8px;color:#1B5EFF;font-size:12px;"></span></div>
      <div class="conv-list" id="conv-list">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- MAIN CHAT -->
    <div class="chat-main">
      <div class="chat-empty" id="chat-empty">
        <svg width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        <p>Select a conversation to start messaging</p>
      </div>

      <div class="chat-header" id="chat-header">
        <div class="conv-avatar" id="header-avatar" style="width:40px;height:40px;font-size:16px;"></div>
        <div>
          <div class="chat-partner-name" id="header-name"></div>
          <div class="chat-partner-status">Active now</div>
        </div>
      </div>

      <div class="chat-messages" id="chat-messages" style="display:none;">
        <!-- Rendered by JS -->
      </div>

      <!-- Loading skeleton (shown on initial conversation load) -->
      <div class="chat-skeleton" id="chat-skeleton" style="display:none;">
        <div class="skeleton-bubble other"></div>
        <div class="skeleton-bubble me"></div>
        <div class="skeleton-bubble other short"></div>
        <div class="skeleton-bubble me"></div>
      </div>

      <!-- Product context banner (shown when coming from a product page or stored) -->
      <div class="product-banner" id="product-banner" style="display:none;"></div>

      <div class="image-preview" id="image-preview" style="display:none;">
        <img id="image-preview-img" src="" alt="Preview">
        <button type="button" class="image-preview-remove" id="image-preview-remove" title="Remove">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="image-preview-overlay" id="image-preview-overlay" style="display:none;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" style="animation:spin 0.7s linear infinite;"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
        </div>
      </div>

      <div class="chat-input-area" id="chat-input-area">
        <input type="file" id="chat-image-input" accept="image/*" style="display:none;">
        <button type="button" class="chat-attach-btn" id="chat-attach-btn" title="Attach image">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <input type="text" id="chat-input" class="chat-input" placeholder="Type a message..." autocomplete="off">
        <button class="chat-send-btn" id="chat-send-btn">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left:-2px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>
  </div>
  </div>
</main>

  <%
    function safeJson(value) {
      return JSON.stringify(value)
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/&/g, '\\u0026')
        .replace(/\u2028/g, '\\u2028')
        .replace(/\u2029/g, '\\u2029');
    }
  %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    window.MESSAGES_PAGE_CONFIG = <%- safeJson({
      myUserId: String(user._id),
      currentConvId: conversationId || '',
      userRole: user && user.role ? user.role : 'buyer'
    }) %>;
  </script>
  <script defer src="/js/pages/messages.js"></script>
</body>
</html>
