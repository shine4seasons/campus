<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=DM+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/shared.css">
  <link rel="stylesheet" href="/css/main.css">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    .payment-container {
      max-width: 600px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .payment-card {
      background: #fff;
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 12px 40px rgba(13, 15, 26, 0.08);
      text-align: center;
    }

    .payment-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    .status-pending {
      background: #FFF9E6;
      color: #D97706;
    }

    .status-paid {
      background: #E6FFFA;
      color: #059669;
    }

    .qr-frame {
      width: 280px;
      height: 280px;
      margin: 0 auto 32px;
      padding: 20px;
      background: #fff;
      border: 2px solid #F0F1F8;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .qr-frame img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .amount-box {
      margin-bottom: 32px;
    }

    .amount-label {
      font-size: 14px;
      color: #8890B0;
      margin-bottom: 4px;
    }

    .amount-value {
      font-size: 32px;
      font-weight: 900;
      color: var(--primary);
      letter-spacing: -0.02em;
    }

    .transfer-details {
      background: var(--surface-2);
      border-radius: 16px;
      padding: 20px;
      text-align: left;
      margin-bottom: 32px;
      border: 1px solid var(--border);
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .detail-row:last-child {
      margin-bottom: 0;
    }

    .detail-label {
      font-size: 13px;
      color: var(--text-3);
    }

    .detail-value {
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .copy-btn {
      background: none;
      border: none;
      color: var(--primary);
      cursor: pointer;
      padding: 4px;
      border-radius: 4px;
      transition: background 0.2s;
    }

    .copy-btn:hover {
      background: var(--accent-lt);
    }

    .warning-box {
      background: #FEF2F2;
      border: 1px solid rgba(220, 38, 38, 0.12);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 32px;
      display: flex;
      gap: 12px;
      text-align: left;
    }

    .warning-icon {
      color: #DC2626;
      flex-shrink: 0;
    }

    .warning-text {
      font-size: 13px;
      color: #DC2626;
      line-height: 1.5;
    }

    .warning-text strong {
      display: block;
      margin-bottom: 2px;
    }

    .countdown {
      font-size: 14px;
      color: var(--text-3);
      margin-top: 16px;
    }

    .countdown strong {
      color: #DC2626;
    }

    @keyframes pulse {
      0% {
        opacity: 1;
      }

      50% {
        opacity: 0.5;
      }

      100% {
        opacity: 1;
      }
    }

    .polling-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #8890B0;
      font-size: 13px;
      margin-top: 32px;
    }

    .dot {
      width: 8px;
      height: 8px;
      background: #34C759;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    .paid-overlay {
      position: fixed;
      inset: 0;
      background: rgba(13, 15, 26, 0.62);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 16px;
      backdrop-filter: blur(6px);
    }

    .paid-overlay.show {
      display: flex;
    }

    .paid-card {
      position: relative;
      width: 100%;
      max-width: 430px;
      background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
      border: 1px solid #dfe6fb;
      border-radius: 22px;
      padding: 28px 24px 20px;
      box-shadow: 0 30px 70px rgba(13, 15, 26, 0.26);
      text-align: center;
      overflow: hidden;
    }

    .paid-card::before {
      content: "";
      position: absolute;
      left: -24%;
      right: -24%;
      top: -52px;
      height: 130px;
      background: radial-gradient(60% 100% at 50% 0%, rgba(27, 94, 255, 0.22) 0%, rgba(27, 94, 255, 0) 100%);
      pointer-events: none;
    }

    .paid-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto 14px;
      border-radius: 999px;
      border: 1px solid #d4e2ff;
      background: linear-gradient(145deg, #ecf2ff, #f7faff);
      color: #1b5eff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: inset 0 -8px 14px rgba(27, 94, 255, 0.1);
    }

    .paid-title {
      font-size: 28px;
      line-height: 1.15;
      font-weight: 900;
      color: #0d0f1a;
      margin-bottom: 8px;
      letter-spacing: 0;
    }

    .paid-sub {
      font-size: 14px;
      color: #5e6789;
      line-height: 1.55;
      margin: 0 auto 14px;
      max-width: 340px;
    }

    .paid-countdown {
      font-size: 13px;
      font-weight: 600;
      color: #5f6788;
      margin-bottom: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid #dde5fb;
      background: #f2f6ff;
    }

    .paid-actions {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 10px;
    }

    .paid-btn {
      border: 0;
      border-radius: 12px;
      padding: 11px 12px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .paid-btn-home {
      background: #f4f6fc;
      color: #445074;
      border: 1px solid #d8deef;
    }

    .paid-btn-track {
      background: linear-gradient(135deg, #1b5eff, #5b8aff);
      color: #fff;
      box-shadow: 0 8px 18px rgba(27, 94, 255, 0.3);
      font-weight: 800;
    }

    @media (max-width: 420px) {
      .paid-card {
        border-radius: 18px;
        padding: 24px 18px 16px;
      }

      .paid-icon {
        width: 62px;
        height: 62px;
        margin-bottom: 12px;
      }

      .paid-title {
        font-size: 22px;
      }

      .paid-sub {
        font-size: 13px;
        margin-bottom: 12px;
      }

      .paid-actions {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="payment-container">
          <div class="payment-card">
            <div class="payment-status-badge status-pending" id="payment-status-badge">
              <i data-lucide="loader-2" class="spin" style="width: 16px; height: 16px;"></i>
              Waiting for payment
            </div>

            <h1 style="font-size: 24px; font-weight: 800; margin-bottom: 8px;">Scan to Pay</h1>
            <p style="color: #8890B0; font-size: 15px; margin-bottom: 32px;">Please transfer the exact amount using any banking app. We use SePay for automatic verification.</p>

            <div class="qr-frame">
              <img src="<%= qrUrl %>" alt="SePay Payment QR Code">
            </div>

            <div class="amount-box">
              <div class="amount-label">Total Amount</div>
              <% if (payment.order && payment.order.quantity) { %>
                <div class="amount-label">Quantity: <%= payment.order.quantity %></div>
              <% } %>
              <div class="amount-value">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency' , currency: 'VND' }).format(payment.amount) %>
              </div>
            </div>

            <div class="transfer-details">
              <div class="detail-row">
                <span class="detail-label">Bank</span>
                <span class="detail-value">
                  <%= platformBank.bankName %>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Account Number</span>
                <span class="detail-value">
                  <%= platformBank.accountNumber %>
                    <button class="copy-btn" onclick="copyToClipboard('<%= platformBank.accountNumber %>')"
                      title="Copy">
                      <i data-lucide="copy" style="width: 14px; height: 14px;"></i>
                    </button>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Account Name</span>
                <span class="detail-value">
                  <%= platformBank.accountName %>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Transfer Content</span>
                <span class="detail-value" style="color: var(--primary); font-family: 'JetBrains Mono', monospace;">
                  <%= payment.paymentCode %>
                    <button class="copy-btn" onclick="copyToClipboard('<%= payment.paymentCode %>')" title="Copy">
                      <i data-lucide="copy" style="width: 14px; height: 14px;"></i>
                    </button>
                </span>
              </div>
            </div>


            <div class="countdown" id="countdown-text">
              Session expires in <strong id="timer">15:00</strong>
            </div>

            <div class="polling-indicator">
              <div class="dot"></div>
              Checking payment status...
            </div>


          </div>
        </div>
      </main>

      <div class="paid-overlay" id="paid-overlay">
        <div class="paid-card">
          <div class="paid-icon">
            <i data-lucide="check-check" style="width: 30px; height: 30px;"></i>
          </div>
          <div class="paid-title">Payment Successful</div>
          <div class="paid-sub">Your order is now paid. You can track shipping progress anytime.</div>
          <div class="paid-countdown" id="paid-countdown">Auto return home in 5s</div>
          <div class="paid-actions">
            <button type="button" class="paid-btn paid-btn-home" onclick="goHomeAfterPaid()">Back to home</button>
            <button type="button" class="paid-btn paid-btn-track" onclick="goTrackAfterPaid()">Track order</button>
          </div>
        </div>
      </div>

      <script>
        const PAYMENT_ID = '<%= payment._id %>';
        const EXPIRED_AT = new Date('<%= payment.expiredAt %>').getTime();
        const TRACKING_URL = '/orders/tracking/<%= payment.order._id %>';
        const IS_ALREADY_PAID = <%= isAlreadyPaid ? 'true' : 'false' %>;
        let paidCountdownTimer = null;
        let paidRedirectTimer = null;
        let paidOverlayShown = false;

        function updateTimer() {
          const now = new Date().getTime();
          const diff = EXPIRED_AT - now;

          if (diff <= 0) {
            document.getElementById('timer').textContent = "00:00";
            document.getElementById('countdown-text').innerHTML = "Payment session <strong>Expired</strong>. Please try again.";
            return;
          }

          const mins = Math.floor(diff / 60000);
          const secs = Math.floor((diff % 60000) / 1000);
          document.getElementById('timer').textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        setInterval(updateTimer, 1000);
        updateTimer();

        async function checkStatus() {
          try {
            const res = await fetch(`/api/payments/${PAYMENT_ID}/check`, {
              method: 'GET',
              credentials: 'include'
            });
            const json = await res.json();

            if (json.success) {
              if (json.status === 'PAID') {
                const badge = document.getElementById('payment-status-badge');
                badge.className = 'payment-status-badge status-paid';
                badge.innerHTML = '<i data-lucide="check-circle" style="width: 16px; height: 16px;"></i> Payment Successful';
                showPaidOverlay();
                return;
              } else if (json.status === 'EXPIRED') {
                window.location.reload();
                return;
              }
            }
          } catch (err) {
            console.error('[Payment Polling] Error checking status:', err);
          }

          setTimeout(checkStatus, 3000);
        }

        if (IS_ALREADY_PAID) {
          const badge = document.getElementById('payment-status-badge');
          badge.className = 'payment-status-badge status-paid';
          badge.innerHTML = '<i data-lucide="check-circle" style="width: 16px; height: 16px;"></i> Payment Successful';
          showPaidOverlay();
        } else {
          checkStatus();
        }

        function copyToClipboard(text) {
          navigator.clipboard.writeText(text);
        }

        function showPaidOverlay() {
          if (paidOverlayShown) return;
          paidOverlayShown = true;
          const overlay = document.getElementById('paid-overlay');
          const countdownEl = document.getElementById('paid-countdown');
          let remaining = 5;
          countdownEl.textContent = `Auto return home in ${remaining}s`;
          overlay.classList.add('show');
          lucide.createIcons();

          clearInterval(paidCountdownTimer);
          clearTimeout(paidRedirectTimer);

          paidCountdownTimer = setInterval(() => {
            remaining -= 1;
            countdownEl.textContent = `Auto return home in ${Math.max(remaining, 0)}s`;
            if (remaining <= 0) clearInterval(paidCountdownTimer);
          }, 1000);

          paidRedirectTimer = setTimeout(() => {
            window.location.href = '/';
          }, 5000);
        }

        window.goHomeAfterPaid = function() {
          clearInterval(paidCountdownTimer);
          clearTimeout(paidRedirectTimer);
          window.location.href = '/';
        };

        window.goTrackAfterPaid = function() {
          clearInterval(paidCountdownTimer);
          clearTimeout(paidRedirectTimer);
          window.location.href = TRACKING_URL;
        };

        lucide.createIcons();
      </script>
</body>

</html>
