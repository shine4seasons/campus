<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: title, pageStyles: ['payment-page'] }) %>
</head>

<body class="payment-page">
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="payment-container">
          <div class="payment-card">
            <div class="payment-status-badge status-pending" id="payment-status-badge">
              <i data-lucide="loader-2" class="spin payment-status-icon"></i>
              Waiting for payment
            </div>

            <h1 class="payment-heading">Scan to Pay</h1>
            <p class="payment-subcopy">Please transfer the exact amount using any banking app. We use SePay for automatic verification.</p>

            <div class="qr-frame">
              <img src="<%= qrUrl %>" alt="SePay Payment QR Code">
            </div>

            <div class="amount-box">
              <div class="amount-label">Total Amount</div>
              <% if (payment.order && payment.order.quantity) { %>
                <div class="amount-label">Quantity: <%= payment.order.quantity %></div>
              <% } %>
              <div class="amount-value">
                <%= formatVND(payment.amount) %>
              </div>
            </div>

            <div class="transfer-details">
              <div class="detail-row">
                <span class="detail-label">Bank</span>
                <span class="detail-value">
                  <%= platformBank.bankName %>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Account Number</span>
                <span class="detail-value">
                  <%= platformBank.accountNumber %>
                    <button class="copy-btn" data-action="copy" data-copy-value="<%= platformBank.accountNumber %>"
                      title="Copy">
                      <i data-lucide="copy" class="copy-icon"></i>
                    </button>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Account Name</span>
                <span class="detail-value">
                  <%= platformBank.accountName %>
                </span>
              </div>
              <div class="detail-row">
                <span class="detail-label">Transfer Content</span>
                <span class="detail-value detail-value-code">
                  <%= payment.paymentCode %>
                    <button class="copy-btn" data-action="copy" data-copy-value="<%= payment.paymentCode %>" title="Copy">
                      <i data-lucide="copy" class="copy-icon"></i>
                    </button>
                </span>
              </div>
            </div>


            <div class="countdown" id="countdown-text">
              Session expires in <strong id="timer">15:00</strong>
            </div>

            <div class="polling-indicator">
              <div class="dot"></div>
              Checking payment status...
            </div>


          </div>
        </div>
      </main>

      <div class="paid-overlay" id="paid-overlay">
        <div class="paid-card">
          <div class="paid-icon">
            <i data-lucide="check-check" class="paid-check-icon"></i>
          </div>
          <div class="paid-title">Payment Successful</div>
          <div class="paid-sub">Your order is now paid. You can track shipping progress anytime.</div>
          <div class="paid-countdown" id="paid-countdown">Auto return home in 5s</div>
          <div class="paid-actions">
            <button type="button" class="paid-btn paid-btn-home" data-action="go-home-after-paid">Back to home</button>
            <button type="button" class="paid-btn paid-btn-track" data-action="go-track-after-paid">Track order</button>
          </div>
        </div>
      </div>

      <script>
        window.PAYMENT_PAGE_CONFIG = {
          paymentId: '<%= payment._id %>',
          expiredAt: '<%= payment.expiredAt %>',
          trackingUrl: '/orders/tracking/<%= payment.order._id %>',
          isAlreadyPaid: <%= isAlreadyPaid ? 'true' : 'false' %>
        };
      </script>
      <script defer src="/js/pages/payment.js"></script>
</body>

</html>

