<!DOCTYPE html>
<html lang="en" class="dashboard-shell dashboard-admin-shell">
<head>
  <%- include('partials/head', { pageTitle: 'Admin Dashboard - Campus Marketplace', pageStyles: ['dashboard', 'rating', 'dashboard-admin-page'] }) %>
  <script defer src="/vendor/chart.js-4.4.1/chart.umd.js"></script>
</head>

<body class="dashboard-page dashboard-admin">

  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

      <main class="main">
        <div class="content">
          <header class="page-heading">
            <div class="page-heading-copy">
              <h1 class="page-heading-title" id="pageTitle">Admin Dashboard</h1>
              <p class="page-heading-sub" id="pageSub">Overview & analytics</p>
            </div>
          </header>
          <section class="section active" id="aDash">
            <div class="stat-grid">
              <div class="stat-card stat-card-secondary glass">
                <div class="stat-top">
                  <div class="stat-label">Total users</div>
                  <div class="stat-icon" style="background:var(--info-light);color:var(--info)">
                    <i data-lucide="users"></i>
                  </div>
                </div>
                <div class="stat-val">
                  <%= stats.totalUsers.value.toLocaleString() %>
                </div>
                <div class="stat-delta <%= stats.totalUsers.delta >= 0 ? 'delta-up' : 'delta-dn' %>">
                  <i data-lucide="<%= stats.totalUsers.delta >= 0 ? 'trending-up' : 'trending-down' %>"
                    style="width:14px;height:14px;"></i>
                  <%= Math.abs(stats.totalUsers.delta) %>% vs last month
                </div>
              </div>
              <div class="stat-card stat-card-primary glass">
                <div class="stat-top">
                  <div class="stat-label">Active products</div>
                  <div class="stat-icon" style="background:var(--success-light);color:var(--success)">
                    <i data-lucide="package"></i>
                  </div>
                </div>
                <div class="stat-val">
                  <%= stats.activeProducts.value %>
                </div>
                <div class="stat-delta <%= stats.activeProducts.delta >= 0 ? 'delta-up' : 'delta-dn' %>">
                  <i data-lucide="<%= stats.activeProducts.delta >= 0 ? 'trending-up' : 'trending-down' %>"
                    style="width:14px;height:14px;"></i> +<%= Math.abs(stats.activeProducts.delta) %> today
                </div>
              </div>
              <div class="stat-card glass">
                <div class="stat-top">
                  <div class="stat-label">Orders this month</div>
                  <div class="stat-icon" style="background:var(--warning-light);color:var(--warning)">
                    <i data-lucide="shopping-bag"></i>
                  </div>
                </div>
                <div class="stat-val">
                  <%= stats.ordersThisMonth.value %>
                </div>
                <div class="stat-delta <%= stats.ordersThisMonth.delta >= 0 ? 'delta-up' : 'delta-dn' %>">
                  <i data-lucide="<%= stats.ordersThisMonth.delta >= 0 ? 'trending-up' : 'trending-down' %>"
                    style="width:14px;height:14px;"></i>
                  <%= Math.abs(stats.ordersThisMonth.delta) %>% vs last month
                </div>
              </div>
              <div class="stat-card glass">
                <div class="stat-top">
                  <div class="stat-label">GMV this month</div>
                  <div class="stat-icon" style="background:var(--accent-light);color:var(--accent)">
                    <i data-lucide="dollar-sign"></i>
                  </div>
                </div>
                <div class="stat-val">
                  <%= stats.gmvThisMonth.value>= 1000000 ? (stats.gmvThisMonth.value / 1000000).toFixed(1) + 'M' :
                    stats.gmvThisMonth.value.toLocaleString() %> <span class="stat-unit">VND</span>
                </div>
                <div class="stat-delta <%= stats.gmvThisMonth.delta >= 0 ? 'delta-up' : 'delta-dn' %>">
                  <i data-lucide="<%= stats.gmvThisMonth.delta >= 0 ? 'trending-up' : 'trending-down' %>"
                    style="width:14px;height:14px;"></i>
                  <%= Math.abs(stats.gmvThisMonth.delta) %>% vs last month
                </div>
              </div>
            </div>

            <div class="admin-insights">
              <div class="insight-card priority">
                <div class="insight-kicker">Priority queue</div>
                <div class="insight-title">Moderation needs close attention</div>
                <div class="insight-body">Reported products and unresolved reports are surfaced first so moderators can act before issues spread.</div>
              </div>
              <div class="insight-card">
                <div class="insight-kicker">Marketplace health</div>
                <div class="insight-title">Response quality is stable</div>
                <div class="insight-body">Seller response and order completion are the clearest operational signals for daily admin review.</div>
              </div>
              <div class="insight-card">
                <div class="insight-kicker">Decision support</div>
                <div class="insight-title">Use filters and bulk actions for queues</div>
                <div class="insight-body">Search and moderation actions are grouped to reduce misclicks during repeated review tasks.</div>
              </div>
            </div>

            <div class="charts-row">
              <div class="card premium-card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Revenue & Orders Overview</div>
                    <div class="card-sub">Total transactions, 2026</div>
                  </div>
                  <a class="card-action" href="/admin/analytics">Detailed Analytics</a>
                </div>
                <div class="legend" style="margin-bottom: 16px;">
                  <span class="leg-item"><span class="leg-dot" style="background:var(--primary)"></span>GMV (VND
                    M)</span>
                  <span class="leg-item"><span class="leg-dot" style="background:var(--success)"></span>Orders</span>
                </div>
                <div class="chart-frame chart-frame-lg"><canvas id="cAdminGMV"></canvas></div>
                <div class="chart-foot">
                  <div class="chart-insight">GMV is the lead KPI on this surface, with order volume as the supporting indicator for trend context.</div>
                  <div class="chart-trend">
                    <i data-lucide="activity"></i>
                    Monthly trend
                  </div>
                </div>
              </div>
              <div class="card premium-card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Market Distribution</div>
                    <div class="card-sub">By product category</div>
                  </div>
                </div>
                <div class="chart-frame chart-frame-sm" style="margin-bottom:12px"><canvas id="cAdminCat"></canvas></div>
                <div class="legend"
                  style="flex-direction:column;gap:7px; padding-top: 10px; border-top: 1px solid var(--border);"
                  id="adminCatLegend">
                  <% const catColors=['var(--primary)', 'var(--success)' , 'var(--warning)' , 'var(--accent)'
                    , 'var(--info)' , '#ec4899' , '#f97316' , '#6366f1' ]; %>
                    <% CATEGORIES.forEach((cat, idx)=> { %>
                      <span class="leg-item"><span class="leg-dot"
                          style="background:<%= catColors[idx % catColors.length] %>"></span>
                        <%= cat.name.replace(/&amp;/g, '&' ) %>
                      </span>
                      <% }); %>
                </div>
              </div>
            </div>

            <div class="two-col">
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Top sellers</div>
                    <div class="card-sub">By revenue this month</div>
                  </div>
                </div>
                <% if (topSellers && topSellers.length> 0) { %>
                  <% topSellers.forEach((seller, index)=> { %>
                    <% const rank=index + 1; const rankClass=rank===1 ? 'gold' : rank===2 ? 'silver' : rank===3
                      ? 'bronze' : '' ; const
                      initials=seller.name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
                const revenueFormatted = seller.totalRevenue >= 1000000 ? (seller.totalRevenue / 1000000).toFixed(1) + ' M VND' :
                      seller.totalRevenue.toLocaleString() + ' VND' ; %>
                      <div class="list-item">
                        <div class="li-rank <%= rankClass %>">
                          <%= rank %>
                        </div>
                        <div class="li-avatar" style="background:#dbeafe;color:#2563eb">
                          <%= initials %>
                        </div>
                        <div class="li-info">
                          <a href="/user/<%= seller.sellerId %>" style="text-decoration:none;color:inherit;">
                            <div class="li-name" style="color:#1B5EFF;">
                              <%= seller.name %>
                            </div>
                            <div class="li-sub" style="display:flex;align-items:center;gap:4px;margin-top:2px">
                              <%= seller.totalOrders %> sales &middot;
                                <%- renderStars(seller.rating, 10) %>
                                  <span style="font-weight:600;font-size:11px">
                                    <%= seller.rating.toFixed(1) %>
                                  </span>
                                  &middot; <%= seller.university || 'Unknown' %>
                            </div>
                          </a>
                        </div>
                        <div class="li-val">
                          <%= revenueFormatted %>
                        </div>
                      </div>
                      <% }); %>
                        <% } else { %>
                          <div class="list-item">
                            <div class="li-info">
                              <div class="li-name">No data available</div>
                            </div>
                          </div>
                          <% } %>
              </div>
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Platform health</div>
                    <div class="card-sub">Operational metrics</div>
                  </div>
                </div>
                <div class="prog-row">
                  <div class="prog-item">
                    <div class="prog-meta"><span class="prog-label">Order completion rate</span><span
                        class="prog-val">84%</span></div>
                    <div class="prog-bar">
                      <div class="prog-fill" style="width:84%;background:#2563eb"></div>
                    </div>
                  </div>
                  <div class="prog-item">
                    <div class="prog-meta"><span class="prog-label">Seller response</span><span
                        class="prog-val">91%</span></div>
                    <div class="prog-bar">
                      <div class="prog-fill" style="width:91%;background:#22c55e"></div>
                    </div>
                  </div>
                  <div class="prog-item">
                    <div class="prog-meta"><span class="prog-label">Profile complete</span><span
                        class="prog-val">62%</span></div>
                    <div class="prog-bar">
                      <div class="prog-fill" style="width:62%;background:#f59e0b"></div>
                    </div>
                  </div>
                  <div class="prog-item">
                    <div class="prog-meta"><span class="prog-label">Cancellation rate</span><span
                        class="prog-val">8%</span></div>
                    <div class="prog-bar">
                      <div class="prog-fill" style="width:8%;background:#ef4444"></div>
                    </div>
                  </div>
                  <div class="prog-item">
                    <div class="prog-meta"><span class="prog-label">Average rating</span><span
                        class="prog-val">4.7/5</span></div>
                    <div class="prog-bar">
                      <div class="prog-fill" style="width:94%;background:#8b5cf6"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
          <section class="section" id="aAnalytics">
            <div class="stat-grid">
              <div class="stat-card">
                <div class="stat-top">
                  <div>
                    <div class="stat-label">New users (7d)</div>
                  </div>
                  <div class="stat-icon" style="background:#dcfce7;color:#16a34a"><svg viewBox="0 0 24 24">
                      <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                      <circle cx="8.5" cy="7" r="4" />
                      <line x1="20" y1="8" x2="20" y2="14" />
                      <line x1="23" y1="11" x2="17" y2="11" />
                    </svg></div>
                </div>
                <div class="stat-val">86</div>
                <div class="stat-delta delta-up"><i data-lucide="trending-up"
                    style="width:14px;height:14px;display:inline-block;vertical-align:middle;margin-right:2px;"></i>
                  +14%</div>
              </div>
              <div class="stat-card">
                <div class="stat-top">
                  <div>
                    <div class="stat-label">Return rate</div>
                  </div>
                  <div class="stat-icon" style="background:#dbeafe;color:#2563eb"><svg viewBox="0 0 24 24">
                      <polyline points="17 1 21 5 17 9" />
                      <path d="M3 11V9a4 4 0 014-4h14M7 23l-4-4 4-4" />
                      <path d="M21 13v2a4 4 0 01-4 4H3" />
                    </svg></div>
                </div>
                <div class="stat-val">68%</div>
                <div class="stat-delta delta-up"><i data-lucide="trending-up"
                    style="width:14px;height:14px;display:inline-block;vertical-align:middle;margin-right:2px;"></i> +3
                  pts</div>
              </div>
              <div class="stat-card">
                <div class="stat-top">
                  <div>
                    <div class="stat-label">Avg order value</div>
                  </div>
                  <div class="stat-icon" style="background:#fef3c7;color:#d97706"><svg viewBox="0 0 24 24">
                      <line x1="12" y1="1" x2="12" y2="23" />
                      <path d="M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 110 7H6" />
                    </svg></div>
                </div>
                <div class="stat-val">435K VND</div>
                <div class="stat-delta delta-dn"><i data-lucide="trending-down"
                    style="width:14px;height:14px;display:inline-block;vertical-align:middle;margin-right:2px;"></i> -2%
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-top">
                  <div>
                    <div class="stat-label">New products / day</div>
                  </div>
                  <div class="stat-icon" style="background:#ede9fe;color:#7c3aed"><svg viewBox="0 0 24 24">
                      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
                    </svg></div>
                </div>
                <div class="stat-val">11.4</div>
                <div class="stat-delta delta-up"><i data-lucide="trending-up"
                    style="width:14px;height:14px;display:inline-block;vertical-align:middle;margin-right:2px;"></i> +6%
                </div>
              </div>
            </div>

            <div class="card primary-surface" style="margin-bottom:22px">
              <div class="card-head">
                <div>
                  <div class="card-title">User growth &mdash; 2026</div>
                  <div class="card-sub">Cumulative registered accounts</div>
                </div>
              </div>
              <div class="chart-frame chart-frame-md"><canvas id="cUserGrowth"></canvas></div>
            </div>

            <div class="two-col">
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Revenue by category</div>
                    <div class="card-sub">Accumulated GMV (VND M)</div>
                  </div>
                </div>
                <div class="chart-frame chart-frame-md"><canvas id="cRevCat"></canvas></div>
              </div>
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Weekly orders</div>
                    <div class="card-sub">2026</div>
                  </div>
                </div>
                <div class="chart-frame chart-frame-md"><canvas id="cWeekly"></canvas></div>
              </div>
            </div>

            <div class="three-col">
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Delivery method</div>
                    <div class="card-sub">Pickup vs Ship</div>
                  </div>
                </div>
                <div class="chart-frame chart-frame-sm" style="margin-bottom:10px"><canvas id="cDelivery"></canvas></div>
                <div class="legend" style="flex-direction:column;gap:6px" id="dlvLegend">
                  <span class="leg-item"><span class="leg-dot" style="background:#2563eb"></span>Pickup &mdash; 63%</span>
                  <span class="leg-item"><span class="leg-dot" style="background:#22c55e"></span>Ship &mdash; 37%</span>
                </div>
              </div>
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Payment methods</div>
                    <div class="card-sub">Cash vs Card</div>
                  </div>
                </div>
                <div class="chart-frame chart-frame-sm" style="margin-bottom:10px"><canvas id="cPayment"></canvas></div>
                <div class="legend" style="flex-direction:column;gap:6px" id="payLegend">
                  <span class="leg-item"><span class="leg-dot" style="background:#f59e0b"></span>Cash &mdash; 71%</span>
                  <span class="leg-item"><span class="leg-dot" style="background:#8b5cf6"></span>Card &mdash; 29%</span>
                </div>
              </div>
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Order status</div>
                    <div class="card-sub">Distribution this month</div>
                  </div>
                </div>
                <div class="chart-frame chart-frame-sm" style="margin-bottom:10px"><canvas id="cOrderStatus"></canvas></div>
                <div class="legend" style="flex-direction:column;gap:6px" id="orderStsLegend">
                  <span class="leg-item"><span class="leg-dot" style="background:#22c55e"></span>Completed &mdash; 62%</span>
                  <span class="leg-item"><span class="leg-dot" style="background:#2563eb"></span>Confirmed &mdash; 23%</span>
                  <span class="leg-item"><span class="leg-dot" style="background:#f59e0b"></span>Pending &mdash; 7%</span>
                  <span class="leg-item"><span class="leg-dot" style="background:#ef4444"></span>Cancelled &mdash; 8%</span>
                </div>
              </div>
            </div>
          </section>
          <section class="section" id="aUsers">
            <div class="tbl-wrap">
              <div class="tbl-toolbar">
                <div>
                  <div class="tbl-title">All users</div>
                  <div class="tbl-count" id="adminUsersCount"><%= typeof allUsersCount === 'number' ? allUsersCount.toLocaleString() : '0' %> accounts</div>
                </div>
                <div class="tbl-toolbar-right">
                  <div class="filter-pills">
                    <button class="f-pill on">All</button>
                    <button class="f-pill">Active</button>
                    <button class="f-pill">Banned</button>
                    <button class="f-pill">New (7d)</button>
                  </div>
                </div>
              </div>
              <div class="tbl-search">
                <svg viewBox="0 0 24 24" stroke-width="2">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input id="adminUsersSearch" type="text" placeholder="Search users by name, email, university...">
                <span class="tbl-search-hint"><span class="kbd-hint">/</span> Focus search</span>
              </div>
              <div class="bulk-bar" id="usersBulkBar">
                <div class="bulk-copy">
                  <i data-lucide="users"></i>
                  <span><strong id="usersSelectedCount">0</strong> users selected</span>
                </div>
                <div class="bulk-actions">
                  <button class="act-btn success" type="button" data-action="bulk-unban-users">Unban selected</button>
                  <button class="act-btn danger" type="button" data-action="bulk-ban-users">Ban selected</button>
                </div>
              </div>
              <table class="admin-payouts-table">
                <colgroup>
                  <col class="col-payout-seller">
                  <col class="col-payout-email">
                  <col class="col-payout-amount">
                  <col class="col-payout-bank">
                  <col class="col-payout-date">
                  <col class="col-payout-status">
                  <col class="col-payout-transfer">
                  <col class="col-payout-actions">
                </colgroup>
                <thead>
                  <tr>
                    <th class="check-cell"><input class="admin-checkbox" id="usersSelectAll" type="checkbox" aria-label="Select all users"></th>
                    <th>User</th>
                    <th>University</th>
                    <th>Joined</th>
                    <th>Sold</th>
                    <th>Purchased</th>
                    <th>Rating</th>
                    <th>Role</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="usersTableBody">
                  <tr>
                    <td colspan="9" style="text-align:center;color:var(--t2);padding:32px"><span
                        class="adm-loader"></span> Loading users&hellip;</td>
                  </tr>
                </tbody>
              </table>
              <div class="pagination"></div>
            </div>
          </section>
          <section class="section" id="aProducts">
            <div class="tbl-wrap warning-surface">
              <div class="tbl-toolbar">
                <div>
                  <div class="tbl-title">All products</div>
                  <div class="tbl-count">
                    <%= (stats.totalProducts?.value || 0).toLocaleString() %> products
                  </div>
                </div>
                <div class="filter-pills">
                  <button class="f-pill on" data-status="">All</button>
                  <button class="f-pill" data-status="active">Active</button>
                  <button class="f-pill" data-status="sold">Sold</button>
                  <button class="f-pill" data-status="hidden">Hidden</button>
                  <button class="f-pill attention" data-status="reported">Reported
                    (<span id="reported-products-count">0</span>)</button>
                </div>
              </div>
              <div class="tbl-search">
                <svg viewBox="0 0 24 24" stroke-width="2">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input id="adminProductsSearch" type="text" placeholder="Search products or sellers...">
                <span class="tbl-search-hint"><span class="kbd-hint">/</span> Focus search</span>
              </div>
              <table class="admin-products-table">
                <colgroup>
                  <col class="col-product">
                  <col class="col-seller">
                  <col class="col-category">
                  <col class="col-price">
                  <col class="col-views">
                  <col class="col-interest">
                  <col class="col-status">
                  <col class="col-posted">
                  <col class="col-actions">
                </colgroup>
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Seller</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Views</th>
                    <th>Interest</th>
                    <th>Status</th>
                    <th>Posted</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>
                      <div class="product-cell">
                        <div class="product-thumb">FX</div>
                        <div class="product-copy">
                          <strong class="product-title">Casio FX-580VNX</strong>
                          <div class="product-sub">Fast-moving calculator listing</div>
                        </div>
                      </div>
                    </td>
                    <td class="muted-cell">John Tran</td>
                    <td class="muted-cell">Electronics</td>
                    <td>320,000 VND</td>
                    <td>124</td>
                    <td>8</td>
                    <td><span class="badge badge-active">Active</span></td>
                    <td class="muted-cell">02/04/2026</td>
                    <td>
                      <div class="tbl-actions">
                        <button class="act-btn primary">View</button>
                        <details class="action-menu">
                          <summary class="act-btn">Moderate</summary>
                          <div class="action-menu-panel">
                            <button class="act-btn danger" type="button" data-danger-confirm="Hide this product from the marketplace?" data-toast-message="Product hidden" data-toast-type="ok">Hide</button>
                          </div>
                        </details>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <div class="product-cell">
                        <div class="product-thumb">BK</div>
                        <div class="product-copy">
                          <strong class="product-title">Macroeconomics Textbook</strong>
                          <div class="product-sub">Study material with steady demand</div>
                        </div>
                      </div>
                    </td>
                    <td class="muted-cell">Ann Le</td>
                    <td class="muted-cell">Books</td>
                    <td>80,000 VND</td>
                    <td>88</td>
                    <td>4</td>
                    <td><span class="badge badge-active">Active</span></td>
                    <td class="muted-cell">28/03/2026</td>
                    <td>
                      <div class="tbl-actions">
                        <button class="act-btn primary">View</button>
                        <details class="action-menu">
                          <summary class="act-btn">Moderate</summary>
                          <div class="action-menu-panel">
                            <button class="act-btn danger" type="button" data-danger-confirm="Hide this product from the marketplace?">Hide</button>
                          </div>
                        </details>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <div class="product-cell">
                        <div class="product-thumb">HU</div>
                        <div class="product-copy">
                          <strong class="product-title">HUST Hoodie 2024</strong>
                          <div class="product-sub">Seasonal campus apparel</div>
                        </div>
                      </div>
                    </td>
                    <td class="muted-cell">Minh Hoa</td>
                    <td class="muted-cell">Clothing</td>
                    <td>250,000 VND</td>
                    <td>210</td>
                    <td>18</td>
                    <td><span class="badge badge-sold">Sold</span></td>
                    <td class="muted-cell">15/03/2026</td>
                    <td>
                      <div class="tbl-actions"><button class="act-btn">View</button></div>
                    </td>
                  </tr>
                  <tr class="row-critical">
                    <td>
                      <div class="product-cell">
                        <div class="product-thumb">LP</div>
                        <div class="product-copy">
                          <strong class="product-title">Laptop Dell XPS 13 (2024)</strong>
                          <div class="product-sub">High-value listing flagged by reports</div>
                        </div>
                      </div>
                    </td>
                    <td class="muted-cell">Phuc Quang</td>
                    <td class="muted-cell">Electronics</td>
                    <td>18,500,000 VND</td>
                    <td>543</td>
                    <td>32</td>
                    <td><span class="badge badge-reported">Reported</span></td>
                    <td class="muted-cell">10/03/2026</td>
                    <td>
                      <div class="tbl-actions">
                        <button class="act-btn primary">Review</button>
                        <details class="action-menu">
                          <summary class="act-btn">Moderate</summary>
                          <div class="action-menu-panel">
                            <button class="act-btn danger" type="button" data-danger-confirm="Delete this reported product?" data-toast-message="Product deleted" data-toast-type="ok">Delete</button>
                          </div>
                        </details>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <div class="product-cell">
                        <div class="product-thumb">HM</div>
                        <div class="product-copy">
                          <strong class="product-title">Memory Foam Pillow</strong>
                          <div class="product-sub">Hidden after repeated quality complaints</div>
                        </div>
                      </div>
                    </td>
                    <td class="muted-cell">Bao Khanh</td>
                    <td class="muted-cell">Furniture</td>
                    <td>450,000 VND</td>
                    <td>67</td>
                    <td>5</td>
                    <td><span class="badge badge-hidden">Hidden</span></td>
                    <td class="muted-cell">01/03/2026</td>
                    <td>
                      <div class="tbl-actions"><button class="act-btn success"
                          data-toast-message="Product restored" data-toast-type="ok">Restore</button></div>
                    </td>
                  </tr>
                </tbody>
              </table>
              <div class="pagination"></div>
            </div>
          </section>
          <section class="section" id="aOrders">
            <div class="status-counters">
              <div class="status-count-card" style="border-top-color:#d97706">
                <div class="sc-label">Pending confirmation</div>
                <div class="sc-val" style="color:#d97706">14</div>
              </div>
              <div class="status-count-card" style="border-top-color:#2563eb">
                <div class="sc-label">Confirmed</div>
                <div class="sc-val" style="color:#2563eb">23</div>
              </div>
              <div class="status-count-card" style="border-top-color:#16a34a">
                <div class="sc-label">Completed</div>
                <div class="sc-val" style="color:#16a34a">61</div>
              </div>
              <div class="status-count-card" style="border-top-color:#dc2626">
                <div class="sc-label">Cancelled</div>
                <div class="sc-val" style="color:#dc2626">8</div>
              </div>
            </div>
            <div class="tbl-wrap">
              <div class="tbl-toolbar">
                <div>
                  <div class="tbl-title">All orders</div>
                  <div class="tbl-count">106 orders</div>
                </div>
                <div class="filter-pills">
                  <button class="f-pill on">All</button>
                  <button class="f-pill">Pending</button>
                  <button class="f-pill">Confirmed</button>
                  <button class="f-pill">Completed</button>
                  <button class="f-pill">Cancelled</button>
                </div>
              </div>
              <div class="tbl-search">
                <svg viewBox="0 0 24 24" stroke-width="2">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input id="adminOrdersSearch" type="text" placeholder="Search orders, buyer, seller..." disabled>
                <span class="tbl-search-hint">Status filters are active on this queue</span>
              </div>
              <table class="admin-orders-table">
                <colgroup>
                  <col class="col-order-id">
                  <col class="col-product">
                  <col class="col-buyer">
                  <col class="col-seller">
                  <col class="col-price">
                  <col class="col-delivery">
                  <col class="col-payment">
                  <col class="col-status">
                </colgroup>
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Product</th>
                    <th>Buyer</th>
                    <th>Seller</th>
                    <th>Price</th>
                    <th>Delivery</th>
                    <th>Payment</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="ordersTableBody">
                  <tr>
                    <td colspan="8" style="text-align:center;color:var(--t2);padding:32px"><span
                        class="adm-loader"></span> Loading orders&hellip;</td>
                  </tr>
                </tbody>
              </table>
              <div class="pagination"></div>
            </div>
          </section>
          <section class="section" id="aReports">
            <div class="alert-box alert-warn" style="margin-bottom:18px">
              <svg viewBox="0 0 24 24" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
              <div class="alert-box-text" id="reports-alert-text">There are 0 reported items awaiting review. Please review and take action
                promptly.</div>
            </div>
            <div class="tbl-wrap primary-surface">
              <div class="tbl-toolbar">
                <div>
                  <div class="tbl-title">Reported content</div>
                  <div class="tbl-count" id="reports-total">0 items</div>
                </div>
                <div class="filter-pills">
                  <button class="f-pill on" data-filter="all">All</button>
                  <button class="f-pill" data-filter="pending">Pending</button>
                  <button class="f-pill" data-filter="under-review">Under Review</button>
                  <button class="f-pill" data-filter="resolved">Resolved</button>
                </div>
              </div>
              <div class="bulk-bar warning" id="reportsBulkBar">
                <div class="bulk-copy">
                  <i data-lucide="shield-alert"></i>
                  <span><strong id="reportsSelectedCount">0</strong> reports selected</span>
                </div>
                <div class="bulk-actions">
                  <button class="act-btn success" type="button" data-action="bulk-resolve-reports">Resolve selected</button>
                </div>
              </div>
              <table>
                <thead>
                  <tr>
                    <th class="check-cell"><input class="admin-checkbox" id="reportsSelectAll" type="checkbox" aria-label="Select all reports"></th>
                    <th>Target</th>
                    <th>Reporter</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="reportsTableBody">
                  <tr>
                    <td colspan="6" style="text-align:center;color:var(--t2);padding:32px"><span
                        class="adm-loader"></span> Loading reports&hellip;</td>
                  </tr>
                </tbody>
              </table>
              <div class="pagination"></div>
            </div>
          </section>
          <section class="section" id="aPayouts">
            <div class="status-counters">
              <div class="status-count-card" style="border-top-color: var(--amber)">
                <div class="sc-label">Pending Payouts</div>
                <div class="sc-val" id="payout-pending-count" style="color: var(--amber)">0</div>
              </div>
              <div class="status-count-card" style="border-top-color: var(--green)">
                <div class="sc-label">Processing</div>
                <div class="sc-val" id="payout-processing-count" style="color: var(--green)">0</div>
              </div>
              <div class="status-count-card" style="border-top-color: var(--primary)">
                <div class="sc-label">Paid Out</div>
                <div class="sc-val" id="payout-paid-count" style="color: var(--primary)">0</div>
              </div>
              <div class="status-count-card" style="border-top-color: var(--red)">
                <div class="sc-label">Rejected Payouts</div>
                <div class="sc-val" id="payout-rejected-count" style="color: var(--red)">0</div>
              </div>
            </div>
            <div class="tbl-wrap primary-surface">
              <div class="tbl-toolbar">
                <div>
                  <div class="tbl-title">Payout Requests</div>
                  <div class="tbl-count" id="payout-total-count">0 requests</div>
                </div>
                <div class="filter-pills">
                  <button class="f-pill on" data-filter="all">All</button>
                  <button class="f-pill" data-filter="PENDING">Pending</button>
                  <button class="f-pill" data-filter="PROCESSING">Processing</button>
                  <button class="f-pill" data-filter="PAID">Paid</button>
                  <button class="f-pill" data-filter="REJECTED">Rejected</button>
                </div>
              </div>
              <table>
                <thead>
                  <tr>
                    <th>Seller</th>
                    <th>Email</th>
                    <th>Amount</th>
                    <th>Bank Details</th>
                    <th>Requested Date</th>
                    <th>Status</th>
                    <th>Transfer</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="payoutsTableBody">
                  <tr>
                    <td colspan="8" style="text-align:center;color:var(--t2);padding:32px"><span class="adm-loader"></span> Loading payout requests&hellip;</td>
                  </tr>
                </tbody>
              </table>
              <div class="pagination"></div>
            </div>
          </section>
          <section class="section" id="aSettings">
            <div class="settings-grid">
              <div class="card settings-panel primary-surface">
                <div class="card-head">
                  <div>
                    <div class="card-title">Platform settings</div>
                    <div class="card-sub">General settings</div>
                  </div>
                </div>
                <div class="settings-categories">
                  <span class="settings-chip">Platform</span>
                  <span class="settings-chip">Moderation</span>
                  <span class="settings-chip">Notifications</span>
                  <span class="settings-chip">Financial</span>
                  <span class="settings-chip">Marketplace</span>
                </div>
                <div class="form-grid">
                  <div class="form-group"><label class="form-label">Platform name</label><input class="form-input"
                      id="set-platformName" value="Campus Marketplace"></div>
                  <div class="form-row">
                    <div class="form-group"><label class="form-label">Service fee (%)</label><input class="form-input"
                        id="set-serviceFee" type="number" value="0"></div>
                    <div class="form-group"><label class="form-label">Image/product limit</label><input
                        id="set-imgLimit" class="form-input" type="number" value="5"></div>
                  </div>
                  <div class="form-group"><label class="form-label">Support email</label><input class="form-input"
                      id="set-supportEmail" type="email" value="support@campusmkt.vn"></div>
                  <div class="form-group"><label class="form-label">System notifications</label><textarea
                      id="set-announcement" class="form-textarea"
                      placeholder="Send announcement to all users..."></textarea></div>
                  <button class="btn btn-primary" style="align-self:flex-start" id="btn-save-settings"
                    data-action="save-admin-settings">Save
                    changes</button>
                </div>
                <div class="section-note">Save feedback, success toasts and current settings logic remain unchanged. This panel is regrouped to reduce scanning time and keep high-risk controls away from everyday edits.</div>
              </div>
              <div class="settings-stack">
                <div class="card">
                  <div class="card-head">
                    <div>
                      <div class="card-title">Category management</div>
                      <div class="card-sub"><span id="adminCatCount">
                          <%= CATEGORIES.length %>
                        </span> categories available</div>
                    </div><button class="act-btn primary" disabled title="Coming soon"
                      style="opacity:0.5;cursor:not-allowed;">+ Add <span
                        style="font-size:10px;font-weight:600;background:#FFF6E0;color:#B8860B;padding:2px 6px;border-radius:6px;margin-left:4px;">Soon</span></button>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:2px" id="adminCategoriesList">
                    <% CATEGORIES.forEach((cat, idx)=> { %>
                      <div class="list-item category-item">
                        <div class="category-copy">
                          <div class="category-icon"><%= String(idx + 1).padStart(2, '0') %></div>
                        <div class="li-info">
                          <div class="li-name">
                            <%= cat.name.replace(/&amp;/g, '&' ) %>
                          </div>
                          <div class="li-sub">Category ID: <%= cat.slug %>
                          </div>
                        </div>
                        </div>
                        <div class="category-metrics">
                          <div>Usage stats coming next</div>
                          <button class="act-btn" disabled title="Coming soon"
                          style="opacity:0.5;cursor:not-allowed;margin-top:6px;">Edit</button>
                        </div>
                      </div>
                      <% }); %>
                  </div>
                </div>
                <div class="card">
                  <div class="card-head">
                    <div>
                      <div class="card-title">System statistics</div>
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:8px;font-size:13px" id="adminSysStats">
                    <div style="display:flex;justify-content:space-between"><span style="color:var(--t2)">Database
                        size</span><span style="font-weight:600">Calculating...</span></div>
                    <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border)">
                      <button class="btn btn-outline" style="width:100%;justify-content:center;font-size:12px;"
                        data-action="sync-seller-ratings">
                        <svg viewBox="0 0 24 24" style="width:14px;height:14px;margin-right:6px" fill="none"
                          stroke="currentColor" stroke-width="2.5">
                          <path
                            d="M21.5 2v6h-6M2.5 22v-6h6M2 12c0-4.4 3.6-8 8-8 3.3 0 6.2 2 7.4 4.9M22 12c0 4.4-3.6 8-8 8-3.3 0-6.2-2-7.4-4.9" />
                        </svg>
                        Sync Seller Ratings
                      </button>
                      <p style="font-size:10px;color:var(--t3);margin-top:8px;text-align:center;line-height:1.4">
                        Recalculates all seller ratings based on their product reviews. Use this after data imports.</p>
                    </div>
                  </div>
                </div>
                <div class="card">
                  <div class="card-head">
                    <div>
                      <div class="card-title">Admin operating notes</div>
                      <div class="card-sub">Recoverability, traceability and save-state guidance</div>
                    </div>
                  </div>
                  <div class="settings-meta">
                    <div class="settings-row">
                      <div>
                        <strong>Unsaved changes</strong>
                        <span>Adjustments remain local until you explicitly save the settings panel.</span>
                      </div>
                      <span class="settings-chip">Manual save</span>
                    </div>
                    <div class="settings-row">
                      <div>
                        <strong>Marketplace categories</strong>
                        <span>Current ordering is preserved while the future drag-and-drop flow is being prepared.</span>
                      </div>
                      <span class="settings-chip">Safe mode</span>
                    </div>
                    <div class="settings-row">
                      <div>
                        <strong>Financial controls</strong>
                        <span>Payout approvals and rejections continue to use explicit confirmation before execution.</span>
                      </div>
                      <span class="settings-chip">Guarded</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </main>

      <!-- Payout Action Modal -->
      <div id="payoutActionModal" class="success-overlay modal-surface payout-action-modal">
        <div class="success-card modal-card payout-action-card">
          <div class="modal-icon">
            <svg viewBox="0 0 24 24" width="40" height="40" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="payout-action-icon"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
          <h3 class="modal-title">Confirm Payout Action</h3>
          <p id="payoutActionText" class="modal-copy"></p>
          <div class="modal-fields">
            <input id="payoutTransferReference" class="modal-input" type="text" placeholder="Transfer reference">
            <textarea id="payoutTransferNote" class="modal-textarea" placeholder="Transfer note shown in payout history"></textarea>
            <textarea id="payoutAdminNote" class="modal-textarea" placeholder="Admin note / rejection reason"></textarea>
          </div>
          <div class="modal-actions">
            <button class="btn payout-modal-cancel" data-action="close-payout-modal">Cancel</button>
            <button id="payoutConfirmBtn" class="btn btn-primary payout-modal-confirm">Confirm</button>
          </div>
        </div>
      </div>

      <div id="toast-wrap"></div>


      <script id="dashboard-page-config" type="application/json"><%- JSON.stringify({ initialSection: initialSection || '' }).replace(/</g, '\\u003c') %></script>
      <script defer src="/js/rating.js"></script>
      <%- include('partials/dashboard-scripts') %>
      <script defer src="/js/pages/dashboard-admin.js"></script>
</body>

</html>

