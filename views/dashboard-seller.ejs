<!DOCTYPE html>
<html lang="en" class="dashboard-shell">
<head>
  <%- include('partials/head', { pageTitle: 'Seller Dashboard - Campus Marketplace', pageStyles: ['dashboard', 'rating'] }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
</head>

<body class="dashboard-page dashboard-seller">
  <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>


      <main class="main">

        <div class="content">
          <header class="page-heading">
            <div class="page-heading-copy">
              <h1 class="page-heading-title" id="pageTitle">Seller Dashboard</h1>
              <p class="page-heading-sub" id="pageSub">Overview of your sales & performance</p>
            </div>
          </header>

          <!-- ── SECTION: Dashboard ── -->
          <section class="section active" id="sDash">
            <div class="stat-grid">
              <div class="stat-card glass">
                <div class="stat-top">
                  <div class="stat-label">Active products</div>
                  <div class="stat-icon" style="background:var(--success-light);color:var(--success)">
                    <i data-lucide="package"></i>
                  </div>
                </div>
                <div class="stat-val">
                  <%= stats.activeProducts %>
                </div>
                <div class="stat-delta">Total live products</div>
              </div>
              <div class="stat-card glass">
                <div class="stat-top">
                  <div class="stat-label">Awaiting confirmation</div>
                  <div class="stat-icon" style="background:var(--warning-light);color:var(--warning)">
                    <i data-lucide="clock"></i>
                  </div>
                </div>
                <div class="stat-val" style="color:var(--warning)">
                  <%= stats.pendingOrders %>
                </div>
                <div class="stat-delta">Needs your action</div>
              </div>
              <div class="stat-card glass">
                <div class="stat-top">
                  <div class="stat-label">Monthly Revenue</div>
                  <div class="stat-icon" style="background:var(--info-light);color:var(--info)">
                    <i data-lucide="dollar-sign"></i>
                  </div>
                </div>
                <div class="stat-val">
                  <%= formatVND(stats.monthRevenue) %>
                </div>
                <div class="stat-delta">Earned this month</div>
              </div>
              <div class="stat-card glass">
                <div class="stat-top">
                  <div class="stat-label">Seller Rating</div>
                  <div class="stat-icon" style="background:var(--accent-light);color:var(--accent)">
                    <i data-lucide="star"></i>
                  </div>
                </div>
                <div class="stat-val" style="display:flex;align-items:center;gap:6px">
                  <%- renderStars(user.rating || 5, 18) %>
                    <span style="font-size:18px;font-weight:800">
                      <%= (user.rating || 5).toFixed(1) %>
                    </span>
                </div>
                <div class="stat-delta">From <%= user.ratingCount || 0 %> reviews</div>
              </div>
            </div>

            <% if (stats.pendingOrders> 0) { %>
              <div class="alert-box glass" style="margin-bottom:24px; border-left: 4px solid var(--warning);">
                <i data-lucide="alert-circle" style="color:var(--warning); width:24px; height:24px;"></i>
                <div class="alert-box-text">
                  You have <strong>
                    <%= stats.pendingOrders %>
                  </strong> order<%= stats.pendingOrders> 1 ? 's' : '' %> awaiting confirmation.
                    Please confirm within 24 hours to avoid automatic cancellation.
                </div>
              </div>
              <% } %>

                <div class="quick-grid">
                  <div class="quick-card glass" data-href="/my-products">
                    <div class="qc-icon" style="background:var(--primary-light);color:var(--primary)">
                      <i data-lucide="layout-grid"></i>
                    </div>
                    <div class="qc-body">
                      <div class="qc-label">My Products</div>
                      <div class="qc-sub">
                        <%= stats.activeProducts %> active products
                      </div>
                    </div>
                    <i data-lucide="chevron-right" style="margin-left:auto; width:16px; opacity:0.3;"></i>
                  </div>
                  <div class="quick-card glass" data-href="/orders-seller">
                    <div class="qc-icon" style="background:var(--warning-light);color:var(--warning)">
                      <i data-lucide="shopping-cart"></i>
                    </div>
                    <div class="qc-body">
                      <div class="qc-label">Sales Orders</div>
                      <div class="qc-sub">
                        <%= stats.pendingOrders %> pending orders
                      </div>
                    </div>
                    <i data-lucide="chevron-right" style="margin-left:auto; width:16px; opacity:0.3;"></i>
                  </div>
                  <div class="quick-card glass" data-action="show-section" data-section="sWallet">
                    <div class="qc-icon" style="background:var(--accent-light);color:var(--accent)">
                      <i data-lucide="wallet"></i>
                    </div>
                    <div class="qc-body">
                      <div class="qc-label">Platform Wallet</div>
                      <div class="qc-sub">
                        <%= formatVND(wallet.availableBalance) %> available
                      </div>
                    </div>
                    <i data-lucide="chevron-right" style="margin-left:auto; width:16px; opacity:0.3;"></i>
                  </div>
                </div>

                <div class="charts-row">
                  <div class="card premium-card">
                    <div class="card-head">
                      <div>
                        <div class="card-title">Revenue Overview — 2026</div>
                        <div class="card-sub">By month (VND thousands)</div>
                      </div>
                    </div>
                    <div style="position:relative;height:240px"><canvas id="cSellerRev"></canvas></div>
                  </div>
                  <div class="card premium-card">
                    <div class="card-head">
                      <div>
                        <div class="card-title">Sales Distribution</div>
                        <div class="card-sub">By category</div>
                      </div>
                    </div>
                    <div style="position:relative;height:180px;margin-bottom:12px"><canvas id="cSellerCat"></canvas>
                    </div>
                    <div class="legend"
                      style="flex-direction:column;gap:7px; padding-top: 10px; border-top: 1px solid var(--border);"
                      id="sCatLegend">
                      <span class="leg-item"><span class="leg-dot" style="background:var(--primary)"></span>No
                        data</span>
                    </div>
                  </div>
                </div>
          </section>

          <!-- ── SECTION: Orders, Listings, Revenue are split into separate pages ── -->
          <!-- See: dashboard-listings.ejs, dashboard-orders.ejs, dashboard-revenue.ejs -->

          <!-- ── SECTION: Messages ── -->
          <section class="section" id="sMessages">
            <div class="alert-box alert-info" style="margin-bottom:16px">
              <svg viewBox="0 0 24 24" stroke-width="2">
                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
              </svg>
              <div class="alert-box-text">You have 4 unread messages. <a href="/messages"
                  style="color:var(--blue);font-weight:600">Open inbox →</a></div>
            </div>
            <div class="two-col">
              <div class="tbl-wrap" style="margin-bottom:0">
                <div class="tbl-toolbar">
                  <div>
                    <div class="tbl-title">Recent conversations</div>
                  </div>
                </div>
                <div style="padding: 0 20px">
                  <div class="list-item">
                    <div class="li-avatar" style="background:#dbeafe;color:#1d4ed8">HA</div>
                    <div class="li-info">
                      <div class="li-name">Hung Anh<span
                          style="font-size:11px;color:var(--t2);font-weight:400;margin-left:8px">2 mins ago</span>
                      </div>
                      <div class="li-sub">Casio FX-580 — Can you deliver tomorrow?</div>
                    </div><span class="nav-badge" style="font-size:10px">2</span>
                  </div>
                  <div class="list-item">
                    <div class="li-avatar" style="background:#dcfce7;color:#15803d">LC</div>
                    <div class="li-info">
                      <div class="li-name">Lan Chi<span
                          style="font-size:11px;color:var(--t2);font-weight:400;margin-left:8px">1 hour ago</span>
                      </div>
                      <div class="li-sub">Backpack — My delivery address is...</div>
                    </div><span class="nav-badge" style="font-size:10px">1</span>
                  </div>
                  <div class="list-item">
                    <div class="li-avatar" style="background:#fef3c7;color:#b45309">TA</div>
                    <div class="li-info">
                      <div class="li-name">Tu Anh<span
                          style="font-size:11px;color:var(--t2);font-weight:400;margin-left:8px">Yesterday</span></div>
                      <div class="li-sub">Received the item, thank you!</div>
                    </div>
                  </div>
                  <div class="list-item">
                    <div class="li-avatar" style="background:#ede9fe;color:#6d28d9">HY</div>
                    <div class="li-info">
                      <div class="li-name">Hai Yen<span
                          style="font-size:11px;color:var(--t2);font-weight:400;margin-left:8px">2 days ago</span>
                      </div>
                      <div class="li-sub">Textbook — OK, I received it</div>
                    </div><span class="nav-badge" style="font-size:10px">1</span>
                  </div>
                </div>
                <div style="padding:12px 20px;border-top:1px solid var(--border)">
                  <a href="/messages" class="btn btn-primary" style="display:inline-flex">Open full inbox →</a>
                </div>
              </div>
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Chat stats</div>
                  </div>
                </div>
                <div class="prog-row">
                  <div class="prog-item">
                    <div class="prog-meta"><span class="prog-label">Response rate</span><span
                        class="prog-val">95%</span></div>
                    <div class="prog-bar">
                      <div class="prog-fill" style="width:95%;background:#22c55e"></div>
                    </div>
                  </div>
                  <div class="prog-item">
                    <div class="prog-meta"><span class="prog-label">Response within 1 hour</span><span
                        class="prog-val">82%</span></div>
                    <div class="prog-bar">
                      <div class="prog-fill" style="width:82%;background:#2563eb"></div>
                    </div>
                  </div>
                </div>
                <div style="margin-top:20px;display:flex;flex-direction:column;gap:8px;font-size:13px">
                  <div style="display:flex;justify-content:space-between"><span style="color:var(--t2)">Total
                      conversations</span><span style="font-weight:600">34</span></div>
                  <div style="display:flex;justify-content:space-between"><span
                      style="color:var(--t2)">Unread</span><span style="font-weight:600;color:#d97706">4</span></div>
                  <div style="display:flex;justify-content:space-between"><span style="color:var(--t2)">Avg. response
                      time</span><span style="font-weight:600">24 min</span></div>
                </div>
              </div>
            </div>
          </section>

          <!-- ── SECTION: Profile ── -->
          <section class="section" id="sProfile">
            <div class="two-col">
              <div class="card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Profile information</div>
                    <div class="card-sub">Displayed on your seller page</div>
                  </div>
                </div>
                <div class="form-grid">
                  <div class="form-row">
                    <div class="form-group"><label class="form-label">Full name</label><input class="form-input"
                        value="Alex Johnson"></div>
                    <div class="form-group"><label class="form-label">Nickname</label><input class="form-input"
                        value="ngoc.t"></div>
                  </div>
                  <div class="form-row">
                    <div class="form-group"><label class="form-label">Phone number</label><input class="form-input"
                        value="0912 345 678" type="tel"></div>
                    <div class="form-group"><label class="form-label">University</label><input class="form-input"
                        value="HUST"></div>
                  </div>
                  <div class="form-group"><label class="form-label">Student ID</label><input class="form-input"
                      value="20200001"></div>
                  <div class="form-group"><label class="form-label">About you</label><textarea
                      class="form-textarea">Selling electronics and textbooks at HUST. Fast, reliable transactions. Contact me for support.</textarea>
                  </div>
                  <div style="display:flex;gap:10px">
                    <button class="btn btn-primary" data-toast-message="Profile saved" data-toast-type="ok">Save changes</button>
                    <button class="btn btn-outline" data-toast-message="Edit canceled" data-toast-type="info">Cancel</button>
                  </div>
                </div>
              </div>

              <div style="display:flex;flex-direction:column;gap:16px">
                <div class="card">
                  <div class="card-head">
                    <div>
                      <div class="card-title">Seller stats</div>
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:4px">
                    <div class="list-item">
                      <div class="li-info">
                        <div class="li-name">Rating Score</div>
                        <div class="li-sub">Based on <%= user.ratingCount || 0 %> reviews</div>
                      </div>
                      <div style="display:flex;align-items:center;gap:4px">
                        <%- renderStars(user.rating || 5, 14) %>
                          <span style="font-size:18px;font-weight:800;color:#d97706;margin-left:2px">
                            <%= (user.rating || 5).toFixed(1) %>
                          </span>
                      </div>
                    </div>
                    <div class="list-item">
                      <div class="li-info">
                        <div class="li-name">Total sold</div>
                      </div>
                      <div class="li-val">
                        <%= user.totalSales || 0 %> items
                      </div>
                    </div>
                    <div class="list-item">
                      <div class="li-info">
                        <div class="li-name">Total revenue</div>
                      </div>
                      <div class="li-val" style="color:#16a34a">
                        <%= formatVND(stats.totalRevenue) %>
                      </div>
                    </div>
                    <div class="list-item">
                      <div class="li-info">
                        <div class="li-name">Member since</div>
                      </div>
                      <div class="li-val">
                        <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short' , year: 'numeric' })
                          %>
                      </div>
                    </div>
                    <div class="list-item">
                      <div class="li-info">
                        <div class="li-name">Profile status</div>
                      </div><span class="badge badge-active">
                        <%= user.profileComplete ? 'Complete' : 'Pending' %>
                      </span>
                    </div>
                  </div>
                </div>

                <div class="card">
                  <div class="card-head">
                    <div>
                      <div class="card-title">Recent reviews</div>
                    </div><a class="card-action" href="#">View all</a>
                  </div>
                  <div id="recentReviewsList">
                    <% if (recentRatings && recentRatings.length> 0) { %>
                      <% recentRatings.forEach(r=> { %>
                        <div class="review-item">
                          <div class="review-top">
                            <span class="review-author">
                              <%= r.rater?.nickname || r.rater?.name || 'Anonymous' %>
                            </span>
                            <span class="review-stars">
                              <% for(let i=0; i<5; i++) { %>
                                <%= i < r.score ? '★' : '☆' %>
                                  <% } %>
                            </span>
                          </div>
                          <div class="review-text">
                            <%= r.comment || '(No comment)' %>
                          </div>
                          <div class="review-date">
                            <%= new Date(r.createdAt).toLocaleDateString() %>
                          </div>
                        </div>
                        <% }) %>
                          <% } else { %>
                            <div style="padding:20px;text-align:center;color:var(--t2);font-size:14px;">No reviews yet.
                            </div>
                            <% } %>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- ── SECTION: Wallet ── -->
          <section class="section" id="sWallet">
            <div class="wallet-hero glass"
              style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: #fff; padding: 32px; border-radius: 24px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <div style="font-size: 14px; opacity: 0.8; margin-bottom: 4px;">Available Balance</div>
                <div style="font-size: 36px; font-weight: 800; letter-spacing: -0.02em;">
                  <%= formatVND(wallet.availableBalance) %>
                </div>
                <div
                  style="font-size: 14px; opacity: 0.8; margin-top: 12px; display: flex; align-items: center; gap: 6px;">
                  <i data-lucide="clock" style="width: 14px; height: 14px;"></i>
                  Pending: <%= formatVND(wallet.pendingBalance) %>
                </div>
              </div>
              <button class="btn"
                style="background: #fff; color: var(--primary); padding: 12px 24px; border-radius: 12px; font-weight: 700; border: none;"
                data-action="open-withdraw-modal">
                Withdraw Funds
              </button>
            </div>

            <div class="card premium-card">
              <div class="card-head">
                <div class="card-title">Transaction History</div>
              </div>
              <div class="tbl-wrap">
                <table class="tbl">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Type</th>
                      <th>Description</th>
                      <th>Amount</th>
                    </tr>
                  </thead>
                  <tbody id="walletTransactions">
                    <tr>
                      <td colspan="4" style="text-align:center; padding: 40px; color: var(--t2);">
                        <i data-lucide="history"
                          style="width: 32px; height: 32px; margin-bottom: 8px; opacity: 0.5;"></i>
                        <div>No transactions found</div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="card premium-card" style="margin-top: 24px;">
              <div class="card-head">
                <div>
                  <div class="card-title">Payout Requests</div>
                  <div class="card-sub">Track when your QR earnings are transferred to your bank account</div>
                </div>
              </div>
              <div class="tbl-wrap">
                <table class="tbl">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Amount</th>
                      <th>Bank</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody id="payoutRequestsTable">
                    <tr>
                      <td colspan="4" style="text-align:center; padding: 32px; color: var(--t2);">
                        No payout requests yet
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

        </div><!-- /.content -->
      </main>

      <div id="toast-wrap"></div>

      <!-- Seller navigation (used by quick-card shortcuts) -->
      <nav id="sellerNav" style="display:none" aria-hidden="true">
        <div class="nav-item" data-section="sDash"></div>
        <div class="nav-item" data-section="sMessages"></div>
        <div class="nav-item" data-section="sProfile"></div>
        <div class="nav-item" data-section="sWallet"></div>
      </nav>

      <!-- Withdraw Modal -->
      <div class="modal-overlay" id="withdrawModal">
        <div class="modal glass" style="max-width: 400px; margin: 40px auto;">
          <div class="modal-head">
            <div class="modal-title">Withdraw Funds</div>
            <button class="modal-close" data-action="close-withdraw-modal"><i data-lucide="x"></i></button>
          </div>
          <div class="modal-body">
            <div class="form-group" style="margin-bottom: 16px;">
              <label class="form-label">Amount (VND)</label>
              <input type="number" class="form-input" id="withdrawAmount" value="<%= wallet.availableBalance %>">
              <div style="font-size: 12px; color: var(--t3); margin-top: 4px;">Available: <%= formatVND(wallet.availableBalance) %></div>
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
              <label class="form-label">Bank Name</label>
              <input type="text" class="form-input" id="bankName" placeholder="e.g., MB Bank">
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
              <label class="form-label">Account Number</label>
              <input type="text" class="form-input" id="accountNumber">
            </div>
            <div class="form-group">
              <label class="form-label">Account Holder</label>
              <input type="text" class="form-input" id="accountName" style="text-transform: uppercase;">
            </div>
          </div>
          <div class="modal-foot">
            <button class="btn btn-sec" data-action="close-withdraw-modal">Cancel</button>
            <button class="btn btn-pri" data-action="submit-withdraw">Submit Request</button>
          </div>
        </div>
      </div>

            <script defer src="/js/pages/dashboard-seller.js"></script>
      <script>window.INITIAL_SECTION = "<%= (typeof initialSection !== 'undefined' ? initialSection : 'sDash') %>";</script>
      <script defer src="/js/rating.js"></script>
      <%- include('partials/dashboard-scripts') %>
</body>

</html>
