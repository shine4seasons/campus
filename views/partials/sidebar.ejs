<%
  let sbInitials = '';
  if (typeof user !== 'undefined' && user && user.name) {
    sbInitials = user.name.split(' ').map(function(n){ return n[0]; }).slice(0,2).join('').toUpperCase();
  }
%>
<aside class="sidebar glass" id="sb-sidebar">
  


  <%# â”€â”€ Mode toggle (buyer / seller) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
  <%# â”€â”€ Navigation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
  <nav class="sb-nav">

    <%# Admin â”€â”€ %>
    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>

    <div class="sb-section">
      <span class="sb-group-label">Overview</span>
      <div class="nav-item" data-admin-path="/admin" data-admin-section="aDash">
        <svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10z"/><path d="M13 21h8V11h-8v10z"/></svg>
        Dashboard
      </div>
    </div>

    <div class="sb-section">
      <span class="sb-group-label">Management</span>
      <div class="nav-item" data-admin-path="/admin/analytics" data-admin-section="aAnalytics">
        <svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 7v10"/><path d="M13 11v6"/><path d="M8 13v4"/></svg>
        Analytics
      </div>
      <div class="nav-item" data-admin-path="/admin/users" data-admin-section="aUsers">
        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        Users
      </div>
      <div class="nav-item" data-admin-path="/admin/products" data-admin-section="aProducts">
        <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 00-1-1.73L13 3l-7 3.27A2 2 0 005 8v8a2 2 0 001 1.73L11 21l7-3.27A2 2 0 0021 16z"/></svg>
        Products
      </div>
      <div class="nav-item" data-admin-path="/admin/orders" data-admin-section="aOrders">
        <svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
        Orders
      </div>
      <div class="nav-item" data-admin-path="/admin/payouts" data-admin-section="aPayouts">
        <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 110 7H6" /></svg>
        Payouts
      </div>
      <div class="nav-item" data-admin-path="/admin/reports" data-admin-section="aReports">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Reports
      </div>
    </div>

    <div class="sb-section">
      <span class="sb-group-label">System</span>
      <div class="nav-item" data-admin-path="/admin/settings" data-admin-section="aSettings">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Settings
      </div>
    </div>

    <% } else { %>

    <%# â”€â”€ Buyer nav â”€â”€ %>
    <div class="nav-links-buyer">
      <div class="sb-section">
        <span class="sb-group-label">Browse</span>
        <a href="/#categories" class="nav-item nav-link buyer-only">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          Categories
        </a>
        <a href="/#featured" class="nav-item nav-link buyer-only">
          <svg viewBox="0 0 24 24"><path d="M12 2l2.9 5.88L21 9.24l-4.5 4.06L17.8 21 12 17.77 6.2 21l1.3-7.7L3 9.24l6.1-1.36L12 2z"/></svg>
          Featured
        </a>
      </div>

      <div class="sb-section">
        <span class="sb-group-label">My Activities</span>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'orders') ? ' active' : '' %>" href="/orders">
          <svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
          My Orders
        </a>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'favorites') ? ' active' : '' %>" href="/favorites">
          <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Favorites
        </a>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'messages') ? ' active' : '' %>" href="/messages">
          <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          Messages
          <span class="nav-badge" id="nav-chat-badge" style="display:none">0</span>
        </a>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'notifications') ? ' active' : '' %>" href="/notifications">
          <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          Notifications
        </a>
      </div>
    </div>

    <%# â”€â”€ Seller nav â”€â”€ %>
    <div class="nav-links-seller" style="display:none;">
      <div class="sb-section">
        <span class="sb-group-label">Overview</span>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? ' active' : '' %>" href="/dashboard">
          <svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10z"/><path d="M13 21h8V11h-8v10z"/></svg>
          Dashboard
        </a>
      </div>

      <div class="sb-section">
        <span class="sb-group-label">My Store</span>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'products') ? ' active' : '' %>" href="/my-products">
          <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          My Products
        </a>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'seller-orders') ? ' active' : '' %>" href="/orders-seller">
          <svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
          Orders
        </a>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'revenue') ? ' active' : '' %>" href="/revenue">
          <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          Revenue
        </a>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'wallet') ? ' active' : '' %>" href="/wallet-payouts">
          <svg viewBox="0 0 24 24"><path d="M3 7.5A2.5 2.5 0 015.5 5H19a2 2 0 012 2v2H5.5A2.5 2.5 0 003 11.5v5A2.5 2.5 0 005.5 19H20a1 1 0 001-1v-2"/><path d="M3 11.5A2.5 2.5 0 015.5 9H21v8H5.5A2.5 2.5 0 013 14.5v-3z"/><circle cx="16.5" cy="13" r="1"/></svg>
          Wallet & Payouts
        </a>
        <a class="nav-item<%= (typeof activePage !== 'undefined' && activePage === 'messages') ? ' active' : '' %>" href="/messages">
          <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          Messages
          <span class="nav-badge" id="nav-chat-badge-seller" style="display:none">0</span>
        </a>
      </div>
    </div>

    <% } %>
  </nav>

  <%# â”€â”€ Footer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
  <div class="sb-footer">
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="sb-user-menu">
        <button type="button" class="sb-user-card sb-user-trigger premium-card glass<%= (typeof activePage !== 'undefined' && activePage === 'profile') ? ' active' : '' %>" id="sb-user-trigger" aria-haspopup="menu" aria-expanded="false">
          <div class="sb-avatar" id="sbAvatar">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="<%= user.name %>">
            <% } else { %>
              <%= sbInitials %>
            <% } %>
          </div>
          <div class="sb-user-info">
            <div class="sb-uname" id="sbName"><%= user.name %></div>
            <div class="sb-urole" id="sbRole">
              <span class="sb-role-dot"></span>
              <%= user.role === 'admin' ? 'Admin workspace' : 'Open workspace menu' %>
            </div>
          </div>
          <div class="sb-user-caret" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m7 15 5 5 5-5"></path>
              <path d="m7 9 5-5 5 5"></path>
            </svg>
          </div>
        </button>

        <div class="sb-user-dropdown" id="sb-user-dropdown" role="menu" aria-labelledby="sb-user-trigger">
          <a href="/profile" class="sb-dropdown-item" role="menuitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21a8 8 0 0 0-16 0"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Profile</span>
          </a>

          <% if (user.role !== 'admin') { %>
            <div class="sb-dropdown-divider"></div>
            <button type="button" class="sb-dropdown-item workspace-switch-item" id="workspace-browse-btn" data-mode="buyer" role="menuitem">
              <i data-lucide="shopping-bag"></i>
              <span>Browse workspace</span>
              <span class="sb-dropdown-tag">Buyer</span>
            </button>
            <button type="button" class="sb-dropdown-item workspace-switch-item" id="workspace-manage-btn" data-mode="seller" role="menuitem">
              <i data-lucide="store"></i>
              <span>Manage workspace</span>
              <span class="sb-dropdown-tag">Seller</span>
            </button>
          <% } %>

          <div class="sb-dropdown-divider"></div>
          <button type="button" id="logout-btn" class="sb-dropdown-item danger" role="menuitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Sign out</span>
          </button>
        </div>
      </div>
    <% } else { %>
      <a href="/login" class="sb-user-card premium-card glass">
        <div class="sb-avatar" id="sbAvatar"><%= sbInitials %></div>
        <div class="sb-user-info">
          <div class="sb-uname" id="sbName">Sign In</div>
          <div class="sb-urole">to sell items</div>
        </div>
      </a>
    <% } %>
  </div>

</aside>

<div id="switch-modal-backdrop" class="switch-modal-backdrop">
  <div class="switch-modal" role="dialog" aria-modal="true">
    <h3>Buyer-only page</h3>
    <p>This page is available for buyers. Switch to buyer mode to continue.</p>
    <div class="actions">
      <button class="btn ghost" id="switch-cancel">Stay</button>
      <button class="btn primary" id="switch-confirm">Switch to buyer</button>
    </div>
  </div>
</div>

<!-- Mobile toggle & backdrop -->
<button id="sb-mobile-toggle" class="sb-mobile-toggle" aria-label="Toggle sidebar" aria-controls="sb-sidebar" aria-expanded="false" type="button">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
  </svg>
</button>
<div id="sb-backdrop" class="sb-backdrop" aria-hidden="true"></div>

<script id="sidebar-user-config" type="application/json"><%- JSON.stringify({ role: (typeof user !== 'undefined' && user && user.role ? user.role : '') }).replace(/</g, '\\u003c') %></script>
<script defer src="/js/sidebar.js"></script>
